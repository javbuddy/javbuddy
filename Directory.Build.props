<Project>

  <PropertyGroup>
    <Version>0.2.1</Version>
    <!-- .NET 11's Runtime Async (preview): the runtime tracks async suspension/resumption
         natively instead of the compiler emitting state-machine classes, giving cleaner live
         stack traces and lower overhead. See:
         https://learn.microsoft.com/en-us/dotnet/core/whats-new/dotnet-11/runtime#runtime-async -->
    <Features>runtime-async=on</Features>
    <!-- MediaInfo.Core.Native's build target symlinks libmediainfo in both $(OutDir) and $(PublishDir),
         and on a plain build the publish folder doesn't exist yet, so its Exec warns MSB6003 (it has
         ContinueOnError, and the OutDir run still works). The symlinks aren't needed by the Docker
         image, so there is nothing to act on. -->
    <NoWarn>$(NoWarn);MSB6003</NoWarn>
  </PropertyGroup>

</Project>
