<Project>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <!-- .NET 11's Runtime Async (preview): the runtime tracks async suspension/resumption
         natively instead of the compiler emitting state-machine classes, giving cleaner live
         stack traces and lower overhead. See:
         https://learn.microsoft.com/en-us/dotnet/core/whats-new/dotnet-11/runtime#runtime-async -->
    <Features>runtime-async=on</Features>
    <!-- MediaInfo.Wrapper.Core pulls in MediaInfo.Core.Native (see Javbuddy/Services/MediaInfo),
         which ships native assets under version/distro-specific RIDs (debian-x64, ubuntu-x64,
         alpine-x64, ...) that none of the .NET 8+ SDK's own RID graph recognizes — a plain dotnet
         build/test (no -r flag) doesn't need these assets and correctly skips them, and NETSDK1206
         just flags that as informational. The Dockerfile doesn't rely on RID-based publish
         selection for this package at all (it never resolves on any RID, recognized or not — see
         the Dockerfile's own comment); it copies the .so files straight out of the NuGet cache
         instead, so this warning has nothing to catch anywhere in this repo. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

</Project>
