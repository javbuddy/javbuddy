@page "/movies/{RouteCode}"
@using Javbuddy.Models
@using Javbuddy.Services.Jellyfin
@using Javbuddy.Services.R18Dev
@using Javbuddy.Components.Pages.MovieDetailSections
@inject IMovieDetailQueryService MovieDetailQuery
@inject IImageServingService ImageServing
@inject IJellyfinClient JellyfinClient
@inject IR18DevReleaseBrowseService ReleaseBrowseService
@inject IMovieSceneService SceneService
@inject IMovieHighlightService HighlightService
@inject IMovieApexService ApexService
@inject Javbuddy.Services.SceneMedia.IMovieClipMediaQueueService ClipMediaQueue
@rendermode InteractiveServer

<PageTitle>@(movie?.DisplayName ?? preview?.DisplayTitle ?? "Movie") · Javbuddy</PageTitle>

@if (!loaded)
{
    <LoadingIndicator />
}
else if (movie is null && preview is not null)
{
    <MoviePreviewSection Preview="preview"
                         Related="related"
                         BackHref="@BackHref"
                         BackLabel="@BackLabel"
                         OnAdded="ReloadAllAsync"
                         OnSearchRequested="() => OpenDialog(MovieDetailDialog.PreviewSearch)" />
    <ProwlarrSearchModal Code="@preview.DvdId" Show="IsOpen(MovieDetailDialog.PreviewSearch)" OnClose="() => CloseDialog(MovieDetailDialog.PreviewSearch)" OnMovieAdded="OnPreviewMovieAdded" />
}
else if (movie is null)
{
    <p>Movie not found. <a href="/">Back to movies</a></p>
}
else
{
    <MovieDetailToolbar Movie="movie"
                        BackHref="@BackHref"
                        BackLabel="@BackLabel"
                        Interactive="interactive"
                        LoadingRawNfo="loadingRawNfo"
                        OnOpenDialog="OpenDialog"
                        OnReload="LoadAsync"
                        OnNotice="OnNotice" />

    @if (coverSaveNotice is not null)
    {
        <div class="alert @(coverSaveNoticeIsWarning ? "alert-warning" : "alert-success") alert-dismissible py-2 movie-cover-save-notice" role="status">
            @coverSaveNotice
            <button type="button" class="btn-close" @onclick="DismissCoverSaveNotice" aria-label="Dismiss"></button>
        </div>
    }

    <div class="movie-detail-layout">
        @if (HasFetchedMetadata)
        {
            <div class="movie-detail-backdrop" style="background-image: url('@BackdropFullUrl()')"></div>
        }
        <div class="movie-detail-sidebar">
            @if (HasFetchedMetadata)
            {
                <div class="movie-detail-poster movie-detail-poster-clickable" @onclick="() => OpenDialog(MovieDetailDialog.PosterLightbox)" title="Click to view large poster">
                    <img src="@PosterFullUrl()" alt="Cover" />
                </div>
            }
            else
            {
                <div class="movie-detail-poster">
                    <div class="movie-detail-poster-placeholder">@movie.Code</div>
                </div>
            }
        </div>
        <div class="movie-detail-main">
            <h1 class="movie-detail-title" title="@movie.DisplayName">@MovieDetailText.Truncate(movie.DisplayName, 70)</h1>
            <MovieDetailBadges Movie="movie"
                               CastEntries="castEntries"
                               Related="related"
                               Highlights="highlights"
                               Apexes="apexes"
                               CanPlay="CanPlay"
                               JellyfinWebUrl="@jellyfinWebUrl"
                               Interactive="interactive"
                               OnOpenDialog="OpenDialog"
                               OnReload="LoadAsync"
                               OnPlay="OpenVideoPlayerModal"
                               OnPlayClips="PlayClips" />
            @if (!string.IsNullOrWhiteSpace(movie.MetaDescription))
            {
                <p class="movie-detail-overview">@movie.MetaDescription</p>
            }
            @if (!string.IsNullOrWhiteSpace(movie.Notes))
            {
                <p class="movie-detail-notes"><strong>Notes:</strong> @movie.Notes</p>
            }

            <MovieGenresSection Movie="movie" OnChanged="OnTagsChangedAsync" OnClipsChanged="OnClipTagsChangedAsync" />

            <MovieCastSection Movie="movie" Cast="castEntries" OnChanged="OnCastChangedAsync" />
        </div>

        @* Full width below the poster and details, so the scenes timeline and cards have room. *@
        <div class="movie-detail-wide">
            @if (CanPlay || scenes.Count > 0 || highlights.Count > 0 || apexes.Count > 0)
            {
                <MovieScenesSection @ref="scenesSection" Movie="movie"
                                    Scenes="scenes"
                                    Highlights="highlights"
                                    Apexes="apexes"
                                    HighlightCounts="highlightCounts"
                                    ApexCounts="apexCounts"
                                    CanPlay="CanPlay"
                                    Cast="sceneCast"
                                    ActorImageUrl="SceneActorImageUrl"
                                    OnEdit="range => OpenVideoPlayerAt(range.Start, range.End, editor: true)"
                                    OnPlayAt="seconds => OpenVideoPlayerAt(seconds)"
                                    OnScenesChanged="OnScenesChanged"
                                    OnHighlightsChanged="OnHighlightsChanged"
                                    OnApexesChanged="OnApexesChanged" />
            }

            <MovieImagesSection @ref="imagesSection" Movie="movie" RefreshToken="imagesRefresh" OnGenerateStillsRequested="() => OpenDialog(MovieDetailDialog.Stills)" />
        </div>
    </div>
    @if (movie.Status != MovieStatus.Missing)
    {
        <NfoEditor Code="@(movie.Code ?? "")" MovieId="@movie.Id"
                   Show="@(IsOpen(MovieDetailDialog.NfoEditor) || IsOpen(MovieDetailDialog.NfoConflictReview))"
                   ConflictReview="IsOpen(MovieDetailDialog.NfoConflictReview)"
                   LoadingChanged="@(v => loadingRawNfo = v)"
                   OnConflictResolved="ReloadAllAsync"
                   OnClose="CloseNfoEditor" />

        <MediaInfoModal Movie="movie" Show="IsOpen(MovieDetailDialog.MediaInfo)" OnClose="() => CloseDialog(MovieDetailDialog.MediaInfo)" />
        <VideoRepairModal Movie="movie" Show="IsOpen(MovieDetailDialog.VideoRepair)" OnClose="() => CloseDialog(MovieDetailDialog.VideoRepair)" OnRepaired="ReloadAllAsync" />
    }

    <ProwlarrSearchModal Movie="movie" Show="IsOpen(MovieDetailDialog.Search)" OnClose="() => CloseDialog(MovieDetailDialog.Search)" />

    <MetadataEditorModal Movie="movie" Show="IsOpen(MovieDetailDialog.MetadataEditor)" OnClose="() => CloseDialog(MovieDetailDialog.MetadataEditor)" OnSaved="OnMetadataEditedAsync" />

    <ImageLightboxModal Show="@IsOpen(MovieDetailDialog.PosterLightbox)"
                        Title="@movie.DisplayName"
                        ImageUrl="@PosterFullUrl()"
                        AlternateImageUrl="@(HasFetchedMetadata ? BackdropFullUrl() : null)"
                        PrimaryLabel="Poster"
                        AlternateLabel="Full jacket"
                        DefaultToAlternate="true"
                        OnCropRequested="() => OpenDialog(MovieDetailDialog.CoverCrop)"
                        OnClose="() => CloseDialog(MovieDetailDialog.PosterLightbox)" />

    <MovieStillsGenerateModal Show="@IsOpen(MovieDetailDialog.Stills)"
                              MovieId="@movie.Id"
                              Code="@(movie.Code ?? "")"
                              IsVr="@IsSideBySideVr"
                              OnClose="() => CloseDialog(MovieDetailDialog.Stills)"
                              OnSaved="OnStillsSavedAsync" />

    <MovieCoverCropModal Show="@IsOpen(MovieDetailDialog.CoverCrop)"
                         Code="@(movie.Code ?? "")"
                         Title="@movie.DisplayName"
                         OnClose="() => CloseDialog(MovieDetailDialog.CoverCrop)"
                         OnCoverChanged="OnCoverChangedAsync" />

    <MovieMetadataRefreshModal Show="@IsOpen(MovieDetailDialog.MetadataRefresh)"
                               Movie="movie"
                               CurrentPosterUrl="@(HasFetchedMetadata ? PosterFullUrl() : null)"
                               OnClose="() => CloseDialog(MovieDetailDialog.MetadataRefresh)"
                               OnApplied="ReloadAllAsync" />

    <VideoPlayerModal Show="@IsOpen(MovieDetailDialog.VideoPlayer)"
                      Title="@movie.DisplayName"
                      Code="@movie.Code"
                      ExternalWebUrl="@jellyfinWebUrl"
                      MovieId="@movie.Id"
                      ShowEditor="@playerEditor"
                      Scenes="scenes"
                      Highlights="highlights"
                      Apexes="apexes"
                      DurationSeconds="@movie.MediaDurationSeconds"
                      StartAtSeconds="@playerStartAt"
                      EndAtSeconds="@playerEndAt"
                      OnScenesChanged="OnScenesChanged"
                      OnHighlightsChanged="OnHighlightsChanged"
                      OnApexesChanged="OnApexesChanged"
                      OnClose="CloseVideoPlayerModal" />

    <MovieDeleteDialog Movie="movie" Show="IsOpen(MovieDetailDialog.DeleteConfirm)" OnClose="() => CloseDialog(MovieDetailDialog.DeleteConfirm)" />
}

@code {
    [Parameter] public string RouteCode { get; set; } = "";

    private Movie? movie;
    private R18DevMovieDetail? preview;
    private bool loaded;
    private List<MovieCastEntry> castEntries = new();
    // The page's dialogs are mutually exclusive (each sits over the whole page and the lightbox closes
    // itself before it asks for the crop), so one value says which is open. Every dialog component takes
    // its Show from it and asks to close through its OnClose; each also loads what it needs when Show turns true.
    private MovieDetailDialog openDialog;
    private MovieScenesSection? scenesSection;
    private double? playerStartAt;
    private double? playerEndAt;
    private bool playerEditor;
    private IReadOnlyList<SceneItem> scenes = [];
    // What highlights without actors of their own fall back to on their cards.
    private IReadOnlyList<SceneActorItem> sceneCast = [];
    private IReadOnlyList<HighlightItem> highlights = [];
    private IReadOnlyList<ApexItem> apexes = [];
    private IReadOnlyDictionary<int, int> highlightCounts = new Dictionary<int, int>();
    private IReadOnlyDictionary<int, int> apexCounts = new Dictionary<int, int>();

    // The left-eye crop takes the left half of the frame, which is only right for side-by-side layouts.
    private bool IsSideBySideVr => movie?.IsSideBySideVr == true;
    private MovieImagesSection? imagesSection;
    // Bumped by a reload that can have changed the extrafanart folder, which the images section lists again.
    private int imagesRefresh;
    private string? coverSaveNotice;
    private bool coverSaveNoticeIsWarning;
    // Changes only when the poster does, so an unchanged cover is painted straight from the browser's
    // cache while a changed one gets a new URL.
    private string? posterVersion;
    private string? jellyfinWebUrl;
    private bool loadingRawNfo;
    private bool interactive;

    private R18DevRelatedReleases related = R18DevRelatedReleases.None;
    private string? loadedRouteCode;

    // Keyed on the code rather than run once in OnInitializedAsync: the router reuses this page for
    // a link to another movie (the related releases shelf, the header search), so a new code has to
    // start over with that movie.
    protected override async Task OnParametersSetAsync()
    {
        if (RouteCode == loadedRouteCode) return;
        if (loadedRouteCode is not null) ResetForNewMovie();
        loadedRouteCode = RouteCode;
        await LoadAsync(MovieParts.All);
        related = await ReleaseBrowseService.GetRelatedAsync(RouteCode, RelatedReleaseCount);
    }

    private const int RelatedReleaseCount = 12;

    // Puts every per-movie field back to its initial value, so nothing of the previous movie (an open
    // dialog, a notice, a child component reference) is still there for the next. The state the sections and
    // dialogs keep themselves (a busy flag, an open menu) goes with them while the loading indicator replaces them.
    private void ResetForNewMovie()
    {
        loaded = false;
        movie = null;
        preview = null;
        related = R18DevRelatedReleases.None;
        castEntries = new();
        scenes = [];
        sceneCast = [];
        highlights = [];
        apexes = [];
        highlightCounts = new Dictionary<int, int>();
        apexCounts = new Dictionary<int, int>();
        jellyfinWebUrl = null;
        posterVersion = null;
        imagesRefresh = 0;
        coverSaveNotice = null;
        coverSaveNoticeIsWarning = false;
        openDialog = MovieDetailDialog.None;
        playerStartAt = null;
        playerEndAt = null;
        playerEditor = false;
        loadingRawNfo = false;
        scenesSection = null;
        imagesSection = null;
    }

    // Prerendered HTML has no live circuit yet, so a click on the toolbar during that window is
    // silently dropped — OnAfterRender's firstRender only fires once the interactive circuit has
    // attached (it's skipped entirely during prerendering), making it the right signal to stop
    // disabling "Edit .nfo".
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            interactive = true;
            ApplySceneDeepLink();
            StateHasChanged();
        }
    }

    /// <summary>Display name of the actor whose page linked here (Actor Detail's filmography), so the
    /// toolbar's back button returns to that actor instead of "All movies".</summary>
    [SupplyParameterFromQuery(Name = "actor")] public string? ActorQuery { get; set; }

    private string BackHref => string.IsNullOrWhiteSpace(ActorQuery) ? "/" : $"/actors/{Uri.EscapeDataString(ActorQuery.Trim())}";

    private string BackLabel => string.IsNullOrWhiteSpace(ActorQuery) ? "All movies" : ActorQuery.Trim();

    /// <summary>Deep link into playback: <c>?scene={sceneId}</c> opens the player at
    /// that scene's start, <c>?t={seconds}</c> at that time, and <c>?highlight={id}</c> plays just that
    /// highlight's clip. Applied on the first interactive
    /// render, not during prerendering, so the stream isn't opened twice.</summary>
    [SupplyParameterFromQuery(Name = "scene")] public int? SceneQuery { get; set; }

    [SupplyParameterFromQuery(Name = "t")] public double? TimeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "highlight")] public int? HighlightQuery { get; set; }

    private void ApplySceneDeepLink()
    {
        if (!CanPlay) return;
        if (HighlightQuery is { } highlightId && highlights.FirstOrDefault(h => h.Id == highlightId) is { } highlight)
        {
            OpenVideoPlayerAt(highlight.StartSeconds, highlight.EndSeconds, editor: true);
        }
        else if (SceneQuery is { } sceneId && scenes.FirstOrDefault(s => s.Id == sceneId) is { } scene)
        {
            OpenVideoPlayerAt(scene.StartSeconds, editor: true);
        }
        else if (TimeQuery is > 0 and var seconds)
        {
            OpenVideoPlayerAt(seconds, editor: true);
        }
    }

    private bool HasFetchedMetadata => !string.IsNullOrWhiteSpace(movie?.MetaSourceName) && !string.IsNullOrWhiteSpace(movie?.Code);

    private string PosterFullUrl() => $"/image-cache/{Uri.EscapeDataString(movie!.Code!)}/poster/full?v={posterVersion}";

    private string BackdropFullUrl() => $"/image-cache/{Uri.EscapeDataString(movie!.Code!)}/fanart/full";


    private Task ReloadAllAsync() => LoadAsync(MovieParts.All);

    private async Task LoadAsync(MovieParts parts)
    {
        var previous = movie;
        movie = await MovieDetailQuery.GetByCodeAsync(RouteCode);
        loaded = true;

        if (movie is null)
        {
            preview = await ReleaseBrowseService.GetPreviewAsync(RouteCode);
            return;
        }

        if (parts.HasFlag(MovieParts.Poster))
        {
            posterVersion = string.IsNullOrWhiteSpace(movie.Code) ? null : await ImageServing.GetPosterVersionAsync(movie.Code);
        }

        if (parts.HasFlag(MovieParts.Clips))
        {
            scenes = await SceneService.GetScenesAsync(movie.Id);
            highlights = await HighlightService.GetHighlightsAsync(movie.Id);
            apexes = await ApexService.GetApexesAsync(movie.Id);
        }
        if (parts.HasFlag(MovieParts.SceneCast))
        {
            sceneCast = await SceneService.GetCastOptionsAsync(movie.Id);
        }
        if (parts.HasFlag(MovieParts.Clips))
        {
            RecountScenes();
            // Generated in the background; MovieScenesSection reloads the cards as each is written.
            await ClipMediaQueue.EnsureQueuedAsync(movie.Id, scenes, highlights, apexes);
        }

        // The link only changes with the movie's Jellyfin ids, so an edit that leaves them alone keeps it.
        if (parts.HasFlag(MovieParts.Jellyfin)
            || previous?.JellyfinItemId != movie.JellyfinItemId || previous?.JellyfinServerId != movie.JellyfinServerId)
        {
            jellyfinWebUrl = movie is { JellyfinItemId: not null, JellyfinServerId: not null }
                ? await JellyfinClient.GetWebUrlAsync(movie.JellyfinItemId, movie.JellyfinServerId)
                : null;
        }

        if (parts.HasFlag(MovieParts.Cast))
        {
            castEntries = await MovieDetailQuery.GetCastAsync(movie);
        }

        if (parts.HasFlag(MovieParts.Images)) imagesRefresh++;
    }

    // A tag was added or removed: the tag chips, the genre text and the NFO drift badge change, nothing else.
    private Task OnTagsChangedAsync() => LoadAsync(MovieParts.Core);

    // An implied tag was removed from the movie's scenes, highlights and apexes as well.
    private Task OnClipTagsChangedAsync() => LoadAsync(MovieParts.Clips);

    // A cast member or an actor's tag changed: the cast text, the tag chips the clips roll up and the NFO drift
    // badge (Core), the cast chips, and what the clips inherit and can be assigned to.
    private Task OnCastChangedAsync() => LoadAsync(MovieParts.Cast | MovieParts.SceneCast | MovieParts.Clips);

    // The release date changes the cast's ages; creating the .nfo can make the poster appear.
    private Task OnMetadataEditedAsync() => LoadAsync(MovieParts.Cast | MovieParts.Poster);

    private bool IsOpen(MovieDetailDialog dialog) => openDialog == dialog;

    private void OpenDialog(MovieDetailDialog dialog) => openDialog = dialog;

    // Only closes the dialog that is open, so a close callback arriving after another dialog took over
    // (the lightbox closing as it hands over to the crop) leaves that one alone.
    private void CloseDialog(MovieDetailDialog dialog)
    {
        if (openDialog == dialog) openDialog = MovieDetailDialog.None;
    }

    // The .nfo editor is one component for its plain and its conflict review mode.
    private void CloseNfoEditor()
    {
        CloseDialog(MovieDetailDialog.NfoEditor);
        CloseDialog(MovieDetailDialog.NfoConflictReview);
    }

    // The modal's "Add & Download" already created the Movie row (and queued the grab); reload
    // switches this same page from the preview branch to the normal tracked detail view, same as
    // adding the release from the preview's toolbar.
    private async Task OnPreviewMovieAdded(Movie _) => await LoadAsync(MovieParts.All);

    private void OpenVideoPlayerModal() => OpenVideoPlayerAt(null);

    // The movie's highlights or apexes in the player, in order or shuffled.
    private void PlayClips((PlayerClipKind Kind, bool Shuffle) request)
    {
        switch (request.Kind)
        {
            case PlayerClipKind.Highlight: scenesSection?.PlayHighlights(request.Shuffle); break;
            case PlayerClipKind.Apex: scenesSection?.PlayApexes(request.Shuffle); break;
        }
    }

    // Play only plays; Edit scenes, the clip player's Edit and the deep links (PlayerClip.EditUrl)
    // also open the editor.
    private void OpenVideoPlayerAt(double? startAtSeconds, double? endAtSeconds = null, bool editor = false)
    {
        playerStartAt = startAtSeconds;
        playerEndAt = endAtSeconds;
        playerEditor = editor;
        OpenDialog(MovieDetailDialog.VideoPlayer);
    }

    // The player streams the local file, so Jellyfin isn't needed to play.
    private bool CanPlay => movie?.HasLocalVideo == true;

    private void RecountScenes()
    {
        highlightCounts = HighlightRanges.CountStartsByScene(scenes, highlights);
        apexCounts = HighlightRanges.CountStartsByScene(scenes, apexes.Select(a => a.Seconds));
    }

    private void OnHighlightsChanged(IReadOnlyList<HighlightItem> changed)
    {
        highlights = changed;
        RecountScenes();
    }

    private void OnApexesChanged(IReadOnlyList<ApexItem> changed)
    {
        apexes = changed;
        RecountScenes();
    }

    private async Task OnScenesChanged(IReadOnlyList<SceneItem> changed)
    {
        scenes = changed;
        RecountScenes();

        // Scene tags roll up to the movie and drop off it again with the scene, so a
        // scene change can add or remove movie tags; re-read the tag chips.
        if (movie is null) return;
        await ReloadMovieTagsAsync(movie);
    }

    private async Task ReloadMovieTagsAsync(Movie movie)
    {
        var movieTags = await MovieDetailQuery.GetMovieTagsAsync(movie.Id);
        movie.MovieTags.Clear();
        foreach (var movieTag in movieTags) movie.MovieTags.Add(movieTag);
    }

    // A scene actor is one of the movie's tracked cast; their avatar only when they have a photo.
    private string? SceneActorImageUrl(int actorId) =>
        castEntries.FirstOrDefault(c => c.ActorId == actorId) is { HasImage: true } cast
            ? MovieDetailText.ActorThumbUrl(actorId, cast.ImageVersion)
            : null;

    private async Task CloseVideoPlayerModal()
    {
        CloseDialog(MovieDetailDialog.VideoPlayer);

        // The player's Movie tags and Movie actors editors change the
        // movie without telling the page.
        if (movie is null) return;
        await ReloadMovieTagsAsync(movie);
        castEntries = await MovieDetailQuery.GetCastAsync(movie.Id);
    }

    private Task OnStillsSavedAsync() => imagesSection?.ReloadAsync() ?? Task.CompletedTask;

    // The toolbar's and badges' actions report what they did here.
    private void OnNotice(MovieNotice? notice)
    {
        coverSaveNotice = notice?.Message;
        if (notice is not null) coverSaveNoticeIsWarning = notice.IsWarning;
    }

    private void DismissCoverSaveNotice() => coverSaveNotice = null;

    private async Task OnCoverChangedAsync(MovieCoverCropSaveResult result)
    {
        coverSaveNotice = result.Message;
        coverSaveNoticeIsWarning = result.IsWarning;
        await LoadAsync(MovieParts.Poster);
    }
}
