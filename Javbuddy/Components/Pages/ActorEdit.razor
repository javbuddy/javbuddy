@page "/actors/{RouteName}/edit"
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Javbuddy.Models
@using Javbuddy.Services
@using Javbuddy.Services.LocalLibrary
@inject IActorService ActorService
@inject IActorImageCacheService ActorImageCacheService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>@(actor is not null ? $"Edit {actor.DisplayName}" : "Edit Actor") · Javbuddy</PageTitle>

@if (loaded && actor is null)
{
    <p>Actor not found. <a href="/actors">Back to actors</a></p>
}
else if (!loaded)
{
    <LoadingIndicator />
}
else
{
    <div class="actor-toolbar">
        <BackButton Href="@($"/actors/{Uri.EscapeDataString(actor!.DisplayName)}")" CssClass="actor-toolbar-btn">@actor.DisplayName</BackButton>
    </div>

    <div class="actor-edit-header">
        <h1 class="actor-edit-title">Edit Actor</h1>
        <p class="text-muted">Modify metadata, Japanese name representations, external identifiers, and image override for @actor.DisplayName.</p>
    </div>

    @if (errorMessage is not null)
    {
        <div class="alert alert-warning mb-3">@errorMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="edit-actor">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Name & Identity</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="actor-first-name">First Name <span class="text-danger">*</span></label>
                        <InputText id="actor-first-name" class="form-control" @bind-Value="model.FirstName" placeholder="e.g. Yua" disabled="@FormDisabled" />
                        <small class="text-muted">Given name (required).</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="actor-last-name">Last Name</label>
                        <InputText id="actor-last-name" class="form-control" @bind-Value="model.LastName" placeholder="e.g. Mikami (optional)" disabled="@FormDisabled" />
                        <small class="text-muted">Family name (leave blank for single-name actors).</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="actor-japanese-kanji">Japanese Name (Kanji)</label>
                        <InputText id="actor-japanese-kanji" class="form-control" @bind-Value="model.JapaneseNameKanji" placeholder="e.g. 三上悠亜" disabled="@FormDisabled" />
                        <small class="text-muted">Used when matching movies against Japanese cast listings.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="actor-japanese-kana">Japanese Name (Kana / Reading)</label>
                        <InputText id="actor-japanese-kana" class="form-control" @bind-Value="model.JapaneseNameKana" placeholder="e.g. みかみ ゆあ" disabled="@FormDisabled" />
                        <small class="text-muted">Hiragana or Katakana pronunciation reading.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="actor-birthdate">Birthdate</label>
                        <InputDate id="actor-birthdate" class="form-control" @bind-Value="model.BirthDate" max="@ActorPhysicalAttributesHelper.LatestAllowedBirthDate().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" disabled="@FormDisabled" />
                        <small class="text-muted">Actor's birthdate (optional). The actor must be at least @ActorPhysicalAttributesHelper.MinimumActorAge.</small>
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="actor-retired" @bind="model.IsRetired" disabled="@FormDisabled" />
                            <label class="form-check-label" for="actor-retired">Retired</label>
                            <div><small class="text-muted">Indicates if the actor has retired (no longer active in the industry).</small></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Physical Attributes & Measurements</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="actor-height">Height (cm)</label>
                        <InputNumber id="actor-height" class="form-control" @bind-Value="model.HeightCm" placeholder="e.g. 157" disabled="@FormDisabled" />
                        <small class="text-muted">Height in centimeters (e.g. 157).</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="actor-cup-size">Cup Size</label>
                        <InputSelect id="actor-cup-size" class="form-select" @bind-Value="model.CupSize" disabled="@FormDisabled">
                            <option value="">— None —</option>
                            @foreach (var cup in ActorPhysicalAttributesHelper.CupSizeOptions(actor?.CupSize))
                            {
                                <option value="@cup">@cup</option>
                            }
                        </InputSelect>
                        <small class="text-muted">Japanese bra cup size letter.</small>
                    </div>
                    <div class="col-12">
                        <span class="form-label d-block">Cup Size by Date</span>
                        @foreach (var period in model.CupSizePeriods)
                        {
                            <div class="d-flex gap-2 mb-2 actor-cup-period">
                                <span class="align-self-center text-muted small">From</span>
                                <input type="date" class="form-control" aria-label="Effective from" @bind="period.EffectiveFrom" min="@CupSizePeriodMin" max="@CupSizePeriodMax" disabled="@FormDisabled" />
                                <select class="form-select" aria-label="Cup size from this date" @bind="period.CupSize" disabled="@FormDisabled">
                                    <option value="">—</option>
                                    @foreach (var cup in ActorPhysicalAttributesHelper.StandardCupSizes)
                                    {
                                        <option value="@cup">@cup</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-danger btn-sm" title="Remove" aria-label="Remove dated cup size" @onclick="() => model.CupSizePeriods.Remove(period)" disabled="@FormDisabled">×</button>
                            </div>
                        }
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => model.CupSizePeriods.Add(new ActorCupSizePeriodModel())" disabled="@FormDisabled">+ Add dated cup size</button>
                        <div><small class="text-muted">Cup size from a date on, for movie filters. A movie released before the first date, or with no release date, uses the Cup Size above. Dates run from the actor's @(ActorPhysicalAttributesHelper.MinimumActorAge)th birthday (when the birthdate is set) to today.</small></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="actor-bust">Bust (cm)</label>
                        <InputNumber id="actor-bust" class="form-control" @bind-Value="model.Bust" placeholder="e.g. 89" disabled="@FormDisabled" />
                        <small class="text-muted">Bust measurement in cm (e.g. 89).</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="actor-waist">Waist (cm)</label>
                        <InputNumber id="actor-waist" class="form-control" @bind-Value="model.Waist" placeholder="e.g. 65" disabled="@FormDisabled" />
                        <small class="text-muted">Waist measurement in cm (e.g. 65).</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="actor-hips">Hips (cm)</label>
                        <InputNumber id="actor-hips" class="form-control" @bind-Value="model.Hips" placeholder="e.g. 94" disabled="@FormDisabled" />
                        <small class="text-muted">Hip measurement in cm (e.g. 94).</small>
                    </div>
                </div>
                <div class="alert alert-info py-2 px-3 mt-3 mb-0 d-flex align-items-start gap-2 small">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" class="flex-shrink-0 mt-1" aria-hidden="true">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                    </svg>
                    <div>
                        <strong>Japanese Cup Sizes:</strong> @ActorPhysicalAttributesHelper.JapaneseCupSizeExplanation
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">External Identifiers & Overrides</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="actor-r18dev-name">r18.dev Name Override</label>
                        <InputText id="actor-r18dev-name" class="form-control" @bind-Value="model.R18DevName" placeholder="e.g. Yua Mikami" disabled="@FormDisabled" />
                        <small class="text-muted">Overrides name used on r18.dev when filmography matching differs from standard romanization.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="actor-r18dev-id">r18.dev Actress ID</label>
                        <InputNumber id="actor-r18dev-id" class="form-control" @bind-Value="model.R18DevId" placeholder="e.g. 101234" disabled="@FormDisabled" />
                        <small class="text-muted">Numeric actress ID on r18.dev.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="actor-jellyfin-id">Jellyfin Person ID</label>
                        <InputText id="actor-jellyfin-id" class="form-control" @bind-Value="model.JellyfinPersonId" placeholder="e.g. 3a5f... (GUID)" disabled="@FormDisabled" />
                        <small class="text-muted">Person GUID from your Jellyfin server.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Portrait & Image URL</h5>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => showUploadModal = true" disabled="@FormDisabled">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" class="me-1" aria-hidden="true"><path d="M10.5 8.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/><path d="M2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4H2zm.5 2a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1zm9 2.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0z"/></svg>
                    Upload / Change Photo
                </button>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-9">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small">Custom Photo:</span>
                            @if (hasCustomImage)
                            {
                                <span class="badge bg-success">Active Custom Photo</span>
                                <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-2" @onclick="() => showUploadModal = true">Manage / Remove</button>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">None uploaded (using library / movie scans)</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="() => showUploadModal = true">Upload Custom Photo</button>
                            }
                        </div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="actor-preview-avatar">
                            @if (actor is not null && (hasCustomImage || hasImage))
                            {
                                <img src="@($"/actor-image/{actor.Id}/thumb?v={imageVersion}")" alt="Preview" class="actor-preview-img" />
                            }
                            else
                            {
                                <span class="text-muted small">No photo</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Aliases</h5>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => showAliasModal = true" disabled="@FormDisabled">
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" class="me-1" aria-hidden="true"><path d="M2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586V2zm3.5 4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M1.293 7.707A1 1 0 0 1 1 7V2a2 2 0 0 1 2-2h5a1 1 0 0 1 .707.293l.146.147-.707.707L7.439 1H3a1 1 0 0 0-1 1v4.439L.646 7.793l.647-.086z"/></svg>
                    Manage Aliases...
                </button>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">Alternate names associated with this actor from mergers, alternate romanizations, or manual entries.</p>
                @if (actor!.Aliases.Count == 0)
                {
                    <p class="text-muted fst-italic small mb-0">No aliases recorded for this actor.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @foreach (var alias in actor.Aliases)
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle fs-6 py-2 px-3 d-inline-flex align-items-center gap-2">
                                @alias.Name
                                <button type="button"
                                        class="btn-close btn-close-white btn-sm p-0 m-0"
                                        aria-label="@($"Remove alias {alias.Name}")"
                                        title="Remove alias"
                                        style="font-size: 0.65rem;"
                                        @onclick="() => QuickRemoveAliasAsync(alias.Id)"
                                        disabled="@FormDisabled"></button>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="d-flex gap-2 mb-5">
            <button type="submit" class="btn btn-primary" disabled="@FormDisabled">
                @(saving ? "Saving…" : "Save Changes")
            </button>
            <a href="@($"/actors/{Uri.EscapeDataString(actor.DisplayName)}")" class="btn btn-outline-secondary" disabled="@saving">Cancel</a>
        </div>
    </EditForm>

    <ActorImageUploadModal Show="@showUploadModal"
                           ActorId="@(actor?.Id ?? 0)"
                           ActorName="@(actor?.DisplayName ?? "")"
                           OnClose="() => showUploadModal = false"
                           OnPhotoChanged="OnPhotoChanged" />

    <ActorAliasModal Show="@showAliasModal"
                     Actor="@actor"
                     OnClose="() => showAliasModal = false"
                     OnAliasesChanged="OnAliasesChanged" />
}

@code {
    [Parameter]
    public string RouteName { get; set; } = "";

    private Actor? actor;
    private ActorUpdateModel model = new();
    private bool loaded;
    private bool saving;
    private bool interactive;
    private bool FormDisabled => saving || !interactive;
    private string? errorMessage;
    private string? loadedRouteName;
    private bool showUploadModal;
    private bool showAliasModal;
    private bool hasCustomImage;
    private bool hasImage;
    private long imageVersion = DateTime.UtcNow.Ticks;

    // Prerendered HTML has no live circuit yet, so anything typed into the form in that window is
    // wiped when the interactive render replaces it — OnAfterRender's firstRender only fires once
    // the circuit has attached, making it the signal to enable the form.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            interactive = true;
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedRouteName == RouteName) return;
        loadedRouteName = RouteName;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        actor = await ActorService.GetByRouteNameAsync(RouteName);
        loaded = true;
        errorMessage = null;

        if (actor is not null)
        {
            model = new ActorUpdateModel
            {
                Id = actor.Id,
                FirstName = actor.FirstName ?? "",
                LastName = actor.LastName,
                JapaneseNameKanji = actor.JapaneseNameKanji,
                JapaneseNameKana = actor.JapaneseNameKana,
                R18DevName = actor.R18DevName,
                JellyfinPersonId = actor.JellyfinPersonId,
                R18DevId = actor.R18DevId,
                HeightCm = actor.HeightCm,
                CupSize = actor.CupSize,
                Bust = actor.Bust,
                Waist = actor.Waist,
                Hips = actor.Hips,
                BirthDate = actor.BirthDate,
                IsRetired = actor.IsRetired,
                CupSizePeriods = actor.CupSizePeriods
                    .OrderBy(p => p.EffectiveFrom)
                    .Select(p => new ActorCupSizePeriodModel { EffectiveFrom = p.EffectiveFrom, CupSize = p.CupSize })
                    .ToList()
            };

            hasCustomImage = await ActorImageCacheService.HasCustomImageAsync(actor.Id);
            hasImage = await ActorService.HasImageAsync(actor.Id);
        }
    }

    // From the 18th birthday of the birthdate being edited (none without one) to today.
    private string? CupSizePeriodMin => ActorPhysicalAttributesHelper.EarliestCupSizePeriodDate(model.BirthDate)?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private static string CupSizePeriodMax => DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private async Task OnPhotoChanged()
    {
        imageVersion = DateTime.UtcNow.Ticks;
        if (actor is not null)
        {
            hasCustomImage = await ActorImageCacheService.HasCustomImageAsync(actor.Id);
            hasImage = await ActorService.HasImageAsync(actor.Id);
        }
    }

    private async Task OnAliasesChanged()
    {
        if (actor is not null)
        {
            actor = await ActorService.GetByIdAsync(actor.Id);
        }
    }

    private async Task QuickRemoveAliasAsync(int aliasId)
    {
        if (actor is null || saving) return;
        var result = await ActorService.RemoveAliasAsync(actor.Id, aliasId);
        if (result.Success)
        {
            actor = await ActorService.GetByIdAsync(actor.Id);
        }
        else
        {
            errorMessage = result.ErrorMessage ?? "Failed to remove alias.";
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        errorMessage = null;

        var result = await ActorService.UpdateAsync(model);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage;
            saving = false;
            return;
        }

        var targetRoute = result.Actor?.DisplayName ?? actor!.DisplayName;
        Nav.NavigateTo($"/actors/{Uri.EscapeDataString(targetRoute)}");
    }
}
