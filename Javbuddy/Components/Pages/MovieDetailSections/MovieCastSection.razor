@* The Movie Detail page's Cast section: the cast as avatars (tracked actors link to their page),
   plus adding and removing cast. OnChanged asks the page to reload the movie. *@
@using Javbuddy.Models
@inject IMovieService MovieService
@inject IActorService ActorService
@inject IActorTagService ActorTagService
@inject IJSRuntime JS
@implements IAsyncDisposable

<DetailSection Title="Cast" ActionText="@(editingCast ? "Done" : "Edit Cast")" ActionClass="movie-detail-edit-cast-btn" OnAction="ToggleCastEdit">
    @if (castEditError is not null)
    {
        <p class="movie-detail-cast-error">@castEditError</p>
    }
    @if (Cast.Count > 0)
    {
        <div class="movie-detail-cast-grid">
            @foreach (var cast in Cast)
            {
                <div class="movie-detail-cast-item @(cast.ActorId is not null ? "movie-detail-cast-item-tracked" : "")">
                    @if (cast.ActorId is not null)
                    {
                        <div class="movie-detail-cast-avatar-wrap">
                            <a class="movie-detail-cast-avatar @(cast.HasImage ? "movie-detail-cast-avatar-photo" : "")" href="@($"/actors/{Uri.EscapeDataString(cast.Name)}")">
                                @if (cast.HasImage)
                                {
                                    <img src="@MovieDetailText.ActorThumbUrl(cast.ActorId, cast.ImageVersion)" alt="@cast.Name" loading="lazy" />
                                }
                                else
                                {
                                    @ActorMatching.Initials(cast.Name)
                                }
                            </a>
                            @if (editingCast)
                            {
                                <button type="button" class="movie-detail-cast-remove-btn" @onclick="() => RemoveCastActorAsync(cast)" aria-label="Remove @cast.Name">×</button>
                                @if (cast.IsPlaceholder)
                                {
                                    <button type="button" class="movie-detail-cast-photo-btn" @onclick="() => OpenPhotoPicker(cast)" title="Set their photo from one of this movie's images" aria-label="Set photo for @cast.Name from a movie image">
                                        <svg viewBox="0 0 16 16" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M10.5 8.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/><path d="M2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4H2zm9.5 4.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0z"/></svg>
                                    </button>
                                }
                            }
                        </div>
                        <a class="movie-detail-cast-name" href="@($"/actors/{Uri.EscapeDataString(cast.Name)}")">@cast.Name<BirthdayIndicator BirthDate="cast.BirthDate" /></a>
                        @if (cast.IsPlaceholder)
                        {
                            <span class="movie-detail-cast-unidentified" title="Not a known actor: only here to carry tags and a photo">Unidentified</span>
                        }
                        @if (cast.IsUnderage)
                        {
                            <span class="movie-detail-cast-age movie-detail-cast-age-underage" title="@MovieDetailText.UnderageAgeTooltip" aria-label="Age @cast.Age. @MovieDetailText.UnderageAgeTooltip">⚠ Age @cast.Age</span>
                        }
                        else if (cast.Age is not null)
                        {
                            <span class="movie-detail-cast-age">Age @cast.Age</span>
                        }
                        <ActorTagPills MovieId="Movie.Id" ActorId="cast.ActorId!.Value" ActorName="@cast.Name" Library="actorTagLibrary"
                                       Tags="@actorTags.Where(t => t.ActorId == cast.ActorId).ToList()" Editing="editingCast" Adding="addingActorId == cast.ActorId"
                                       OnToggleAdding="() => ToggleAdding(cast.ActorId!.Value)" OnChanged="ActorTagsChangedAsync" />
                    }
                    else
                    {
                        <div class="movie-detail-cast-avatar-wrap">
                            <div class="movie-detail-cast-avatar @(cast.HasImage ? "movie-detail-cast-avatar-photo" : "")">
                                @if (cast.HasImage)
                                {
                                    <img src="@MovieDetailText.ActorThumbUrl(cast.ActorId, cast.ImageVersion)" alt="@cast.Name" loading="lazy" />
                                }
                                else
                                {
                                    @ActorMatching.Initials(cast.Name)
                                }
                            </div>
                            @if (editingCast)
                            {
                                <button type="button" class="movie-detail-cast-remove-btn" @onclick="() => RemoveCastActorByNameAsync(cast.Name)" aria-label="Remove @cast.Name">×</button>
                            }
                            else
                            {
                                <div class="movie-detail-cast-warning-badge" title="Not matched to a tracked actor" aria-label="Not matched to a tracked actor">
                                    <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.964 0L.165 13.233c-.457.778.091 1.767.982 1.767h13.706c.891 0 1.439-.99.982-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" /></svg>
                                </div>
                            }
                        </div>
                        <span class="movie-detail-cast-name">@cast.Name</span>
                    }
                </div>
            }
        </div>
    }
    @if (editingCast)
    {
        <CastSearchAdd ExcludedActorIds="@Cast.Where(c => c.ActorId is not null).Select(c => c.ActorId!.Value).ToHashSet()" OnAdd="AddCastActorAsync" />
        <form class="movie-detail-cast-unidentified-add" @onsubmit="AddPlaceholderAsync">
            <input type="text" class="movie-detail-cast-unidentified-label" placeholder="Label (optional)" maxlength="100" aria-label="Label for an unidentified performer" @bind="placeholderLabel" />
            <button type="submit" class="movie-detail-cast-unidentified-btn" disabled="@addingPlaceholder" title="For someone with no actor in the library: tag and photo them without naming them">+ Unidentified performer</button>
        </form>
    }
</DetailSection>

@if (placeholderPendingDelete is not null)
{
    <DeleteConfirmDialog ItemName="@placeholderPendingDelete.Name"
                         Message="They are deleted from this movie along with their actor tags and photo."
                         Busy="deletingPlaceholder"
                         OnConfirm="ConfirmDeletePlaceholderAsync"
                         OnCancel="() => placeholderPendingDelete = null" />
}

@* Only while a photo is being set: the dialogs aren't rendered, and their services not resolved, the rest of the time. *@
@if (photoActor is not null)
{
    @if (portrait is null)
    {
        <MovieImagePickerModal Code="@(Movie.Code ?? "")"
                               ActorName="@photoActor.Name"
                               OnClose="ClosePhotoDialogs"
                               OnPicked="OnImagePicked" />
    }
    else
    {
        <ActorImageUploadModal Show="true"
                               ActorId="@photoActor.ActorId!.Value"
                               ActorName="@photoActor.Name"
                               InitialImage="@portrait"
                               OnClose="BackToPicker"
                               OnPhotoChanged="OnPhotoChanged" />
    }
}

@code {
    [Parameter, EditorRequired] public Movie Movie { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<MovieCastEntry> Cast { get; set; } = [];
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool editingCast;
    private string? placeholderLabel;
    // The unidentified performer whose photo is being set from a movie image, and the image picked for it.
    private MovieCastEntry? photoActor;
    private ActorImageUploadModal.InitialImageSource? portrait;

    private void OpenPhotoPicker(MovieCastEntry entry)
    {
        photoActor = entry;
        portrait = null;
    }

    private void OnImagePicked(ActorImageUploadModal.InitialImageSource image) => portrait = image;

    // Closing the crop dialog goes back to the images, to pick another one; closing the picker ends it.
    private void BackToPicker() => portrait = null;

    private void ClosePhotoDialogs()
    {
        photoActor = null;
        portrait = null;
    }

    private async Task OnPhotoChanged()
    {
        ClosePhotoDialogs();
        await OnChanged.InvokeAsync();
    }
    // The one cast member whose add-tag search is open, if any.
    private int? addingActorId;
    private IJSObjectReference? module;
    private IJSObjectReference? dismissBinding;
    private DotNetObjectReference<MovieCastSection>? selfRef;
    private bool disposed;
    private string? castEditError;
    private IReadOnlyList<EffectiveActorTag> actorTags = [];
    private IReadOnlyList<ActorTagListItem> actorTagLibrary = [];
    // What the tags were last loaded for: the page passes a new Cast after any reload (a cast change drops tags), and
    // the same one on every other render, which needn't query again.
    private (int MovieId, IReadOnlyList<MovieCastEntry> Cast)? actorTagsLoadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (actorTagsLoadedFor is { } loaded && loaded.MovieId == Movie.Id && ReferenceEquals(loaded.Cast, Cast)) return;
        actorTagsLoadedFor = (Movie.Id, Cast);
        actorTags = await ActorTagService.GetMovieTagsAsync(Movie.Id);
        actorTagLibrary = await ActorTagService.GetActorTagsAsync();
    }

    // The page reloads: the scenes section shows what its clips inherit, and the movie's plain tags may have changed.
    // The reload passes a new Cast, so the tags here are read again too.
    private Task ActorTagsChangedAsync(ActorTagResult result) => OnChanged.InvokeAsync();

    private void ToggleCastEdit()
    {
        editingCast = !editingCast;
        addingActorId = null;
        castEditError = null;
    }

    private void ToggleAdding(int actorId) => addingActorId = addingActorId == actorId ? null : actorId;

    /// <summary>A click outside the open add-tag popover, or Escape.</summary>
    [JSInvokable]
    public void CloseAdding()
    {
        addingActorId = null;
        StateHasChanged();
    }

    // Listens for a click outside the open popover, and Escape, only while one is open.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        try
        {
            if (addingActorId is not null && dismissBinding is null)
            {
                module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/MovieDetailSections/MovieCastSection.razor.js");
                selfRef ??= DotNetObjectReference.Create(this);
                dismissBinding = await module.InvokeAsync<IJSObjectReference>("bindDismiss", selfRef);
            }
            else if (addingActorId is null && dismissBinding is not null)
            {
                var binding = dismissBinding;
                dismissBinding = null;
                await binding.InvokeVoidAsync("unbind");
                await binding.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        selfRef?.Dispose();
        try
        {
            if (dismissBinding is not null)
            {
                await dismissBinding.InvokeVoidAsync("unbind");
                await dismissBinding.DisposeAsync();
            }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task AddCastActorAsync(int actorId) =>
        ApplyAsync(MovieService.AddActorToMovieAsync(Movie.Id, actorId));

    // Removing a real actor only unlinks them, which can be undone. An unidentified performer exists only on this movie,
    // so removing them deletes them with their tags and photo, and that asks first.
    private MovieCastEntry? placeholderPendingDelete;
    private bool deletingPlaceholder;

    private Task RemoveCastActorAsync(MovieCastEntry entry)
    {
        if (!entry.IsPlaceholder) return ApplyAsync(MovieService.RemoveActorFromMovieAsync(Movie.Id, entry.ActorId!.Value));
        placeholderPendingDelete = entry;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeletePlaceholderAsync()
    {
        if (placeholderPendingDelete?.ActorId is not { } actorId) return;
        deletingPlaceholder = true;
        try
        {
            await ActorService.DeleteAsync(actorId);
            placeholderPendingDelete = null;
            await ApplyAsync(OperationResult.Ok());
        }
        finally
        {
            deletingPlaceholder = false;
        }
    }

    private bool addingPlaceholder;

    private async Task AddPlaceholderAsync()
    {
        // A double click or Enter then click would otherwise start two adds that pick the same name.
        if (addingPlaceholder) return;
        addingPlaceholder = true;
        try
        {
            var result = await ActorService.CreatePlaceholderAsync(Movie.Id, placeholderLabel);
            if (result.Success) placeholderLabel = null;
            await ApplyAsync(result.Success ? OperationResult.Ok() : OperationResult.Fail(result.ErrorMessage ?? "Could not add the performer."));
        }
        finally
        {
            addingPlaceholder = false;
        }
    }

    private Task RemoveCastActorByNameAsync(string actorName) =>
        ApplyAsync(MovieService.RemoveActorFromMovieAsync(Movie.Id, actorName));

    private async Task ApplyAsync(Task<OperationResult> change) => await ApplyAsync(await change);

    private async Task ApplyAsync(OperationResult result)
    {
        castEditError = result.Success ? null : result.ErrorMessage;
        await OnChanged.InvokeAsync();
    }
}
