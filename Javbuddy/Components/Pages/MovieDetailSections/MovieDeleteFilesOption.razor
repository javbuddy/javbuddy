@* Movie Detail's Delete dialog "Delete files from disk" toggle. Unchecked by default;
   checking it lists every file under the movie's local folder, with the space it frees, so the user
   sees exactly what goes before confirming. The folder is looked up when the dialog opens, and the
   option stays hidden when the movie has no files on disk (e.g. a wanted movie). *@
@using Javbuddy.Services.Common
@inject IMovieService MovieService

@if (hasFolder)
{
<label class="movie-delete-files-toggle">
    <input type="checkbox" checked="@Checked" disabled="@Disabled" @onchange="OnToggledAsync" />
    <span>Delete files from disk</span>
</label>

@if (Checked)
{
    @if (preview is null)
    {
        <p class="movie-delete-files-note">Listing files…</p>
    }
    else if (preview.ErrorMessage is not null)
    {
        <p class="movie-delete-files-error" role="alert">@preview.ErrorMessage</p>
    }
    else
    {
        <p class="movie-delete-files-warning" role="alert">This permanently deletes the folder below and everything in it from disk. It can't be undone.</p>
        <div class="movie-delete-files-folder">@preview.FolderPath</div>
        @if (preview.Files.Count > 0)
        {
            <ul class="movie-delete-files-list">
                @foreach (var file in preview.Files)
                {
                    <li>
                        <span class="movie-delete-files-name">@file.RelativePath</span>
                        <span class="movie-delete-files-size">@ByteSizeFormatter.Format(file.SizeBytes)</span>
                    </li>
                }
            </ul>
        }
        <div class="movie-delete-files-total">
            @preview.Files.Count @(preview.Files.Count == 1 ? "file" : "files"), @ByteSizeFormatter.Format(preview.TotalBytes) freed
        </div>
    }
}
}

@code {
    [Parameter, EditorRequired] public int MovieId { get; set; }

    [Parameter] public bool Checked { get; set; }

    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private MovieFolderDeletePreview? preview;

    // Hidden until the first lookup finishes (so the toggle doesn't flash for a wanted movie) and when
    // there are no files to delete. A folder that can't be listed, or is refused, still shows the option
    // so the user sees why.
    private bool hasFolder;

    protected override async Task OnInitializedAsync()
    {
        var initial = await MovieService.GetFolderDeletePreviewAsync(MovieId);
        hasFolder = initial.ErrorMessage is not null || initial.Files.Count > 0;
    }

    private async Task OnToggledAsync(ChangeEventArgs e)
    {
        var isChecked = e.Value is true;
        preview = null;
        await CheckedChanged.InvokeAsync(isChecked);
        // Re-listed on every check rather than cached, so the list reflects the folder as it is now.
        if (isChecked) preview = await MovieService.GetFolderDeletePreviewAsync(MovieId);
    }
}
