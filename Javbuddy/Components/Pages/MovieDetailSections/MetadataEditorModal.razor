@using Javbuddy.Models
@inject IMovieService MovieService

@if (show)
{
    <ModalShell Themed="true" Title="Edit Metadata" MaxWidth="700px" Busy="saving" OnClose="Close">
        <ChildContent>
            @* The submit button sits in FooterContent, outside this form, so it points back here with form="@FormId". *@
            <EditForm id="@FormId" Model="model" OnValidSubmit="SaveAsync">
                @if (saveError is not null)
                {
                    <div class="alert alert-danger mb-3">@saveError</div>
                }
                @if (saveWarning is not null)
                {
                    <div class="alert alert-warning mb-3">Your changes were saved, but the .nfo wasn't created: @saveWarning</div>
                }
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="metadata-title">Title</label>
                        <InputText id="metadata-title" class="form-control" @bind-Value="model.Title" maxlength="300" disabled="@saving" />
                        <small class="text-muted">Manual override display name. Rarely needed — Display Title below takes precedence.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="metadata-meta-title">Display Title</label>
                        <InputText id="metadata-meta-title" class="form-control" @bind-Value="model.MetaTitle" disabled="@saving" />
                        <small class="text-muted">The title shown throughout the app and written to the .nfo.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="metadata-original-title">Original Title</label>
                        <InputText id="metadata-original-title" class="form-control" @bind-Value="model.MetaOriginalTitle" disabled="@saving" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="metadata-release-date">Release Date</label>
                        <InputDate id="metadata-release-date" class="form-control" @bind-Value="model.MetaReleaseDate" disabled="@saving" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="metadata-studio">Studio</label>
                        <InputText id="metadata-studio" class="form-control" @bind-Value="model.MetaStudio" disabled="@saving" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="metadata-label">Label</label>
                        <InputText id="metadata-label" class="form-control" @bind-Value="model.MetaLabel" disabled="@saving" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="metadata-series">Series</label>
                        <InputText id="metadata-series" class="form-control" @bind-Value="model.MetaSeries" disabled="@saving" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="metadata-director">Director</label>
                        <InputText id="metadata-director" class="form-control" @bind-Value="model.MetaDirector" disabled="@saving" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="metadata-content-type">Content Type</label>
                        <InputSelect id="metadata-content-type" class="form-select" @bind-Value="model.ContentType" disabled="@saving">
                            @foreach (var type in MovieFilterOptions.ContentTypes)
                            {
                                <option value="@type">@MovieFilterOptions.ContentTypeLabel(type)</option>
                            }
                        </InputSelect>
                        <small class="text-muted">Used by the Content Type filter. Stays in Javbuddy; not written to the .nfo.</small>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="metadata-description">Overview</label>
                        <InputTextArea id="metadata-description" class="form-control" rows="4" @bind-Value="model.MetaDescription" disabled="@saving" />
                    </div>
                    @if (model.VrFormats.Count > 0)
                    {
                        @* Each version's VR / 3D format. Javbuddy's own data only:
                           the file isn't renamed. *@
                        <div class="col-12">
                            <span class="form-label d-block">VR format</span>
                            @foreach (var vr in model.VrFormats)
                            {
                                <div class="metadata-editor-vr-row">
                                    @if (model.VrFormats.Count > 1)
                                    {
                                        <label class="metadata-editor-vr-version" for="metadata-vr-@vr.FileId">@vr.VersionLabel</label>
                                    }
                                    <select id="metadata-vr-@vr.FileId" class="form-select metadata-editor-vr-select" aria-label="VR format of @vr.VersionLabel"
                                            @bind="vr.Choice" disabled="@saving">
                                        <option value="@VrChoice.Auto">@vr.AutoLabel</option>
                                        <option value="@VrChoice.None">None (flat)</option>
                                        @foreach (var format in VrFormat.All)
                                        {
                                            <option value="@format">@(format == VrFormat.Vr180Sbs ? $"{format} (most common)" : format)</option>
                                        }
                                    </select>
                                </div>
                            }
                            <small class="text-muted">Auto detects it from the file name and the picture's shape. Only Javbuddy's own data changes; the video file isn't renamed.</small>
                        </div>
                    }
                </div>
            </EditForm>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Close" disabled="@saving">Cancel</button>
            <button type="submit" form="@FormId" class="btn btn-sm btn-primary" disabled="@saving">@(saving ? "Saving…" : "Save")</button>
        </FooterContent>
    </ModalShell>
}

@code {
    /// <summary>MovieDetail's "Edit Metadata" modal — edits the core Movie fields NfoEditor
    /// and the Genres/Cast section editors don't cover. Opened imperatively via @ref/OpenAsync,
    /// mirroring NfoEditor/MediaInfoModal. Copies Movie's current values into a local edit model on
    /// open so Cancel is a true discard — nothing touches <see cref="Movie"/> until Save succeeds.</summary>
    [Parameter, EditorRequired] public Movie Movie { get; set; } = null!;

    [Parameter] public EventCallback OnSaved { get; set; }

    private sealed class EditModel
    {
        public string? Title { get; set; }
        public string? MetaTitle { get; set; }
        public string? MetaOriginalTitle { get; set; }
        public DateTime? MetaReleaseDate { get; set; }
        public string? MetaStudio { get; set; }
        public string? MetaLabel { get; set; }
        public string? MetaSeries { get; set; }
        public string? MetaDirector { get; set; }
        public string? MetaDescription { get; set; }
        public MovieContentType ContentType { get; set; }
        public List<VrChoice> VrFormats { get; set; } = [];
    }

    /// <summary>One version's VR format choice: Auto (detected), None, or a VrFormat value.</summary>
    private sealed class VrChoice
    {
        public const string Auto = "auto";
        public const string None = "none";

        public int FileId { get; init; }
        public string VersionLabel { get; init; } = "";
        public string AutoLabel { get; init; } = "";
        public string Original { get; init; } = Auto;
        public string Choice { get; set; } = Auto;

        public static VrChoice From(MovieFile file)
        {
            var current = !file.VrTypePinned ? Auto : file.VrType ?? None;
            return new VrChoice
            {
                FileId = file.Id,
                VersionLabel = file.VersionTag,
                AutoLabel = file.VrTypePinned ? "Auto (detect again)" : $"Auto ({file.VrType ?? "none detected"})",
                Original = current,
                Choice = current,
            };
        }
    }

    private const string FormId = "metadata-editor-form";

    private bool show;
    private bool saving;
    private string? saveError;
    private string? saveWarning;
    private EditModel model = new();

    public Task OpenAsync()
    {
        model = new EditModel
        {
            Title = Movie.Title,
            MetaTitle = Movie.MetaTitle,
            MetaOriginalTitle = Movie.MetaOriginalTitle,
            MetaReleaseDate = Movie.MetaReleaseDate,
            MetaStudio = Movie.MetaStudio,
            MetaLabel = Movie.MetaLabel,
            MetaSeries = Movie.MetaSeries,
            MetaDirector = Movie.MetaDirector,
            MetaDescription = Movie.MetaDescription,
            ContentType = Movie.ContentType,
            VrFormats = Movie.MovieFiles
                .OrderByDescending(f => f.IsPrimary)
                .ThenBy(f => f.FileName, StringComparer.OrdinalIgnoreCase)
                .Select(VrChoice.From)
                .ToList(),
        };
        saveError = null;
        saveWarning = null;
        show = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Close()
    {
        if (saving) return;
        show = false;
    }

    private async Task SaveAsync()
    {
        saving = true;
        saveError = null;
        saveWarning = null;

        var update = new MovieMetadataUpdate(
            model.Title,
            model.MetaTitle,
            model.MetaOriginalTitle,
            model.MetaReleaseDate,
            model.MetaStudio,
            model.MetaLabel,
            model.MetaSeries,
            model.MetaDirector,
            model.MetaDescription,
            model.ContentType);

        var result = await MovieService.UpdateMetadataAsync(Movie.Id, update);
        var nfoWarning = result.Success ? result.ErrorMessage : null;
        foreach (var vr in model.VrFormats.Where(v => v.Choice != v.Original))
        {
            if (!result.Success) break;
            result = await MovieService.SetVrTypeAsync(Movie.Id, vr.FileId,
                vr.Choice is VrChoice.Auto or VrChoice.None ? null : vr.Choice, detect: vr.Choice == VrChoice.Auto);
        }
        saving = false;

        if (!result.Success)
        {
            saveError = result.ErrorMessage;
            return;
        }

        if (nfoWarning is not null)
        {
            // Saved, but the .nfo couldn't be created: keep the dialog open so the reason is seen.
            saveWarning = nfoWarning;
            await OnSaved.InvokeAsync();
            return;
        }

        show = false;
        await OnSaved.InvokeAsync();
    }
}
