    private void SelectAllStudios(IReadOnlyList<string> studios) => studioFilter.UnionWith(studios);

    private void SelectNoneStudios() => studioFilter.Clear();

    private void ToggleGenreFilter(string genre)
    {
        genreFilter.Toggle(genre);
    }

    private void SelectAllGenres(IReadOnlyList<string> genres) => genreFilter.UnionWith(genres);

    private void SelectNoneGenres() => genreFilter.Clear();

    private void ToggleFeatureFilter(MovieFeatureFilterOption feature)
    {
        featureFilter.Toggle(feature);
    }

    private void SetSort(MovieSortChange change)
    {
        sortField = change.Field;
        sortDescending = change.Descending;
        if (change.RandomSortSeed.HasValue) randomSortSeed = change.RandomSortSeed.Value;
    }

    private async Task RefreshMetadata()
    {
        if (actor is null) return;
        refreshing = true;

        try
        {
            var result = await ActorService.RefreshMetadataAsync(actor.Id);
            if (result.Success)
            {
                await LoadAsync();
            }
        }
        finally
        {
            refreshing = false;
        }
    }

    private async Task OnPhotoChanged()
    {
        await LoadAsync();
    }

    private void OpenGalleryPortraitEditor(byte[] imageBytes)
    {
        galleryPortrait = new(imageBytes);
        showUploadModal = true;
