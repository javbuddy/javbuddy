    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A live circuit's HttpContext can hold a stale cookie: an order just changed in
        // Settings > UI, or poster options just changed on the Movies page, only reach this page
        // through the browser's own copy.
        if (firstRender)
        {
            try
            {
                var order = ActorDetailSectionOrder.Parse(await JS.InvokeAsync<string?>("lsActorDetailSections.get"));
                var options = MoviePosterOptions.Parse(await JS.InvokeAsync<string?>("lsPosterOptions.get"));
                if (!order.SequenceEqual(sectionOrder) || options != posterOptions)
                {
                    sectionOrder = order;
                    posterOptions = options;
                    StateHasChanged();
                    return;
                }
            }
            catch (JSDisconnectedException)
            {
                return;
            }
            catch (JSException)
            {
            }
        }

        // moviesGridRef is only bound by the renderer when the movies grid <div> actually renders
        // (allMovies.Count > 0 && DisplayedMovies.Any()) — otherwise it's still default(ElementReference).
        // Passing that to JS interop resolves to a bogus, non-element object, so both calls below must
        // stay behind this same condition rather than risk "container.querySelectorAll is not a
        // function" crashing the circuit (only JSDisconnectedException was being caught on the
        // "observe" path, so any other JS-side error there was previously fatal).
        if (allMovies.Count == 0 || !DisplayedMovies.Any())
        {
            return;
        }

        if (jsModule is null)
        {
            try
            {
                jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/ActorDetail.razor.js");
                await jsModule.InvokeVoidAsync("init", moviesGridRef);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (Exception)
            {
                // In test or non-browser environments, JS module import may not resolve
            }
        }
        else
        {
            try
            {
                await jsModule.InvokeVoidAsync("observe", moviesGridRef);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (Exception)
            {
            }
        }

        // Once per loaded actor (this instance is reused across "/actors/{RouteName}" changes), and
        // only once the filmography has rendered, so the restored position has a page to land on.
        if (jsModule is not null && scrollTrackedRouteName != loadedRouteName)
        {
            scrollTrackedRouteName = loadedRouteName;
            try
            {
                await jsModule.InvokeVoidAsync("trackScroll", ScrollStorageKey(loadedRouteName));
            }
            catch (JSDisconnectedException)
            {
            }
            catch (Exception)
            {
            }
        }
    }

    internal static string ScrollStorageKey(string? routeName) => $"javbuddy-actor-detail-scroll-{routeName}";

    public async ValueTask DisposeAsync()
    {
        if (jsModule is not null)
        {
            try
            {
                await jsModule.InvokeVoidAsync("dispose");
                await jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant()
        };
    }
}
