<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* One render-blocking, cached file: the theme/sidebar/backdrop attributes are set before first paint, and the backdrop-click guard is registered before blazor.web.js (end of <body>). *@
    <script src="@Assets["js/app-shell.js"]"></script>
    <script type="module" src="@Assets["Components/Shared/ActorTagHover.razor.js"]"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Javbuddy.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/webp" href="favicon.webp" />
    <link rel="manifest" href="manifest.json" crossorigin="use-credentials" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <meta name="theme-color" content="#1b6ec2" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* Shared icon symbols, referenced by <use href="#…">: a glyph repeated on every card (the favorite heart on
       each poster and clip card) is sent once here instead of its full path data in every card's markup. *@
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <symbol id="jb-icon-heart" viewBox="0 0 16 16"><path d="m8 2.748-.717-.737C5.6.281 2.514.878 1.4 3.053c-.523 1.023-.641 2.5.314 4.385.92 1.815 2.834 3.989 6.286 6.357 3.452-2.368 5.365-4.542 6.286-6.357.955-1.886.838-3.362.314-4.385C13.486.878 10.4.28 8.717 2.01L8 2.748zM8 15C-7.333 4.868 3.279-3.04 7.824 1.143c.06.055.119.112.176.171a3.12 3.12 0 0 1 .176-.17C12.72-3.042 23.333 4.867 8 15z" /></symbol>
        <symbol id="jb-icon-heart-filled" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314z" /></symbol>
    </svg>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
