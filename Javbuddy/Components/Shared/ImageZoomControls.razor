@* Zoom out / zoom in / reset buttons for a lightbox's top bar, plus the wheel, double-click/tap,
   drag-to-pan and pinch zooming they go with. Shared by GalleryLightbox.razor and
   ImageLightboxModal.razor. The host marks its full-screen root with data-zoom-container and the
   <img> with data-zoom-image, and renders this inside that root; all gesture handling lives in
   ImageZoomControls.razor.js. Zoom resets whenever ResetKey changes (e.g. the gallery index), and
   the host stops rendering this when the viewer closes, which resets it too. *@

@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="btn-group btn-group-sm image-zoom-controls" role="group" aria-label="Zoom" @ref="anchorRef">
    <button type="button" class="btn btn-outline-light image-zoom-out" @onclick="() => ZoomByAsync(1 / ZoomStep)" disabled="@(!zoomed)" aria-label="Zoom out" title="Zoom out">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6.5 12a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11M13 6.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0" /><path d="M10.344 11.742q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1 6.5 6.5 0 0 1-1.398 1.4z" /><path fill-rule="evenodd" d="M3 6.5a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5" /></svg>
    </button>
    <button type="button" class="btn btn-outline-light image-zoom-in" @onclick="() => ZoomByAsync(ZoomStep)" aria-label="Zoom in" title="Zoom in">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6.5 12a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11M13 6.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0" /><path d="M10.344 11.742q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1 6.5 6.5 0 0 1-1.398 1.4z" /><path fill-rule="evenodd" d="M6.5 3a.5.5 0 0 1 .5.5V6h2.5a.5.5 0 0 1 0 1H7v2.5a.5.5 0 0 1-1 0V7H3.5a.5.5 0 0 1 0-1H6V3.5a.5.5 0 0 1 .5-.5" /></svg>
    </button>
    <button type="button" class="btn btn-outline-light image-zoom-reset" @onclick="ResetAsync" disabled="@(!zoomed)" aria-label="Reset zoom" title="Reset zoom">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z" /><path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466" /></svg>
    </button>
</div>

@code {
    /// <summary>Zoom resets to fit-to-screen whenever this changes, e.g. the gallery's image index.</summary>
    [Parameter] public object? ResetKey { get; set; }

    /// <summary>Raised when the image goes from fit-to-screen to zoomed in, and back.</summary>
    [Parameter] public EventCallback<bool> ZoomedChanged { get; set; }

    private const double ZoomStep = 1.5;

    private readonly string key = Guid.NewGuid().ToString("N");
    private ElementReference anchorRef;
    private DotNetObjectReference<ImageZoomControls>? selfRef;
    private IJSObjectReference? jsModule;
    private bool zoomed;
    private bool hasResetKey;
    private object? previousResetKey;
    private bool resetPending;
    private bool disposed;

    protected override void OnParametersSet()
    {
        if (hasResetKey && !Equals(previousResetKey, ResetKey))
        {
            resetPending = true;
        }

        hasResetKey = true;
        previousResetKey = ResetKey;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ImageZoomControls.razor.js");
                // The viewer can close (disposing this) while the import is still in flight, e.g. an
                // Esc pressed right as it opens.
                if (disposed)
                {
                    await module.DisposeAsync();
                    return;
                }

                jsModule = module;
                selfRef = DotNetObjectReference.Create(this);
                await jsModule.InvokeVoidAsync("init", key, anchorRef, selfRef);
            }
            else if (resetPending && jsModule is not null)
            {
                resetPending = false;
                await jsModule.InvokeVoidAsync("reset", key);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public async Task SetZoomed(bool value)
    {
        if (zoomed == value) return;
        zoomed = value;
        await ZoomedChanged.InvokeAsync(value);
        StateHasChanged();
    }

    private async Task ZoomByAsync(double factor)
    {
        if (jsModule is null) return;
        try
        {
            await jsModule.InvokeVoidAsync("zoomBy", key, factor);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ResetAsync()
    {
        if (jsModule is null) return;
        try
        {
            await jsModule.InvokeVoidAsync("reset", key);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        selfRef?.Dispose();
        if (jsModule is null) return;

        try
        {
            await jsModule.InvokeVoidAsync("dispose", key);
            await jsModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
