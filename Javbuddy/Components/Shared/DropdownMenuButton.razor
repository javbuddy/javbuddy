@if (ShowClear)
{
    <div class="btn-group btn-group-sm dropdown-menu-group" role="group">
        <button class="btn @(Active ? "btn-secondary" : "btn-outline-secondary") dropdown-main-btn" type="button" @onclick="OnToggle" @onkeydown="OnKeyDownAsync" @ref="toggleButton"
                aria-haspopup="true" aria-expanded="@(ShowMenu ? "true" : "false")">
            @Label
        </button>
        <button class="btn @(Active ? "btn-secondary" : "btn-outline-secondary") dropdown-clear-btn" type="button" @onclick="OnClear" @onkeydown="OnKeyDownAsync" title="@ClearTitle" aria-label="@ClearAriaLabel">
            <span aria-hidden="true">×</span>
        </button>
        <button class="btn @(Active ? "btn-secondary" : "btn-outline-secondary") dropdown-arrow-btn" type="button" @onclick="OnToggle" @onkeydown="OnKeyDownAsync" aria-label="Toggle dropdown"
                aria-haspopup="true" aria-expanded="@(ShowMenu ? "true" : "false")">
            <span class="sort-dropdown-arrow">@Arrow</span>
        </button>
    </div>
}
else
{
    <button class="btn btn-sm @(Active ? "btn-secondary" : "btn-outline-secondary")" type="button" @onclick="OnToggle" @onkeydown="OnKeyDownAsync" @ref="toggleButton"
            aria-haspopup="true" aria-expanded="@(ShowMenu ? "true" : "false")">
        @Label
        <span class="sort-dropdown-arrow">@Arrow</span>
    </button>
}
@if (ShowMenu)
{
    <div class="sort-dropdown-menu" @onkeydown="OnKeyDownAsync" style="@(MenuMinWidth is not null ? $"min-width:{MenuMinWidth}" : null)">
        @ChildContent
    </div>
}

@code {
    /// <summary>Toggle-button + arrow + dropdown-menu-container chrome shared by the sort, filter and
    /// column dropdowns. The caller owns the open state (<see cref="ShowMenu"/>), opens the menu in
    /// <see cref="OnToggle"/> (closing its sibling dropdowns there, so only one is open) and renders ONE
    /// page-level `.dropdown-backdrop` while any of them is open, as a sibling before the
    /// `.sort-dropdown-wrapper`s: a click outside the menus closes them, and a click on another toggle
    /// still reaches it, since the wrappers stack above the backdrop. A backdrop rather than blur-to-close,
    /// because blur fires before a click inside registers, which breaks menus holding sliders and selects.
    /// A backdrop inside this component would sit in its own wrapper's stacking context and cover earlier
    /// siblings' toggles, which is why it isn't rendered here. <see cref="OnClose"/> adds Escape, from the
    /// toggle or anywhere in the menu, which also returns focus to the toggle.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Arrow { get; set; } = "▼";
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool ShowClear { get; set; }
    [Parameter] public string ClearTitle { get; set; } = "Reset all filters";
    [Parameter] public string ClearAriaLabel { get; set; } = "Reset all filters";
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public bool ShowMenu { get; set; }
    [Parameter] public string? MenuMinWidth { get; set; }
    [Parameter, EditorRequired] public EventCallback OnToggle { get; set; }
    /// <summary>Closes the menu on Escape; the caller wires the same handler to its page-level backdrop.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference toggleButton;

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || !ShowMenu || !OnClose.HasDelegate)
            return;
        await OnClose.InvokeAsync();
        await toggleButton.FocusAsync();
    }
}
