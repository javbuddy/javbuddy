
@if (Options.CupSizes.Count > 0)
{
    <ChipMultiSelectGroup GroupLabel="Cup Size" Options="@CupSizeOptions"
                          OnSelectAll="SelectAllCupsAsync" OnSelectNone="SelectNoCupsAsync" />
}
@if (Options.Transgender)
{
    <ChipMultiSelectGroup GroupLabel="Transgender" Options="@TransgenderOptions" ShowSelectAll="false"
                          OnSelectNone="SelectNoTransgenderAsync" />
}
<RangeFilterRows Rows="Rows" Selection="Selection" SelectionChanged="SelectionChanged" />

@code {
    /// <summary>The Actress Attributes filter groups shared by the Movies filter toolbar and the
    /// Scenes &amp; Highlights wall: Cup Size chips and a range slider per offered measurement. Selection is the
    /// applied one; edits are raised as a modified copy through SelectionChanged.</summary>
    [Parameter, EditorRequired] public ActorAttributeOptions Options { get; set; } = ActorAttributeOptions.None;
    [Parameter, EditorRequired] public ActorAttributeSelection Selection { get; set; } = ActorAttributeSelection.Empty;
    [Parameter] public EventCallback<ActorAttributeSelection> SelectionChanged { get; set; }

    private IEnumerable<RangeRow<ActorAttributeSelection>> Rows =>
    [
        new("Height", "cm", Options.Height, Selection.Height, (s, r) => s with { Height = r }),
        new("Bust", "cm", Options.Bust, Selection.Bust, (s, r) => s with { Bust = r }),
        new("Waist", "cm", Options.Waist, Selection.Waist, (s, r) => s with { Waist = r }),
        new("Hips", "cm", Options.Hips, Selection.Hips, (s, r) => s with { Hips = r }),
        new("Age", "yrs", Options.Age, Selection.Age, (s, r) => s with { Age = r }),
    ];

    private IReadOnlyList<MultiSelectOption> CupSizeOptions => Options.CupSizes
        .Select(cup => new MultiSelectOption(
            cup,
            Selection.CupSizes.Contains(cup, StringComparer.OrdinalIgnoreCase),
            EventCallback.Factory.Create(this, () => ToggleCupAsync(cup))))
        .ToList();

    private Task ToggleCupAsync(string cup)
    {
        var cups = Selection.CupSizes.ToList();
        if (cups.RemoveAll(c => string.Equals(c, cup, StringComparison.OrdinalIgnoreCase)) == 0) cups.Add(cup);
        return SelectionChanged.InvokeAsync(Selection with { CupSizes = cups });
    }

    // The two choices exclude each other: clicking the active one clears it.
    private IReadOnlyList<MultiSelectOption> TransgenderOptions =>
    [
        new("Only", Selection.Transgender == TransgenderFilter.Only,
            EventCallback.Factory.Create(this, () => ToggleTransgenderAsync(TransgenderFilter.Only))),
        new("Exclude", Selection.Transgender == TransgenderFilter.Exclude,
            EventCallback.Factory.Create(this, () => ToggleTransgenderAsync(TransgenderFilter.Exclude))),
    ];

    private Task ToggleTransgenderAsync(TransgenderFilter choice) =>
        SelectionChanged.InvokeAsync(Selection with { Transgender = Selection.Transgender == choice ? TransgenderFilter.Any : choice });

    private Task SelectNoTransgenderAsync() => SelectionChanged.InvokeAsync(Selection with { Transgender = TransgenderFilter.Any });

    private Task SelectAllCupsAsync() => SelectionChanged.InvokeAsync(Selection with { CupSizes = Options.CupSizes.ToList() });

    private Task SelectNoCupsAsync() => SelectionChanged.InvokeAsync(Selection with { CupSizes = [] });
}
