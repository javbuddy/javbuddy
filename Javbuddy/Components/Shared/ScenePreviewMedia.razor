<div class="scene-preview-media">
    @if (ThumbUrl is not null)
    {
        <img src="@ThumbUrl" alt="" loading="lazy" />
    }
    @if (HoverPreviewUrl is not null)
    {
        @* Left empty for ClipCard.razor.js's bindHoverPreviews, which puts the video in while the card is hovered;
           Blazor never touches the contents of an element it rendered without children. *@
        <div class="scene-preview-live" data-preview-src="@HoverPreviewUrl"></div>
    }
</div>

@code {
    /// <summary>A scene, highlight or apex card's picture: the screenshot, with the hover preview
    /// video the browser plays over it while the card is hovered (see HoverPreviewUrl). The screenshot
    /// stays underneath as the fallback. Fills the card's positioned 16:9 frame.</summary>
    [Parameter] public string? ThumbUrl { get; set; }

    /// <summary>The preview video of a card the browser plays itself while it's hovered
    /// (ClipCard.razor.js's bindHoverPreviews), so hovering costs no server round trip and a card sliding
    /// under a still pointer during a scroll doesn't start a download. It is only a data attribute here.</summary>
    [Parameter] public string? HoverPreviewUrl { get; set; }
}
