@inject IJSRuntime JS
@implements IAsyncDisposable

@* Best-effort 2D view of a side-by-side VR video. Draws the left eye of the <video>
   selected by VideoSelector onto a WebGL canvas, unwarped through a draggable virtual camera, and
   overlays it on the video (the host hides the video's own picture but keeps its native controls).
   All rendering and pointer handling live in VrViewer.razor.js — a redraw per drag event over a
   SignalR round-trip would lag — so this component only renders the markup. The canvas is hidden
   from assistive tech: the host's toggle button and the video's native controls are the accessible
   surface. *@
<div class="vr-viewer" @ref="root">
    <canvas class="vr-viewer-canvas" aria-hidden="true"></canvas>
    <select class="vr-viewer-projection" aria-label="VR projection" title="How the VR video was encoded (equirectangular is the common one)">
        <option value="equirect" selected="@(Projection != "fisheye")">Equirectangular 180°</option>
        <option value="fisheye" selected="@(Projection == "fisheye")">Fisheye 180°</option>
    </select>
    <div class="vr-viewer-error" role="alert" hidden></div>
</div>

@code {
    /// <summary>CSS selector of the <c>&lt;video&gt;</c> to unwarp. Must already be in the DOM when
    /// this component first renders.</summary>
    [Parameter, EditorRequired] public string VideoSelector { get; set; } = default!;

    /// <summary>The projection selected when the viewer opens, "equirect" (the default) or "fisheye"; the
    /// user can still change it in the dropdown. Read once, so a host that wants another one remounts the
    /// viewer (e.g. with <c>@key</c>).</summary>
    [Parameter] public string? Projection { get; set; }

    private ElementReference root;
    private IJSObjectReference? jsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/VrViewer.razor.js");
            await jsModule.InvokeVoidAsync("init", root, VideoSelector);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule is null) return;

        try
        {
            await jsModule.InvokeVoidAsync("dispose", root);
            await jsModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
