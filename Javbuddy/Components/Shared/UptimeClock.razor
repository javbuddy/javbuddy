@inject IJSRuntime JS
@implements IAsyncDisposable

@* A ticking elapsed-time readout. The server renders the starting value; the once-a-second tick lives in
   UptimeClock.razor.js so it doesn't cost a render or a SignalR message. *@
<span @ref="element" class="uptime-clock" data-testid="uptime-clock">@DurationFormatter.Format(Elapsed)</span>

@code {
    /// <summary>When the clock started counting. A local or UTC time; it's compared in UTC so a DST change doesn't shift it.</summary>
    [Parameter, EditorRequired] public DateTime Since { get; set; }

    private readonly string key = Guid.NewGuid().ToString("N");
    private ElementReference element;
    private IJSObjectReference? jsModule;

    private TimeSpan Elapsed => DateTime.UtcNow - Since.ToUniversalTime();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/UptimeClock.razor.js");
            }
            if (jsModule is null) return;

            // Sent on every render, so a new Since (or a re-render that rewrote the text) re-syncs the clock.
            await jsModule.InvokeVoidAsync("start", key, element, Elapsed.TotalMilliseconds);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule is null) return;

        try
        {
            await jsModule.InvokeVoidAsync("dispose", key);
            await jsModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
