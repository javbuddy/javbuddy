@if (!AlwaysExpanded)
{
    <button type="button" class="sort-dropdown-item @(ActiveCount > 0 ? "active" : "")" @onclick="ToggleExpanded">
        <span>@GroupLabel@(ActiveCount > 0 ? $" ({ActiveCount})" : "")</span>
        <span class="sort-dropdown-arrow">@(expanded ? "▲" : "▼")</span>
    </button>
}
@if (expanded || AlwaysExpanded)
{
    @if (Searchable)
    {
        <div class="multiselect-search-row">
            <input type="text" class="multiselect-search-input" placeholder="@($"Search {GroupLabel.ToLowerInvariant()}…")" value="@searchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="multiselect-actions-row">
            <button type="button" class="multiselect-action-link" @onclick="SelectAllVisible">Select All</button>
            <button type="button" class="multiselect-action-link" @onclick="SelectNone">None</button>
            @if (SelectedCount > 1 && OnMatchAllChanged.HasDelegate)
            {
                <MatchAllCheck Value="MatchAll" ValueChanged="OnMatchAllChanged" />
            }
        </div>
    }
    <div class="@(Searchable ? "multiselect-scroll-area" : null)">
        @foreach (var option in FilteredOptions)
        {
            var nested = option.IsNested && string.IsNullOrWhiteSpace(searchTerm);
            <button type="button" class="sort-dropdown-item sort-dropdown-subitem @(nested ? "sort-dropdown-nested" : null) @(option.IsSelected ? "active" : null) @(option.IsExcluded ? "multiselect-excluded" : null)"
                    title="@(Excludable ? (option.IsSelected ? "Click to exclude" : option.IsExcluded ? "Click to clear" : "Click to include") : null)"
                    @onclick="option.OnClick">
                <span class="multiselect-option-label">@(nested ? option.NestedLabel : option.Label)</span>
                @if (option.IsSelected)
                {
                    <span class="ms-2">✓</span>
                }
                else if (option.IsExcluded)
                {
                    <span class="ms-2" aria-label="excluded">✕</span>
                }
            </button>
        }
        @if (Searchable && !FilteredOptions.Any())
        {
            <div class="multiselect-empty">No matches.</div>
        }
    </div>
}

@code {
    /// <summary>A collapsible, multi-select group inside a filter dropdown — a header row (label +
    /// selected count + expand arrow) that reveals a checkable list of options underneath when
    /// clicked. Used for Movies.razor's Resolution/Codec/Genre filters and ActorMissing.razor's
    /// Studio/Year filters. Owns its own expand/collapse state (and, when Searchable, its own search
    /// text); selection itself stays entirely in the caller (each MultiSelectOption's
    /// IsSelected/OnClick already reflects the caller's own filter set).
    ///
    /// Searchable also turns on the search box, Select All/None links, and a capped-height scroll
    /// area for the option list — bundled together since they're only meaningful for a long list
    /// (Genre), not the short fixed ones (Resolution, Codec, Studio, Year), which leave this false
    /// and render exactly as before.</summary>
    [Parameter, EditorRequired] public string GroupLabel { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<MultiSelectOption> Options { get; set; } = Array.Empty<MultiSelectOption>();
    [Parameter] public bool Searchable { get; set; }

    /// <summary>Passed the labels of whatever's currently visible under the active search (all of
    /// Options if there's no search term) — deliberately not "toggle each visible item's own
    /// OnClick in a loop", which would fire one full reload per item instead of one bulk update.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> OnSelectAll { get; set; }

    /// <summary>Clears the whole selection, not just what's currently visible under the active
    /// search — matches how a "None"/reset action is conventionally scoped.</summary>
    [Parameter] public EventCallback OnSelectNone { get; set; }

    /// <summary>Whether a row needs every selected option rather than any. The "Match all" checkbox shows
    /// beside Select All/None, in a Searchable group with two or more selected, only when
    /// <see cref="OnMatchAllChanged"/> is bound.</summary>
    [Parameter] public bool MatchAll { get; set; }
    [Parameter] public EventCallback<bool> OnMatchAllChanged { get; set; }

    private bool expanded;
    private string searchTerm = "";

    /// <summary>Whether an option's click steps it through include and exclude (see <see cref="MultiSelectOption.IsExcluded"/>),
    /// which only changes the options' hover hint; the stepping itself is the caller's.</summary>
    [Parameter] public bool Excludable { get; set; }

    /// <summary>Shows the options with no header to expand them, for a group that is the main content of the
    /// <see cref="FilterSection"/> it sits in (Features, above its NFO drift group).</summary>
    [Parameter] public bool AlwaysExpanded { get; set; }

    private int SelectedCount => Options.Count(o => o.IsSelected);

    private int ActiveCount => Options.Count(o => o.IsSelected || o.IsExcluded);

    private IEnumerable<MultiSelectOption> FilteredOptions => string.IsNullOrWhiteSpace(searchTerm)
        ? Options
        : Options.Where(o => o.Label.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private void ToggleExpanded() => expanded = !expanded;

    private void OnSearchInput(ChangeEventArgs e) => searchTerm = e.Value?.ToString() ?? "";

    private Task SelectAllVisible() => OnSelectAll.InvokeAsync(FilteredOptions.Select(o => o.Label).ToList());

    private Task SelectNone() => OnSelectNone.InvokeAsync();
}
