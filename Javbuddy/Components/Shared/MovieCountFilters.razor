<RangeFilterRows Rows="Rows" Selection="Selection" SelectionChanged="SelectionChanged" />

@code {
    /// <summary>The Movies filter's Scenes / Highlights / Apexes range sliders: how many of each a movie has, from 0 to the
    /// most any movie has. Selection is the applied one; edits are raised as a modified copy through SelectionChanged.</summary>
    [Parameter, EditorRequired] public MovieCountOptions Options { get; set; } = MovieCountOptions.None;
    [Parameter, EditorRequired] public MovieCountSelection Selection { get; set; } = MovieCountSelection.Empty;
    [Parameter] public EventCallback<MovieCountSelection> SelectionChanged { get; set; }

    private IEnumerable<RangeRow<MovieCountSelection>> Rows =>
    [
        new("Scenes", "", Options.Scenes, Selection.Scenes, (s, r) => s with { Scenes = r }),
        new("Highlights", "", Options.Highlights, Selection.Highlights, (s, r) => s with { Highlights = r }),
        new("Apexes", "", Options.Apexes, Selection.Apexes, (s, r) => s with { Apexes = r }),
    ];
}
