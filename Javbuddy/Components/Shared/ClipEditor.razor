@using Javbuddy.Services
@using Javbuddy.Services.SceneMedia
@using Javbuddy.Services.Trickplay
@inject IMovieSceneService SceneService
@inject IMovieHighlightService HighlightService
@inject IMovieApexService ApexService
@inject IActorTagService ActorTagService
@inject ISceneChapterImportService ChapterImportService
@inject ISceneMediaService SceneMedia
@inject IHighlightMediaService HighlightMedia
@inject IApexMediaService ApexMedia
@inject SceneMediaQueue SceneMediaQueue
@inject IJSRuntime JS
@implements IAsyncDisposable

@* One movie's scenes, highlights and apexes as a tree: each scene expands to the highlights
   starting in it and the apexes in it, each highlight to its apexes, and what no scene holds goes under
   "Outside scenes" (ClipTree). Tags roll up and show grayed on the scenes and highlights above them; actors
   flow down and show grayed on the highlights and apexes inheriting them. Replaces the stacked SceneEditor,
   HighlightEditor and ApexEditor, whose rows and forms live on in ClipHighlightRow,
   ClipHighlightForm, ClipApexRow and ClipApexForm. Shared by Review mode's card and the player modal's side
   panel; talks to the host's <video> through ClipEditor.razor.js (current time, seek, play-clip, and — when
   EnableShortcuts — the m / Shift+M, h / Shift+H and a keys) and reports every (re)load through the three
   On…Changed callbacks so the host can draw its timeline. *@
<div class="scene-editor clip-editor">
    @* Header, add buttons and the open add forms; the player's side panel pins this while the clip list
       scrolls, as long as it fits. *@
    <div class="clip-editor-top" @ref="topBlock">
        <div class="scene-editor-header">
            <div class="scene-editor-title">
                <h3 class="scene-editor-heading">Scenes@(scenes.Count > 0 ? $" ({scenes.Count})" : null)</h3>
                <SectionInfo Label="What are scenes, highlights and apexes?">Scenes split the movie up (acts, encounters) and can be written into the file as chapters. Highlights are favorite clips with their own start and end, free to overlap scenes. Apexes are single climax moments. Each sits under what contains it: tags roll up from apexes and highlights to the scenes around them (shown grayed), and actors flow down from scenes to the highlights and apexes in them unless you pick their own.</SectionInfo>
            </div>
            @if (highlights.Count > 0 || apexes.Count > 0)
            {
                @* Symbols as on the timeline (teal highlight bar, orange apex diamond) to keep the header short. *@
                var countsLabel = $"{Count(highlights.Count, "highlight")} · {Count(apexes.Count, "apex", "apexes")}";
                <span class="clip-editor-counts" role="img" aria-label="@countsLabel" title="@countsLabel">
                    @if (highlights.Count > 0)
                    {
                        <span class="clip-editor-count"><span class="clip-editor-highlight-glyph" aria-hidden="true"></span>@highlights.Count</span>
                    }
                    @if (apexes.Count > 0)
                    {
                        <span class="clip-editor-count"><span class="clip-editor-apex-glyph" aria-hidden="true"></span>@apexes.Count</span>
                    }
                </span>
            }
        </div>
        <div class="clip-editor-add-row">
            @if (sceneForm is null)
            {
                <button type="button" class="scene-editor-btn scene-editor-add-btn" @onclick="StartAddSceneAsync" disabled="@busy" title="Add a scene starting at the player's current time">+ Scene</button>
            }
            @if (highlightForm is null)
            {
                <button type="button" class="scene-editor-btn highlight-editor-add-btn" @onclick="StartAddHighlightAsync" disabled="@busy" title="Add a highlight starting at the player's current time">+ Highlight</button>
            }
            @if (apexForm is null)
            {
                <button type="button" class="scene-editor-btn apex-editor-add-btn" @onclick="StartAddApexAsync" disabled="@busy" title="Mark an apex at the player's current time">+ Apex</button>
            }
            @if (tree.Scenes.Any(HasChildren))
            {
                @* An icon, not "Collapse all" text, so it fits beside the add buttons in the player's 300px panel. *@
                var allCollapsed = tree.Scenes.Where(HasChildren).All(n => collapsedSceneIds.Contains(n.Scene.Id));
                var collapseAllLabel = allCollapsed ? "Expand all" : "Collapse all";
                <button type="button" class="scene-editor-btn clip-editor-collapse-all-btn" @onclick="() => SetAllCollapsed(!allCollapsed)"
                        aria-label="@collapseAllLabel" title="@(allCollapsed ? "Expand all scenes" : "Collapse all scenes")">
                    @if (allCollapsed)
                    {
                        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13A.5.5 0 0 1 1 8M7.646.146a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 1.707V5.5a.5.5 0 0 1-1 0V1.707L6.354 2.854a.5.5 0 1 1-.708-.708zM8 10a.5.5 0 0 1 .5.5v3.793l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 0 1 .708-.708L7.5 14.293V10.5A.5.5 0 0 1 8 10" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13A.5.5 0 0 1 1 8m7-8a.5.5 0 0 1 .5.5v3.793l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 1 1 .708-.708L7.5 4.293V.5A.5.5 0 0 1 8 0m-.5 11.707-1.146 1.147a.5.5 0 0 1-.708-.708l2-2a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 11.707V15.5a.5.5 0 0 1-1 0z" /></svg>
                    }
                </button>
            }
        </div>

        @if (error is not null)
        {
            <p class="scene-editor-error" role="alert">@error</p>
        }

        @if (sceneForm is { SceneId: null })
        {
            @SceneFormFragment()
        }
        @if (highlightForm is { HighlightId: null } addingHighlight)
        {
            <div class="clip-editor-add-form">@HighlightFormFragment(addingHighlight)</div>
        }
        @if (apexForm is { ApexId: null } addingApex)
        {
            <div class="clip-editor-add-form">@ApexFormFragment(addingApex)</div>
        }
    </div>

    @if (scenes.Count == 0 && loaded && sceneForm is null)
    {
        <p class="scene-editor-empty">No scenes yet.</p>
        @if (fileChapters is { Chapters.Count: > 0 } found)
        {
            <button type="button" class="scene-editor-btn scene-editor-import-btn" @onclick="ImportChaptersAsync" disabled="@busy" title="@ImportTooltip(found)">
                Import @found.Chapters.Count @(found.Chapters.Count == 1 ? "chapter" : "chapters") from file
            </button>
        }
    }

    @if (tree.Scenes.Count > 0)
    {
        <ol class="scene-editor-list">
            @foreach (var node in tree.Scenes)
            {
                var scene = node.Scene;
                <li class="scene-editor-item @(scene.IsHiddenFromOverview ? "scene-editor-item-hidden" : null)" @key="scene.Id" @onmouseenter="() => hoveredSceneId = scene.Id" @onmouseleave="() => hoveredSceneId = null">
                    @if (sceneForm?.SceneId == scene.Id)
                    {
                        @SceneFormFragment()
                    }
                    else
                    {
                        <div class="clip-editor-line">@CollapseToggle(node)@SceneRow(node)</div>
                    }
                    @if (!collapsedSceneIds.Contains(scene.Id))
                    {
                        @Children(node.Highlights, node.Apexes)
                    }
                </li>
            }
        </ol>
    }

    @if (tree.OutsideHighlights.Count > 0 || tree.OutsideApexes.Count > 0)
    {
        <div class="clip-editor-outside">
            <h4 class="clip-editor-outside-heading">Outside scenes</h4>
            @Children(tree.OutsideHighlights, tree.OutsideApexes)
        </div>
    }

    @BeforeTools

    @* Last row of the panel: the two actions side by side; what they expand into
       (progress, suggestions, confirmation, message) wraps onto full-width lines below. *@
    <div class="scene-editor-tools">
        <SceneDetector MovieId="MovieId" FirstSceneStart="@(scenes.Count > 0 ? scenes.Min(s => s.StartSeconds) : null)"
                       OnScenesAdded="ReloadAsync" OnSuggestionsChanged="OnSuggestionsChanged" OnSeek="SeekToAsync" />

        @if (scenes.Count > 0)
        {
            <SceneChapterWriter MovieId="MovieId" SceneCount="scenes.Count" />
        }
    </div>

    @switch (pendingDelete)
    {
        case SceneItem toDelete:
            <DeleteConfirmDialog @key="toDelete" ItemName="@toDelete.DisplayTitle" Message="Its screenshot and preview are deleted too. Highlights and apexes inside it stay."
                                 Busy="busy" OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete" />
            break;
        case HighlightItem toDelete:
            <DeleteConfirmDialog @key="toDelete" ItemName="@toDelete.DisplayTitle" Busy="busy" OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete" />
            break;
        case ApexItem toDelete:
            <DeleteConfirmDialog @key="toDelete" ItemName="@($"Apex at {SceneTimeFormat.Format(toDelete.Seconds)}")" Busy="busy" OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete" />
            break;
    }
</div>

@code {
    [Parameter, EditorRequired] public int MovieId { get; set; }

    /// <summary>CSS selector of the host's <c>&lt;video&gt;</c>, resolved lazily in JS.</summary>
    [Parameter, EditorRequired] public string VideoSelector { get; set; } = default!;

    /// <summary>The movie's duration; times taken from the player are clamped to it, since the
    /// browser's duration can run a fraction of a second past MediaInfo's.</summary>
    [Parameter] public double? DurationSeconds { get; set; }

    /// <summary>Enables the m / Shift+M, h / Shift+H and a keyboard shortcuts.</summary>
    [Parameter] public bool EnableShortcuts { get; set; }

    [Parameter] public EventCallback<IReadOnlyList<SceneItem>> OnScenesChanged { get; set; }

    [Parameter] public EventCallback<IReadOnlyList<HighlightItem>> OnHighlightsChanged { get; set; }

    [Parameter] public EventCallback<IReadOnlyList<ApexItem>> OnApexesChanged { get; set; }

    /// <summary>Pending detected boundaries, for the host's timeline ghost markers.</summary>
    [Parameter] public EventCallback<IReadOnlyList<SceneSuggestionItem>> OnSuggestionsChanged { get; set; }

    /// <summary>Raised after a change that can alter the movie's tags through its clips, so a
    /// host showing them can re-read them.</summary>
    [Parameter] public EventCallback OnMovieTagsMayHaveChanged { get; set; }

    /// <summary>The playing movie's trickplay, when known: its tile for a scene's start
    /// stands in for a screenshot that hasn't been generated.</summary>
    [Parameter] public TrickplayLayout? Trickplay { get; set; }

    /// <summary>Whether the movie has a local video to take scene screenshots from; without one a
    /// missing screenshot isn't being generated, so its thumbnail doesn't shimmer.</summary>
    [Parameter] public bool HasLocalVideo { get; set; } = true;

    /// <summary>Rendered between the tree and the Detect scenes / Write chapters row, so that row stays at
    /// the bottom of the panel — the hosts put the movie's tag and cast editors here.</summary>
    [Parameter] public RenderFragment? BeforeTools { get; set; }

    private const int ThumbWidth = 64;

    private sealed class SceneForm
    {
        public int? SceneId { get; init; }
        public string Title { get; set; } = string.Empty;
        public string Start { get; set; } = string.Empty;
        public string End { get; set; } = string.Empty;
    }

    private IReadOnlyList<SceneItem> scenes = [];
    private IReadOnlyList<HighlightItem> highlights = [];
    private IReadOnlyList<ApexItem> apexes = [];
    private IReadOnlyList<SceneActorItem> cast = [];
    private IReadOnlyList<ActorTagListItem> actorTagLibrary = [];
    private ClipActorTagsResult actorTags = new(new Dictionary<int, IReadOnlyList<EffectiveActorTag>>(), new Dictionary<int, IReadOnlyList<EffectiveActorTag>>(), new Dictionary<int, IReadOnlyList<EffectiveActorTag>>());
    private ClipTreeModel tree = new([], [], []);
    private FileChapters? fileChapters;
    private bool chaptersProbed;
    private bool loaded;
    private int? loadedMovieId;
    private int? hoveredSceneId;
    private readonly HashSet<int> collapsedSceneIds = [];
    private bool subscribed;
    private SceneForm? sceneForm;
    private HighlightFormModel? highlightForm;
    private ApexFormModel? apexForm;
    private ApexWindow defaultApexWindow = ApexWindow.Default;
    private string? error;
    private bool busy;
    private object? pendingDelete;
    private IJSObjectReference? jsModule;
    private ElementReference topBlock;
    private PlayheadShortcuts<ClipEditor>? shortcuts;
    private static readonly Dictionary<string, string> ShortcutBindings = new()
    {
        ["m"] = nameof(AddSceneAtAsync),
        ["shift+m"] = nameof(EndSceneAtAsync),
        ["h"] = nameof(StartHighlightAtAsync),
        ["shift+h"] = nameof(EndHighlightAtAsync),
        ["a"] = nameof(StartApexAtAsync)
    };
    private bool disposed;

    protected override async Task OnParametersSetAsync()
    {
        if (!subscribed)
        {
            SceneMediaQueue.Generated += OnMediaGenerated;
            subscribed = true;
        }
        if (loadedMovieId == MovieId) return;

        loadedMovieId = MovieId;
        sceneForm = null;
        highlightForm = null;
        apexForm = null;
        pendingDelete = null;
        error = null;
        fileChapters = null;
        chaptersProbed = false;
        collapsedSceneIds.Clear();
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        shortcuts ??= new(this, ShortcutBindings);
        await shortcuts.SyncAsync(GetModuleAsync, EnableShortcuts, VideoSelector);
        if (firstRender && await GetModuleAsync() is { } module)
        {
            try
            {
                await module.InvokeVoidAsync("watchTopFit", topBlock);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    /// <summary>Re-reads everything after the host changed it elsewhere (e.g. the cast).</summary>
    public async Task RefreshAsync()
    {
        await ReloadAsync();
        StateHasChanged();
    }

    // All three lists every time: a change to one alters what the others roll up or inherit.
    private async Task ReloadAsync()
    {
        scenes = await SceneService.GetScenesAsync(MovieId);
        highlights = await HighlightService.GetHighlightsAsync(MovieId);
        apexes = await ApexService.GetApexesAsync(MovieId);
        defaultApexWindow = await ApexService.GetDefaultWindowAsync();
        cast = await SceneService.GetCastOptionsAsync(MovieId);
        actorTags = await ActorTagService.GetEffectiveAsync(MovieId);
        actorTagLibrary = await ActorTagService.GetActorTagsAsync();
        tree = ClipTree.Build(cast, scenes, highlights, apexes);
        loaded = true;
        await OnScenesChanged.InvokeAsync(scenes);
        await OnHighlightsChanged.InvokeAsync(highlights);
        await OnApexesChanged.InvokeAsync(apexes);

        if (scenes.Count == 0 && !chaptersProbed)
        {
            chaptersProbed = true;
            _ = ProbeChaptersAsync(MovieId);
        }

        // Queued here too, not only on the host's page load, so a clip added or moved in the editor gets
        // its screenshot/preview while the host stays open.
        try
        {
            if (scenes.Any(s => s.ThumbVersion is null || s.PreviewVersion is null))
            {
                await SceneMedia.EnsureQueuedAsync(MovieId);
            }
            if (highlights.Any(h => h.ThumbVersion is null || h.PreviewVersion is null))
            {
                await HighlightMedia.EnsureQueuedAsync(MovieId);
            }
            if (apexes.Any(a => a.PreviewVersion is null))
            {
                await ApexMedia.EnsureQueuedAsync(MovieId);
            }
        }
        catch (Exception)
        {
            // Screenshots are a convenience; the list works without them.
        }
    }

    // Raised on the queue's worker thread when a scene's screenshot/preview was written.
    private void OnMediaGenerated(int movieId)
    {
        if (disposed || movieId != MovieId) return;
        _ = InvokeAsync(async () =>
        {
            if (disposed || movieId != MovieId) return;
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private static string Count(int count, string singular, string? plural = null) =>
        $"{count} {(count == 1 ? singular : plural ?? singular + "s")}";

    // --- Tree fragments ---

    private static bool HasChildren(SceneNode node) => node.Highlights.Count > 0 || node.Apexes.Count > 0;

    private void ToggleCollapsed(int sceneId)
    {
        if (!collapsedSceneIds.Remove(sceneId)) collapsedSceneIds.Add(sceneId);
    }

    private void SetAllCollapsed(bool collapsed)
    {
        collapsedSceneIds.Clear();
        if (collapsed) collapsedSceneIds.UnionWith(tree.Scenes.Where(HasChildren).Select(n => n.Scene.Id));
    }

    // Collapsing a scene hides the highlights and apexes under it; a scene holding none gets a
    // spacer instead, so the rows stay aligned.
    private RenderFragment CollapseToggle(SceneNode node) => __builder =>
    {
        var scene = node.Scene;
        if (!HasChildren(node))
        {
            <span class="clip-editor-collapse-spacer" aria-hidden="true"></span>
            return;
        }
        var collapsed = collapsedSceneIds.Contains(scene.Id);
        <button type="button" class="scene-editor-icon-btn clip-editor-collapse-btn @(collapsed ? "clip-editor-collapsed" : null)" @onclick="() => ToggleCollapsed(scene.Id)"
                aria-expanded="@(collapsed ? "false" : "true")" aria-label="@(collapsed ? "Expand" : "Collapse") @scene.DisplayTitle" title="@(collapsed ? "Show its highlights and apexes" : "Hide its highlights and apexes")">
            <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/></svg>
        </button>
    };

    // What a collapsed scene hides, e.g. "2 highlights · 1 apex" — apexes inside its highlights included.
    private static string CollapsedSummary(SceneNode node)
    {
        var apexCount = node.Apexes.Count + node.Highlights.Sum(h => h.Apexes.Count);
        return string.Join(" · ", new[]
        {
            node.Highlights.Count > 0 ? Count(node.Highlights.Count, "highlight") : null,
            apexCount > 0 ? Count(apexCount, "apex", "apexes") : null
        }.OfType<string>());
    }

    private RenderFragment SceneRow(SceneNode node) => __builder =>
    {
        var scene = node.Scene;
        <button type="button" class="scene-editor-row" @onclick="() => SeekToAsync(scene.StartSeconds)" title="Jump to this scene">
            @Thumb(scene)
            <span class="scene-editor-pos">@scene.Position</span>
            <span class="scene-editor-name @(scene.Title is null ? "scene-editor-name-default" : null)" title="@scene.DisplayTitle">@scene.DisplayTitle</span>
            <span class="scene-editor-meta">
                @if (scene.IsHiddenFromOverview)
                {
                    <span class="scene-editor-hidden-badge" role="img" aria-label="Hidden from the Scenes overview" title="Hidden from the Scenes overview">
                        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/><path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/><path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z"/></svg>
                    </span>
                }
                @if (collapsedSceneIds.Contains(scene.Id) && HasChildren(node))
                {
                    <span class="clip-editor-collapsed-badge">@CollapsedSummary(node)</span>
                }
                <span class="scene-editor-range">@SceneTimeFormat.Format(scene.StartSeconds)–@(scene.EffectiveEndSeconds is { } end ? SceneTimeFormat.Format(end) : "end")</span>
                @if (scene.Actors.Count > 0)
                {
                    var sceneActorTags = actorTags.Scenes.GetValueOrDefault(scene.Id) ?? [];
                    <span class="scene-editor-meta-actors">
                        @for (var i = 0; i < scene.Actors.Count; i++)
                        {
                            var actor = scene.Actors[i];
                            <ActorTagHover Tags="@sceneActorTags.Where(t => t.ActorId == actor.ActorId).ToList()" Library="actorTagLibrary">@actor.Name</ActorTagHover>@(i < scene.Actors.Count - 1 ? ", " : null)
                        }
                    </span>
                }
                <ImplicitChips Items="@ImplicitChip.ForActors(node.Actors)" ActorTags="@(actorTags.Scenes.GetValueOrDefault(scene.Id) ?? [])" Library="actorTagLibrary" />
                @foreach (var tag in scene.Tags)
                {
                    <span class="scene-editor-meta-tag">@ImplicitChip.TagLabel(tag)</span>
                }
                <ImplicitChips Items="@ImplicitChip.ForTags(node.ImplicitTags)" />
            </span>
        </button>
        <button type="button" class="scene-editor-icon-btn scene-editor-fav-btn @(scene.IsFavorite ? "scene-editor-fav-on" : null)" @onclick="() => ToggleSceneFavoriteAsync(scene)" disabled="@busy"
                aria-pressed="@(scene.IsFavorite ? "true" : "false")" aria-label="@(scene.IsFavorite ? "Unfavorite" : "Favorite") @scene.DisplayTitle" title="@(scene.IsFavorite ? "Remove from favorite scenes" : "Add to favorite scenes")">
            <FavoriteHeartIcon Filled="scene.IsFavorite" Size="12" />
        </button>
        <button type="button" class="scene-editor-icon-btn scene-editor-edit-btn" @onclick="() => StartEditSceneAsync(scene)" disabled="@busy" aria-label="Edit @scene.DisplayTitle" title="Edit">
            <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5z" /></svg>
        </button>
        <button type="button" class="scene-editor-icon-btn scene-editor-delete-btn" @onclick="() => pendingDelete = scene" disabled="@busy" aria-label="Delete @scene.DisplayTitle" title="Delete">×</button>
    };

    private RenderFragment Children(IReadOnlyList<HighlightNode> highlightNodes, IReadOnlyList<ApexNode> apexNodes) => __builder =>
    {
        if (highlightNodes.Count == 0 && apexNodes.Count == 0) return;
        <ol class="clip-editor-children">
            @foreach (var child in ClipTree.InTimeOrder(highlightNodes, apexNodes))
            {
                if (child.Apex is { } directApex)
                {
                    @ApexListItem(directApex)
                    continue;
                }
                var node = child.Highlight!;
                <li class="highlight-editor-item" @key="node.Highlight.Id">
                    @if (highlightForm?.HighlightId == node.Highlight.Id)
                    {
                        @HighlightFormFragment(highlightForm)
                    }
                    else
                    {
                        <div class="clip-editor-line">
                        <ClipHighlightRow Node="node" Busy="busy"
                                          OnSeek="() => SeekToAsync(node.Highlight.StartSeconds)"
                                          OnPlay="() => PlayHighlightAsync(node.Highlight)"
                                          OnToggleFavorite="() => ToggleHighlightFavoriteAsync(node.Highlight)"
                                          OnEdit="() => StartEditHighlightAsync(node.Highlight)"
                                          OnDelete="() => pendingDelete = node.Highlight" />
                        </div>
                    }
                    @if (node.Apexes.Count > 0)
                    {
                        <ol class="clip-editor-children">
                            @foreach (var apexNode in node.Apexes)
                            {
                                @ApexListItem(apexNode)
                            }
                        </ol>
                    }
                </li>
            }
        </ol>
    };

    private RenderFragment ApexListItem(ApexNode node) =>
        @<li class="apex-editor-item" @key="node.Apex.Id">
            @if (apexForm?.ApexId == node.Apex.Id)
            {
                @ApexFormFragment(apexForm)
            }
            else
            {
                <div class="clip-editor-line">
                <ClipApexRow Node="node" Busy="busy"
                             OnSeek="() => SeekToAsync(ApexRanges.StartFor(node.Apex))"
                             OnToggleFavorite="() => ToggleApexFavoriteAsync(node.Apex)"
