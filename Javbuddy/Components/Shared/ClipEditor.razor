    private async Task SaveApexAsync()
    {
        if (apexForm is not { } form || busy) return;

        if (!SceneTimeFormat.TryParse(form.Time, out var seconds))
        {
            error = "Enter the time as m:ss or h:mm:ss.";
            return;
        }
        if (!ApexWindowText.TryParse(form.LeadIn, out var leadIn) || !ApexWindowText.TryParse(form.Tail, out var tail))
        {
            error = "Enter the lead-in and tail as seconds, or leave them blank.";
            return;
        }

        var tagIds = form.Tags.Select(t => t.TagId).ToList();
        var actorIds = form.ActorIds?.ToList() ?? [];
        var window = new ApexWindowOverride(leadIn, tail);
        await RunAsync(async () =>
        {
            var result = form.ApexId is { } apexId
                ? await ApexService.UpdateApexAsync(apexId, seconds, tagIds, actorIds, window)
                : await ApexService.AddApexAsync(MovieId, seconds, tagIds, actorIds, window);
            return (result.Success, result.ErrorMessage, result.MovieTagsChanged);
        }, closeForm: () => apexForm = null);
    }

