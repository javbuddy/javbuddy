                                    <RedundantMark Tooltip="@ImplicitChip.RedundantTagTooltip(carried.Sources)" />
                                }
                                <button type="button" class="scene-editor-chip-remove" disabled="@busy" aria-label="Remove @tag.Name" @onclick="() => RemoveSceneTagAsync(editing.Id, tag.TagId)">×</button>
                            </span>
                        }
                        <ImplicitChips Items="rolledUp" />
                    </div>
                }
                <TagSearchAdd ExcludedTagIds="@editing.Tags.Select(t => t.TagId).ToHashSet()" OnAdd="tagId => AddSceneTagAsync(editing.Id, tagId)" />
            </div>
            @ActorTagsFragment(ActorTagLevel.Scene, editing.Id, editing.EffectiveActors, actorTags.Scenes.GetValueOrDefault(editing.Id) ?? [])
        </div>
    }
    else if (sceneForm is { SceneId: null })
    {
        <p class="scene-editor-hint scene-editor-links-hint">Add the scene first, then edit it to set actors and tags.</p>
    }
    </div>;

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        if (subscribed)
        {
            SceneMediaQueue.Generated -= OnMediaGenerated;
        }
        if (shortcuts is not null)
        {
            await shortcuts.DisposeAsync(jsModule);
        }
        try
        {
            if (jsModule is not null)
            {
                await jsModule.InvokeVoidAsync("unwatchTopFit", topBlock);
                await jsModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
