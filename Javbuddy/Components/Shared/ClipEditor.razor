    // Every tag an edited highlight's apexes roll up to it, its own included: the form
    // grays the ones it doesn't hold and marks the ones it does as redundant.
    private IReadOnlyList<ImplicitTag> RolledUpTags(int? highlightId) =>
        highlightId is { } id && tree.Scenes.SelectMany(s => s.Highlights).Concat(tree.OutsideHighlights).FirstOrDefault(h => h.Highlight.Id == id) is { } node
            ? [.. node.ImplicitTags.Concat(node.RedundantTags)
                .OrderBy(t => t.Tag.ParentName ?? t.Tag.Name, StringComparer.OrdinalIgnoreCase)
                .ThenBy(t => t.Tag.Name, StringComparer.OrdinalIgnoreCase)]
            : [];

