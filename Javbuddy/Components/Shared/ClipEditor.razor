    /// apex's tags and its own actors — without any, the new apex inherits.
    /// Pressing it again while adding moves the time; ignored while an existing apex is being edited.</summary>
    [JSInvokable]
    public Task StartApexAtAsync(double seconds)
    {
        if (apexForm is { ApexId: not null })
        {
            error = "Save or cancel the apex being edited first.";
        }
        else
        {
            error = null;
            var time = Clamp(seconds);
            if (apexForm is null)
            {
                var previous = ApexRanges.PreviousFor(apexes, time);
                apexForm = new ApexFormModel
                {
                    Time = SceneTimeFormat.FormatPrecise(time),
                    Tags = previous is null ? [] : [.. previous.Tags],
                    ActorIds = previous is { Actors.Count: > 0 } ? [.. previous.Actors.Select(a => a.ActorId)] : null
                };
            }
            else
            {
                apexForm.Time = SceneTimeFormat.FormatPrecise(time);
            }
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    // --- Deleting ---

    private async Task ConfirmDeleteAsync()
    {
        switch (pendingDelete)
        {
            // A scene's tag links go with it.
            case SceneItem scene:
                await RunSceneAsync(() => SceneService.DeleteSceneAsync(scene.Id), movieTagsMayChange: true,
                    closeForm: sceneForm?.SceneId == scene.Id ? () => sceneForm = null : null);
                break;
            case HighlightItem highlight:
                await RunAsync(async () =>
                {
                    var result = await HighlightService.DeleteHighlightAsync(highlight.Id);
                    return (result.Success, result.ErrorMessage, result.MovieTagsChanged);
                }, closeForm: highlightForm?.HighlightId == highlight.Id ? () => highlightForm = null : null);
                break;
            case ApexItem apex:
                await RunAsync(async () =>
                {
                    var result = await ApexService.DeleteApexAsync(apex.Id);
                    return (result.Success, result.ErrorMessage, result.MovieTagsChanged);
                }, closeForm: apexForm?.ApexId == apex.Id ? () => apexForm = null : null);
                break;
        }
        pendingDelete = null;
    }

    private void CancelDelete()
    {
        if (!busy) pendingDelete = null;
    }

    // --- Running changes ---

    private async Task RunShortcutAsync(Func<Task> operation)
    {
        await operation();
        StateHasChanged();
    }

    private Task RunSceneAsync(Func<Task<SceneOperationResult>> operation, bool movieTagsMayChange = false, Action? closeForm = null) =>
        RunAsync(async () =>
        {
            var result = await operation();
            return (result.Success, result.ErrorMessage, movieTagsMayChange);
        }, closeForm);

    /// <summary>Runs one change, then reloads the whole tree; closeForm runs on success.</summary>
    private async Task RunAsync(Func<Task<(bool Success, string? Error, bool MovieTagsChanged)>> operation, Action? closeForm = null)
    {
        if (busy) return;
        busy = true;
        try
        {
            var (success, failure, movieTagsChanged) = await operation();
            if (!success)
            {
                error = failure;
                return;
            }

            error = null;
            closeForm?.Invoke();
            await ReloadAsync();
            if (movieTagsChanged) await OnMovieTagsMayHaveChanged.InvokeAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // --- Player ---

    private Task SeekToAsync(double seconds) => InvokePlayerAsync("seek", seconds);

    private Task PlayHighlightAsync(HighlightItem highlight) => InvokePlayerAsync("playClip", highlight.StartSeconds, highlight.EndSeconds);

    // Re-read whenever a form opens: the cast may have changed since (e.g. Edit Cast on the Review card).
    private async Task ReloadCastAsync() => cast = await SceneService.GetCastOptionsAsync(MovieId);

    private async Task InvokePlayerAsync(string function, params object[] args)
    {
        try
        {
            if (await GetModuleAsync() is { } module)
            {
                await module.InvokeAsync<bool>(function, [VideoSelector, .. args]);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>The player's time formatted for a form, or null (with an error shown) when it isn't playing.</summary>
    private async Task<string?> TimeFromPlayerAsync()
    {
        var time = await CurrentTimeAsync();
        if (time is null)
        {
            error = "Start playback to use the player's time.";
            return null;
        }

        error = null;
        return SceneTimeFormat.FormatPrecise(time.Value);
    }

    private async Task<double?> CurrentTimeAsync()
    {
        try
        {
            if (await GetModuleAsync() is not { } module) return null;
            var time = await module.InvokeAsync<double?>("currentTime", VideoSelector);
            return time is { } t ? Clamp(t) : null;
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
    }

    private double Clamp(double seconds) =>
        DurationSeconds is { } duration ? Math.Min(seconds, duration) : seconds;

    /// <summary>The JS module, or null when it can't be loaded (circuit gone, script error) — player
    /// features then quietly do nothing rather than failing the circuit.</summary>
    private async Task<IJSObjectReference?> GetModuleAsync()
    {
        try
        {
            return jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ClipEditor.razor.js");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            return null;
        }
    }

