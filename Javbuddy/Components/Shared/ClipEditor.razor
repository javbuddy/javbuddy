    // Actor tags apply at once, like the scene's actors and tags, so an add form (no clip yet) has none.
    private RenderFragment ActorTagsFragment(ActorTagLevel level, int ownerId, EffectiveActors effective, IReadOnlyList<EffectiveActorTag> tags) => __builder =>
    {
        var actors = effective.Actors
            .Concat(tags.Where(t => effective.Actors.All(a => a.ActorId != t.ActorId)).Select(t => t.ActorId).Distinct()
                .Select(id => cast.FirstOrDefault(c => c.ActorId == id) ?? new SceneActorItem(id, $"Actor {id}")))
            .ToList();
