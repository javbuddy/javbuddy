@using Microsoft.Extensions.DependencyInjection
@inject IActorImageCacheService ActorImageCacheService
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Show)
{
    <ModalShell SpreadFooter="true" MaxWidth="780px" OnClose="CloseAsync" Busy="@(saving || deleting || fetchingUrl)">
        <TitleContent>Change Portrait — @ActorName</TitleContent>
        <HeaderActions>
            @if (selectedImageBytes is not null)
            {
                <InfoTip Text="Drag inside the box to pan. Drag handles to resize. Scroll to zoom." />
            }
        </HeaderActions>
        <ChildContent>
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger py-2 mb-3">@errorMessage</div>
            }

            @if (selectedImageBytes is null)
            {
                <ImageSourcePicker UrlInputId="actor-image-url-input"
                                   UrlPlaceholder="https://example.com/photo.jpg"
                                   FetchAsync="FetchFromUrlAsync"
                                   OnPicked="OnImagePicked"
                                   OnError="SetError"
                                   OnFetchingChanged="SetFetching" />

                @if (hasCustomImage)
                {
                    <div class="mt-4 p-3 bg-dark border border-secondary rounded d-flex align-items-center justify-content-between">
                        <div>
                            <strong class="text-light">Custom Portrait Active</strong>
                            <p class="text-muted small mb-0">This actor currently has a custom uploaded portrait.</p>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RemoveCustomPhotoAsync" disabled="@deleting">
                            @(deleting ? "Removing…" : "Revert to Library Photo")
                        </button>
                    </div>
                }
            }
            else
            {
                <CropWorkspace Style="--crop-previews-width: 140px; --crop-previews-padding: 0.75rem; --crop-previews-gap: 0.75rem" BusyLabel="@(!cropperReady && !imageFailed ? "Preparing image" : null)">
                    <ChildContent>
                        <CropperViewport HeightPx="380" @ref="viewport" />
                    </ChildContent>
                    <Previews>
                        <div class="preview-circle-wrapper" title="Circular Avatar Preview">
                            <canvas width="96" height="96" class="preview-canvas" @ref="circleCanvasRef"></canvas>
                        </div>
                        <div class="preview-square-wrapper" title="Square Avatar Preview">
                            <canvas width="80" height="80" class="preview-canvas" @ref="squareCanvasRef"></canvas>
                        </div>
                    </Previews>
                </CropWorkspace>

                <CropToolbar @ref="toolbar"
                             Ratios="ratios"
                             CurrentRatio="currentAspectRatio"
                             RatioSelected="SetAspectRatio"
                             ZoomInputId="actor-zoom"
                             OnReset="ResetCrop" />
            }
        </ChildContent>
        <FooterContent>
            @if (selectedImageBytes is not null)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetSelection" disabled="@saving">
                    Choose Different Image
                </button>
                <div class="modal-shell-footer-group">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="SaveFullAsync" disabled="@saving">
                        Upload Full (Skip Crop)
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveCroppedAsync" disabled="@(saving || !cropperReady)">
                        @(saving ? "Saving…" : "Save Photo")
                    </button>
                </div>
            }
            else
            {
                <div></div>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseAsync">
                    Cancel
                </button>
            }
        </FooterContent>
    </ModalShell>
}

@code {
    [Parameter]
    public bool Show { get; set; }

    [Parameter]
    public int ActorId { get; set; }

    [Parameter]
    public string ActorName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnPhotoChanged { get; set; }

    /// <summary>Optional WebP image bytes from an actor gallery photo, opened directly in the
    /// same crop/editor workflow as a newly selected portrait file.</summary>
    [Parameter]
    public InitialImageSource? InitialImage { get; set; }

    // Wraps the bytes rather than taking a byte[] parameter: an array-typed component parameter
    // crashes the SDK's BL0014 for-loop analyzer (AD0001 build warning) in any parent whose
    // markup also has a @for loop, as ActorDetail's does.
    public sealed record InitialImageSource(byte[] Bytes);

    [Inject] private IServiceProvider Sp { get; set; } = default!;
    private ImageUploadSettings UploadSettings => Sp.GetService<ImageUploadSettings>() ?? ImageUploadSettings.Default;

    private bool hasCustomImage;
    private string? selectedImageContentType;
    private byte[]? selectedImageBytes;
    private double? currentAspectRatio = 1.0;
    private bool saving;
    private bool deleting;
    private string? errorMessage;
    private bool shouldInitCropper;
    // Whether the cropper for the selected image is up, so Save Photo can read its crop rect;
    // until then a click would have nothing to save.
    private bool cropperReady;
    // The browser couldn't decode the image: stop the spinner, but keep Save Photo disabled.
    private bool imageFailed;
    private bool fetchingUrl;
    private InitialImageSource? loadedInitialImage;

    private CropperViewport? viewport;
    private ElementReference circleCanvasRef;
    private ElementReference squareCanvasRef;
    private CropToolbar? toolbar;

    private IJSObjectReference? jsModule;
    private DotNetObjectReference<ActorImageUploadModal>? selfRef;

    protected override async Task OnParametersSetAsync()
    {
        if (Show && ActorId > 0)
        {
            hasCustomImage = await ActorImageCacheService.HasCustomImageAsync(ActorId);
            if (InitialImage is not null && !ReferenceEquals(InitialImage, loadedInitialImage))
            {
                loadedInitialImage = InitialImage;
                LoadSelectedImage(InitialImage.Bytes, "image/webp");
            }
        }
        else if (!Show)
        {
            ResetSelection();
            loadedInitialImage = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldInitCropper && selectedImageBytes is not null && selectedImageContentType is not null)
        {
            shouldInitCropper = false;
            try
            {
                jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ActorImageUploadModal.razor.js");
                // Stream the bytes to the browser as a blob URL instead of rendering a base64
                // data: URL, which kept a multi-MB string in the render tree and SignalR frame.
                using var streamRef = new DotNetStreamReference(new MemoryStream(selectedImageBytes, writable: false));
                await jsModule.InvokeVoidAsync("setImageSource", viewport!.Image, streamRef, selectedImageContentType);
                selfRef ??= DotNetObjectReference.Create(this);
                await jsModule.InvokeVoidAsync("setHost", selfRef);
                await jsModule.InvokeVoidAsync("initCropper", viewport!.Container, viewport.Image, circleCanvasRef, squareCanvasRef);
                await jsModule.InvokeVoidAsync("bindControls", toolbar!.ZoomInput, toolbar.ZoomReadout, null, null);
                if (currentAspectRatio.HasValue)
                {
                    await jsModule.InvokeVoidAsync("setAspectRatio", currentAspectRatio.Value);
                }
                else
                {
                    await jsModule.InvokeVoidAsync("setAspectRatio", (object?)null);
                }
                cropperReady = true;
                StateHasChanged();
            }
            catch (JSException ex)
            {
                errorMessage = $"Could not initialize cropper: {ex.Message}";
            }
        }
    }

    /// <summary>Called from JS when the browser can't decode the loaded image.</summary>
    [JSInvokable]
    public Task OnImageError() => InvokeAsync(() =>
    {
        errorMessage = "The image could not be displayed. It may be corrupt or in an unsupported format.";
        imageFailed = true;
        StateHasChanged();
    });

    private static readonly CropToolbar.RatioPreset[] ratios =
    [
        new("1:1", 1.0, "Square crop (1:1)"),
        new("2:3", 2.0 / 3.0, "Portrait crop (2:3)"),
    ];

    private void OnImagePicked(ImageSourcePicker.PickedImage image) => LoadSelectedImage(image.Bytes, image.ContentType);

    private void SetError(string? message) => errorMessage = message;

    private void SetFetching(bool fetching) => fetchingUrl = fetching;

    private void LoadSelectedImage(byte[] bytes, string contentType)
    {
        selectedImageBytes = bytes;
        selectedImageContentType = contentType;
        currentAspectRatio = 1.0;
        shouldInitCropper = true;
        cropperReady = false;
        imageFailed = false;
    }

    private async Task SetAspectRatio(double? ratio)
    {
        currentAspectRatio = ratio;
        if (jsModule is not null)
        {
            try
            {
                if (ratio.HasValue)
                {
                    await jsModule.InvokeVoidAsync("setAspectRatio", ratio.Value);
                }
                else
                {
                    await jsModule.InvokeVoidAsync("setAspectRatio", (object?)null);
                }
            }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
    }

    private async Task ResetCrop()
    {
        if (jsModule is not null)
        {
            try
            {
                await jsModule.InvokeVoidAsync("setZoom", 1.0);
                await jsModule.InvokeVoidAsync("resetCrop");
            }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
    }

    private void ResetSelection()
    {
        selectedImageContentType = null;
        selectedImageBytes = null;
        errorMessage = null;
        shouldInitCropper = false;
        cropperReady = false;
        imageFailed = false;
        currentAspectRatio = 1.0;
        fetchingUrl = false;
    }

    private async Task<ImageSourcePicker.FetchResult> FetchFromUrlAsync(string url)
    {
        var result = await ActorImageCacheService.DownloadImageFromUrlAsync(url);
        return new(result.Success ? result.Bytes : null, result.ContentType, result.ErrorMessage);
    }

    private record CropRectDto(double x, double y, double width, double height);

    private async Task SaveCroppedAsync()
    {
        if (selectedImageBytes is null || jsModule is null) return;
        saving = true;
        errorMessage = null;

        try
        {
            var dto = await jsModule.InvokeAsync<CropRectDto?>("getCropRect");
            if (dto is null)
            {
                errorMessage = "The image is still loading. Try again in a moment.";
                return;
            }
            var cropRect = new NormalizedCropRect(dto.x, dto.y, dto.width, dto.height);
            await ActorImageCacheService.SaveCustomImageAsync(ActorId, selectedImageBytes, cropRect);
            await OnPhotoChanged.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save photo: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveFullAsync()
    {
        if (selectedImageBytes is null) return;
        saving = true;
        errorMessage = null;

        try
        {
            await ActorImageCacheService.SaveCustomImageAsync(ActorId, selectedImageBytes, cropRect: null);
            await OnPhotoChanged.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save photo: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task RemoveCustomPhotoAsync()
    {
        deleting = true;
        errorMessage = null;

        try
        {
            await ActorImageCacheService.DeleteCustomImageAsync(ActorId);
            hasCustomImage = false;
            await OnPhotoChanged.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to remove custom photo: {ex.Message}";
        }
        finally
        {
            deleting = false;
        }
    }

    private async Task CloseAsync()
    {
        ResetSelection();
        if (jsModule is not null)
        {
            try
            {
                await jsModule.InvokeVoidAsync("destroyCropper");
            }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        if (jsModule is not null)
        {
            try
            {
                await jsModule.InvokeVoidAsync("destroyCropper");
                await jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
    }
}
