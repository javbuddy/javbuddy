<a class="@CssClass" href="@Href">
    <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" /></svg>
    @ChildContent
</a>

@code {
    /// <summary>Link target for the back-navigation button.</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = "";

    /// <summary>The page's own toolbar-button CSS class (e.g. "movie-toolbar-btn",
    /// "actor-toolbar-btn") — each page keeps its own toolbar styling, only the chevron
    /// icon + wrapper markup is shared here.</summary>
    [Parameter, EditorRequired] public string CssClass { get; set; } = "";

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
