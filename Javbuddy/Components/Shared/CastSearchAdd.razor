@inject IActorService ActorService

<SearchAddBox TItem="ActorSearchItem" ClassPrefix="cast-search" Placeholder="Search actors to add…"
              Search="SearchAsync" OnAdd="candidate => OnAdd.InvokeAsync(candidate.Id)">
    <ItemTemplate Context="candidate">
        @if (candidate.HasImage)
        {
            <img class="cast-search-avatar" src="@($"/actor-image/{candidate.Id}/thumb")" alt="" loading="lazy" />
        }
        else
        {
            <span class="cast-search-avatar">@ActorMatching.Initials(candidate.DisplayName)</span>
        }
        <span>@candidate.DisplayName</span>
    </ItemTemplate>
</SearchAddBox>

@code {
    /// <summary>Tracked actors already on the movie, hidden from the results.</summary>
    [Parameter] public IReadOnlyCollection<int> ExcludedActorIds { get; set; } = [];

    /// <summary>Raised with the chosen actor's ID; the search box resets itself afterwards.</summary>
    [Parameter] public EventCallback<int> OnAdd { get; set; }

    private async Task<IReadOnlyList<ActorSearchItem>> SearchAsync(string term, CancellationToken ct)
    {
        var matches = await ActorService.SearchActorsAsync(term, ct);
        return matches.Where(a => !ExcludedActorIds.Contains(a.Id)).ToList();
    }
}
