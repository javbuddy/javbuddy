@* Display-options dialog behind a page toolbar's "Options" button: the Movies page's Poster Options
   and the Actors page's Actor Options. Render it only while open; ✕, Close, Esc and a
   backdrop click call OnClose (the chrome is ModalShell's). Lay each setting out as
   <div class="options-row"><span class="options-label">…</span>control</div> — those two classes
   are styled here (via ::deep) so every row's control lines up behind a fixed label column. *@
<ModalShell Themed="true" Title="@Title" OnClose="OnClose" MaxWidth="520px">
    <ChildContent>
        <div class="options-modal-content">
            @ChildContent
        </div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-outline-secondary" type="button" @onclick="OnClose">Close</button>
    </FooterContent>
</ModalShell>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
}
