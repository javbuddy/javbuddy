@using Javbuddy.Models
@using Javbuddy.Services
@using Javbuddy.Services.Warashi
@inject IWarashiClient WarashiClient
@inject IActorService ActorService

@if (Show && Actor is not null)
{
    <ModalShell MaxWidth="680px" OnClose="CloseAsync" Busy="@isEnriching">
        <TitleContent>Search Metadata — @Actor.DisplayName</TitleContent>
        <ChildContent>
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger py-2 mb-3">@errorMessage</div>
            }

            <div class="input-group mb-3">
                <input type="text" class="form-control search-input" placeholder="Search performer name, kanji, or alias…"
                       @bind="searchQuery" @bind:event="oninput" @onkeydown="HandleInputKeyDown" disabled="@isSearching" />
                <button class="btn btn-primary" type="button" @onclick="ExecuteSearch" disabled="@(isSearching || string.IsNullOrWhiteSpace(searchQuery))">
                    @(isSearching ? "Searching…" : "Search")
                </button>
            </div>

            @if (isSearching)
            {
                <div class="text-center py-4 text-muted">
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span> Searching WAPdB...
                </div>
            }
            else if (searchResults is not null)
            {
                @if (searchResults.Count == 0)
                {
                    <p class="text-muted small my-3 text-center">No matching performers found on WAPdB.</p>
                }
                else
                {
                    <div class="search-results-list">
                        @foreach (var res in searchResults)
                        {
                            var isSelected = selectedPath == res.PathOrUrl;
                            <div class="search-result-item @(isSelected ? "selected" : "")" @onclick="() => SelectPerformer(res)">
                                @if (!string.IsNullOrWhiteSpace(res.ImageUrl))
                                {
                                    <img src="@res.ImageUrl" alt="@res.Name" class="search-result-thumb" />
                                }
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold text-truncate">
                                        @res.Name
                                        @if (!string.IsNullOrWhiteSpace(res.JapaneseName))
                                        {
                                            <span class="text-muted fw-normal ms-1">(@res.JapaneseName)</span>
                                        }
                                        @if (res.IsExactMatch)
                                        {
                                            <span class="badge bg-success ms-1">Exact match</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(res.CareerActivity))
                                    {
                                        <div class="text-muted small">@res.CareerActivity</div>
                                    }
                                    @if (res.KnownAliases.Count > 0)
                                    {
                                        <div class="text-muted small text-truncate">AKA: @string.Join(", ", res.KnownAliases)</div>
                                    }
                                </div>
                                <button class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-secondary") flex-shrink-0"
                                        type="button" disabled="@isLoadingDetail">
                                    @(isLoadingDetail && isSelected ? "Loading…" : (isSelected ? "Selected" : "Inspect"))
                                </button>
                            </div>
                        }
                    </div>
                }
            }

            @if (selectedDetail is not null)
            {
                <div class="performer-detail-card mt-3">
                    <div class="d-flex align-items-start gap-3">
                        @if (!string.IsNullOrWhiteSpace(selectedDetail.MainPhotoUrl))
                        {
                            <img src="@selectedDetail.MainPhotoUrl" alt="@selectedDetail.Name" class="performer-detail-thumb" />
                        }
                        <div class="flex-grow-1">
                            <h6 class="mb-1">
                                @selectedDetail.Name
                                @if (!string.IsNullOrWhiteSpace(selectedDetail.JapaneseName))
                                {
                                    <span class="text-muted ms-1">· @selectedDetail.JapaneseName</span>
                                }
                            </h6>

                            <div class="performer-badges">
                                @if (selectedDetail.HeightCm.HasValue)
                                {
                                    <span class="badge bg-secondary">Height: @selectedDetail.HeightCm cm</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(selectedDetail.CupSize))
                                {
                                    <span class="badge bg-info text-dark">Cup: @selectedDetail.CupSize</span>
                                }
                                @if (selectedDetail.Bust.HasValue && selectedDetail.Waist.HasValue && selectedDetail.Hips.HasValue)
                                {
                                    <span class="badge bg-secondary">B/W/H: @selectedDetail.Bust-@selectedDetail.Waist-@selectedDetail.Hips</span>
                                }
                                @if (selectedDetail.BirthDate.HasValue)
                                {
                                    <span class="badge bg-secondary">Born: @selectedDetail.BirthDate.Value.ToString("MMM d, yyyy")</span>
                                }
                                @if (selectedDetail.IsRetired.HasValue)
                                {
                                    <span class="badge @(selectedDetail.IsRetired.Value ? "bg-warning text-dark" : "bg-success")">
                                        @(selectedDetail.IsRetired.Value ? "Retired" : "Active")
                                    </span>
                                }
                            </div>

                            @if (selectedDetail.Aliases.Count > 0)
                            {
                                <div class="text-muted small mt-2">
                                    <strong>Aliases:</strong> @string.Join(", ", selectedDetail.Aliases)
                                </div>
                            }
                        </div>
                    </div>

                    <ActorImportFieldPicker Actor="Actor" Values="selectedDetail.ToImportedData()" Options="importOptions"
                                            SourceName="WAPdB" HasKnownAttributes="selectedDetail.HasKnownAttributes" Disabled="isEnriching"
                                            OnOptionsChanged="@StateHasChanged" OnSelectAll="SelectAllExtraFields" OnDeselectAll="DeselectAllExtraFields">
                        <ExtraRows>
                            @{
                                var totalPhotos = PhotoCount(selectedDetail);
                                var hasPhoto = totalPhotos > 0;
                            }
                            <div class="import-field-item @(hasPhoto ? "" : "field-unavailable")">
                                <div class="form-check m-0">
                                    <input class="form-check-input" type="checkbox" id="field-photo"
                                           @bind="importOptions.ImportPhotos" disabled="@(!hasPhoto || isEnriching)" />
                                    <label class="form-check-label fw-medium" for="field-photo">Photos (album "WAPdB")</label>
                                </div>
                                <div class="field-values">
                                    <span class="field-new-value">@(hasPhoto ? $"{totalPhotos} photo(s)" : "—")</span>
                                    <span class="field-current-value">Current: @(ActorHasImage ? "Has portrait" : "No portrait")</span>
                                </div>
                            </div>
                        </ExtraRows>
                    </ActorImportFieldPicker>
                </div>
            }
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync" disabled="@isEnriching">Cancel</button>
            @if (selectedDetail is not null)
            {
                var count = importOptions.SelectedCount(selectedDetail);
                <button type="button" class="btn btn-primary" @onclick="EnrichActor" disabled="@(isEnriching || count == 0)">
                    @(isEnriching ? "Enriching…" : $"Enrich {Actor.DisplayName} ({count})")
                </button>
            }
        </FooterContent>
    </ModalShell>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public Actor? Actor { get; set; }
    [Parameter] public bool ActorHasImage { get; set; }
    [Parameter] public string? InitialSelectedPath { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEnriched { get; set; }

    private string searchQuery = string.Empty;
    private bool isSearching;
    private bool isLoadingDetail;
    private bool isEnriching;
    private string? errorMessage;
    private IReadOnlyList<WarashiSearchResult>? searchResults;
    private WarashiPerformerDetail? selectedDetail;
    private string? selectedPath;
    private int? lastActorId;
    private WarashiImportOptions importOptions = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Show && Actor is not null && lastActorId != Actor.Id)
        {
            lastActorId = Actor.Id;
            errorMessage = null;
            searchResults = null;
            selectedDetail = null;
            selectedPath = null;
            importOptions = new WarashiImportOptions();

            if (!string.IsNullOrWhiteSpace(InitialSelectedPath))
            {
                // Handed off from the combined "Search all providers" picker — the candidate is
                // already chosen, so skip straight to its detail instead of re-searching by name.
                searchQuery = Actor.DisplayName;
                await SelectPerformerByPath(InitialSelectedPath);
            }
            else
            {
                searchQuery = !string.IsNullOrWhiteSpace(Actor.JapaneseNameKanji)
                    ? Actor.JapaneseNameKanji
                    : Actor.DisplayName;
                await ExecuteSearch();
            }
        }
        else if (!Show)
        {
            lastActorId = null;
        }
    }

    private async Task HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteSearch();
        }
        else if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;

        isSearching = true;
        errorMessage = null;
        selectedDetail = null;
        selectedPath = null;

        try
        {
            var query = searchQuery.Trim();
            searchResults = await WarashiClient.SearchPerformersAsync(query);

            // Auto-select exact match only if it has known attributes
            var exact = searchResults.FirstOrDefault(r => r.IsExactMatch);
            if (exact != null)
            {
                var detail = await WarashiClient.GetPerformerDetailAsync(exact.PathOrUrl);
                if (detail != null && detail.HasKnownAttributes)
                {
                    selectedPath = exact.PathOrUrl;
                    selectedDetail = detail;
                    InitializeImportOptions();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Search failed: {ex.Message}";
            searchResults = Array.Empty<WarashiSearchResult>();
        }
        finally
        {
            isSearching = false;
        }
    }

    private Task SelectPerformer(WarashiSearchResult result) => SelectPerformerByPath(result.PathOrUrl);

    private async Task SelectPerformerByPath(string path)
    {
        isLoadingDetail = true;
        selectedPath = path;
        errorMessage = null;

        try
        {
            selectedDetail = await WarashiClient.GetPerformerDetailAsync(path);
            if (selectedDetail is not null)
            {
                InitializeImportOptions();
                searchQuery = selectedDetail.Name;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load performer details: {ex.Message}";
        }
        finally
        {
            isLoadingDetail = false;
        }
    }

    private void InitializeImportOptions()
    {
        if (selectedDetail is null) return;

        if (!selectedDetail.HasKnownAttributes)
        {
            importOptions = new WarashiImportOptions
            {
                ImportJapaneseName = false,
                ImportHeight = false,
                ImportCupSize = false,
                ImportMeasurements = false,
                ImportBirthDate = false,
                ImportRetiredStatus = false,
                ImportAliases = false,
                ImportPhotos = false
            };
            return;
        }

        var hasNewKanji = !string.IsNullOrWhiteSpace(selectedDetail.JapaneseName) &&
                          (Actor is null || !string.Equals(Actor.JapaneseNameKanji, selectedDetail.JapaneseName, StringComparison.Ordinal));

        importOptions = new WarashiImportOptions
        {
            ImportJapaneseName = hasNewKanji,
            ImportHeight = selectedDetail.HeightCm.HasValue,
            ImportCupSize = !string.IsNullOrWhiteSpace(selectedDetail.CupSize),
            ImportMeasurements = selectedDetail.Bust.HasValue || selectedDetail.Waist.HasValue || selectedDetail.Hips.HasValue,
            ImportBirthDate = selectedDetail.BirthDate.HasValue,
            ImportRetiredStatus = selectedDetail.IsRetired.HasValue,
            ImportAliases = selectedDetail.Aliases.Count > 0,
            ImportPhotos = false
        };
    }

    private static int PhotoCount(WarashiPerformerDetail detail) =>
        (string.IsNullOrWhiteSpace(detail.MainPhotoUrl) ? 0 : 1) + detail.AdditionalPhotoUrls.Count;

    private void SelectAllExtraFields()
    {
        if (selectedDetail is not null) importOptions.ImportPhotos = PhotoCount(selectedDetail) > 0;
    }

    private void DeselectAllExtraFields() => importOptions.ImportPhotos = false;

    private async Task EnrichActor()
    {
        if (selectedDetail is null || Actor is null) return;

        isEnriching = true;
        errorMessage = null;
        var succeeded = false;

        try
        {
            var res = await ActorService.ImportOrEnrichFromWarashiAsync(selectedDetail, Actor.Id, importOptions);
            if (res.Success)
            {
                await OnEnriched.InvokeAsync();
                if (res.Warning is not null)
                {
                    // Keep the modal open so the user actually sees the warning instead of it
                    // flashing by as the modal auto-closes.
                    errorMessage = res.Warning;
                }
                else
                {
                    succeeded = true;
                }
            }
            else
            {
                errorMessage = res.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Enrichment failed: {ex.Message}";
        }
        finally
        {
            isEnriching = false;
        }

        if (succeeded)
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        if (!isEnriching)
        {
            await OnClose.InvokeAsync();
        }
    }
}
