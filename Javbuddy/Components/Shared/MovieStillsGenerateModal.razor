@* Generates extrafanart from the movie's own video: pick how many stills, preview the sharpest evenly
   spaced frames, tick the ones to keep and save them as WebP into the extrafanart folder.
   Hosted by Movie Detail (Tools menu, or the Add Images dialog's hand-off). *@
@implements IDisposable
@inject IMovieExtraFanartStillsService StillsService

@if (Show)
{
    <ModalShell MaxWidth="760px" OnClose="CloseAsync" Busy="@Busy">
        <TitleContent>Generate stills — @Code</TitleContent>
        <ChildContent>
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger py-2">@errorMessage</div>
            }
            <div class="stills-options">
                <label class="stills-option">
                    <span class="small">Stills</span>
                    <input type="number" class="form-control form-control-sm" min="@MovieExtraFanartStillsService.MinCount" max="@MovieExtraFanartStillsService.MaxCount"
                           @bind="count" disabled="@Busy" />
                </label>
                <label class="stills-option">
                    <span class="small">WebP quality</span>
                    <input type="number" class="form-control form-control-sm" min="@MovieExtraFanartStillsService.MinQuality" max="@MovieExtraFanartStillsService.MaxQuality"
                           @bind="quality" disabled="@Busy" />
                </label>
                <label class="stills-option">
                    <span class="small">Existing images</span>
                    <select class="form-select form-select-sm" @bind="mode" disabled="@Busy">
                        <option value="@ExtraFanartStillsMode.Append">Add to them</option>
                        <option value="@ExtraFanartStillsMode.ReplaceAll">Replace all</option>
                        <option value="@ExtraFanartStillsMode.OnlyIfNone">Only if there are none</option>
                    </select>
                </label>
            </div>
            <div class="form-check mt-2">
                <input id="stills-left-eye" type="checkbox" class="form-check-input" @bind="leftEyeOnly" disabled="@Busy" />
                <label for="stills-left-eye" class="form-check-label small">Crop to the left eye (side-by-side VR video)</label>
            </div>
            @if (saving)
            {
                <div class="stills-saving alert alert-info py-2 mt-3 mb-0" role="status">
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving @selected.Count image@(selected.Count == 1 ? string.Empty : "s")…
                </div>
            }
            @if (generating || arrived.Count > 0)
            {
                <div class="stills-grid mt-3" role="status" aria-busy="@generating.ToString().ToLowerInvariant()">
                    @foreach (var still in arrived)
                    {
                        var id = still.Id;
                        <label class="stills-tile @(selected.Contains(id) ? "stills-tile-selected" : "")">
                            <img src="@PreviewUrl(still)" alt="Still at @FormatTime(still.Seconds)" />
                            <span class="stills-tile-caption">
                                <input type="checkbox" checked="@selected.Contains(id)" @onchange="e => Toggle(id, (bool)e.Value!)" disabled="@Busy" />
                                @FormatTime(still.Seconds)
                            </span>
                        </label>
                    }
                    @if (generating)
                    {
                        @for (var i = arrived.Count; i < requested; i++)
                        {
                            <div class="stills-tile"><div class="stills-shimmer" title="Generating still"></div></div>
                        }
                    }
                </div>
            }
        </ChildContent>
        <FooterContent>
            @if (generating)
            {
                <button type="button" class="btn btn-outline-danger stills-stop" @onclick="StopGenerating" disabled="@stopping">@(stopping ? "Stopping…" : "Stop")</button>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseAsync" disabled="@Busy">Cancel</button>
            }
            <button type="button" class="btn btn-outline-primary" @onclick="GenerateAsync" disabled="@Busy">@(generating ? "Generating…" : preview is null ? "Generate previews" : "Regenerate")</button>
            @if (preview is not null)
            {
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(Busy || selected.Count == 0)">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>@:Saving…
                    }
                    else
                    {
                        @:Save @selected.Count selected
                    }
                </button>
            }
        </FooterContent>
    </ModalShell>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public int MovieId { get; set; }
    [Parameter] public string Code { get; set; } = string.Empty;

    /// <summary>The movie is side-by-side VR: the left-eye crop starts ticked.</summary>
    [Parameter] public bool IsVr { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised after stills were saved, so the caller can reload its gallery; <see cref="OnClose"/> follows.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>A save of a few WebP files takes a fraction of a second, too short to notice the saving state, so it
    /// is kept on screen for at least this long.</summary>
    [Parameter] public int MinSavingMilliseconds { get; set; } = 700;

    private int count = MovieExtraFanartStillsService.DefaultCount;
    private bool leftEyeOnly;
    private bool wasShown;
    private int quality = MovieExtraFanartStillsService.DefaultQuality;
    private ExtraFanartStillsMode mode = ExtraFanartStillsMode.Append;
    private ExtraFanartStillsPreview? preview;
    private readonly HashSet<int> selected = [];
    private readonly List<ExtraFanartStill> arrived = [];
    private int requested;
    private string? errorMessage;
    private bool generating;
    private bool stopping;
    private CancellationTokenSource? generateCts;
    private bool saving;
    private bool disposed;
    private readonly CancellationTokenSource cts = new();

    protected override void OnParametersSet()
    {
        // Set each time the modal opens, so it never overrides a choice made while it is open.
        if (Show && !wasShown) leftEyeOnly = IsVr;
        wasShown = Show;
    }

    private bool Busy => generating || saving;

    private static string FormatTime(double seconds) => TimeSpan.FromSeconds(seconds).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss");

    private void Toggle(int id, bool on)
    {
        if (on) selected.Add(id); else selected.Remove(id);
    }

    // Each preview's data URL, encoded once on first render: base64-encoding up to 20 frames on every
    // render (a checkbox tick, the shimmer count) is pure repeated work. Cleared with `arrived`, as ids
    // restart with every generation.
    private readonly Dictionary<int, string> previewUrls = [];

    private string PreviewUrl(ExtraFanartStill still)
    {
        if (!previewUrls.TryGetValue(still.Id, out var url))
        {
            url = "data:image/webp;base64," + Convert.ToBase64String(still.PreviewWebp);
            previewUrls[still.Id] = url;
        }
        return url;
    }

    private void ClearArrived()
    {
        arrived.Clear();
        previewUrls.Clear();
    }

    private void DiscardPreview()
    {
        preview?.Dispose();
        preview = null;
        selected.Clear();
        ClearArrived();
    }

    private async Task GenerateAsync()
    {
        if (Busy) return;

        generating = true;
        stopping = false;
        errorMessage = null;
        DiscardPreview();
        using var runCts = CancellationTokenSource.CreateLinkedTokenSource(cts.Token);
        generateCts = runCts;
        count = Math.Clamp(count, MovieExtraFanartStillsService.MinCount, MovieExtraFanartStillsService.MaxCount);
        requested = count;
        try
        {
            // Each still is shown (and ticked) the moment its slot of the video is done.
            void OnStill(ExtraFanartStill still) => _ = InvokeAsync(() =>
            {
                // A frame reported just before a stop landed must not reappear after the dialog went idle.
                if (disposed || !generating || runCts.IsCancellationRequested) return;
                arrived.Add(still);
                selected.Add(still.Id);
                StateHasChanged();
            });
            var result = await StillsService.PreviewAsync(MovieId, count, mode, leftEyeOnly, OnStill, runCts.Token);
            if (disposed)
            {
                result.Preview?.Dispose();
                return;
            }
            if (!result.Success)
            {
                errorMessage = result.ErrorMessage;
                ClearArrived();
                selected.Clear();
                return;
            }
            preview = result.Preview;
            // Anything the streaming callback didn't already show.
            foreach (var still in preview!.Stills.Where(st => arrived.All(a => a.Id != st.Id)))
            {
                arrived.Add(still);
                selected.Add(still.Id);
            }
            arrived.Sort((a, b) => a.Id.CompareTo(b.Id));
        }
        catch (OperationCanceledException) when (disposed)
        {
        }
        catch (OperationCanceledException) when (runCts.IsCancellationRequested)
        {
            // Stopped by the user: back to idle, nothing half-built kept (the service removed its scratch frames).
            ClearArrived();
            selected.Clear();
        }
        finally
        {
            generating = false;
            stopping = false;
            generateCts = null;
        }
    }

    private void StopGenerating()
    {
        if (!generating || stopping) return;
        stopping = true;
        try { generateCts?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    private async Task SaveAsync()
    {
        if (preview is null || Busy) return;

        saving = true;
        errorMessage = null;
        try
        {
            // The service re-encodes every frame before its first await; run on the thread pool, that CPU work can't hold
            // up the circuit, so the saving state is rendered at once instead of after the encoding.
            var chosen = selected.ToList();
            // Everything the pool thread uses is captured here: the token can't be read once Dispose has disposed its source.
            var (movieId, currentPreview, currentQuality, currentMode, token) = (MovieId, preview, quality, mode, cts.Token);
            var save = Task.Run(() => StillsService.SaveAsync(movieId, currentPreview, chosen, currentQuality, currentMode, token), token);
            // Disposed during this wait (the host going away), the save's result is dropped with the component.
            await Task.WhenAll(save, Task.Delay(Math.Max(0, MinSavingMilliseconds), token));
            var result = await save;
            if (!result.Success)
            {
                errorMessage = result.ErrorMessage;
                // Replace all may already have removed images; refresh the gallery either way.
                if (mode == ExtraFanartStillsMode.ReplaceAll) await OnSaved.InvokeAsync();
                return;
            }
            // Saved: the new images show in the gallery, so the dialog closes itself.
            DiscardPreview();
            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (OperationCanceledException) when (disposed)
        {
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CloseAsync()
    {
        if (Busy) return;
        DiscardPreview();
        errorMessage = null;
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        disposed = true;
        cts.Cancel();
        cts.Dispose();
        preview?.Dispose();
    }
}
