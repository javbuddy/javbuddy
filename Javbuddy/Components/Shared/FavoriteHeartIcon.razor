<svg viewBox="0 0 16 16" width="@Size" height="@Size" fill="currentColor" aria-hidden="true"><use href="@(Filled ? "#jb-icon-heart-filled" : "#jb-icon-heart")" /></svg>

@code {
    /// <summary>The favorite heart glyph (filled when favorited, outlined otherwise) shared by the
    /// movie favorite toggles on PosterCard and Movie Detail's toolbar. The glyph's path lives once in
    /// App.razor's icon sprite: a poster grid repeats this per card, and inlining the path made it most of
    /// each card's markup.</summary>
    [Parameter] public bool Filled { get; set; }

    [Parameter] public int Size { get; set; } = 16;
}
