@using Javbuddy.Models
@using Javbuddy.Services
@inject IActorService ActorService

@if (Show && SourceActor is not null)
{
    <div class="merge-modal-backdrop" @onclick="CloseAsync" @onkeydown="HandleKeyDown" tabindex="0">
        <div class="merge-modal-panel" @onclick:stopPropagation="true">
            <div class="merge-modal-header">
                <h5 class="merge-modal-title">Merge Actor — @SourceActor.DisplayName</h5>
                <button type="button" class="merge-modal-close-btn" @onclick="CloseAsync" aria-label="Close" disabled="@isMerging">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854z" /></svg>
                </button>
            </div>

            <div class="merge-modal-body">
                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger py-2 mb-3">@errorMessage</div>
                }

                <div class="merge-notice mb-3">
                    <p class="mb-0 small">
                        Merging re-points all linked movies, metadata, external IDs, and cached photos to the target canonical actor.
                        <strong>@SourceActor.DisplayName</strong> will be permanently deleted and saved as an alias on the target.
                    </p>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Source (Will be deleted)</label>
                        <div class="actor-card source-card">
                            @if (sourceHasImage)
                            {
                                <div class="actor-card-avatar actor-card-avatar-photo">
                                    <img src="@($"/actor-image/{SourceActor.Id}/thumb")" alt="@SourceActor.DisplayName" />
                                </div>
                            }
                            else
                            {
                                <div class="actor-card-avatar">@ActorMatching.Initials(SourceActor.DisplayName)</div>
                            }
                            <div class="actor-card-info">
                                <div class="actor-card-name text-truncate">@SourceActor.DisplayName</div>
                                @if (!string.IsNullOrWhiteSpace(SourceActor.JapaneseNameKanji) || !string.IsNullOrWhiteSpace(SourceActor.JapaneseNameKana))
                                {
                                    <div class="actor-card-sub text-truncate">
                                        @SourceActor.JapaneseNameKanji @SourceActor.JapaneseNameKana
                                    </div>
                                }
                                <div class="actor-card-meta">
                                    <span class="badge bg-danger">Duplicate source</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-muted small text-uppercase fw-semibold mb-1">Target (Canonical)</label>
                        @if (selectedTarget is not null)
                        {
                            <div class="actor-card target-card">
                                @if (selectedTarget.HasImage)
                                {
                                    <div class="actor-card-avatar actor-card-avatar-photo">
                                        <img src="@($"/actor-image/{selectedTarget.Id}/thumb")" alt="@selectedTarget.DisplayName" />
                                    </div>
                                }
                                else
                                {
                                    <div class="actor-card-avatar avatar-target">@ActorMatching.Initials(selectedTarget.DisplayName)</div>
                                }
                                <div class="actor-card-info">
                                    <div class="actor-card-name text-truncate">@selectedTarget.DisplayName</div>
                                    @if (!string.IsNullOrWhiteSpace(selectedTarget.JapaneseNameKanji) || !string.IsNullOrWhiteSpace(selectedTarget.JapaneseNameKana))
                                    {
                                        <div class="actor-card-sub text-truncate">
                                            @selectedTarget.JapaneseNameKanji @selectedTarget.JapaneseNameKana
                                        </div>
                                    }
                                    <div class="actor-card-meta">
                                        <span class="badge bg-success">Canonical target</span>
                                        <span class="text-muted small ms-2">@selectedTarget.MovieCount movie@(selectedTarget.MovieCount == 1 ? "" : "s")</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="actor-card target-card-placeholder">
                                <span class="text-muted">Select an actor from the list below</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label fw-semibold mb-1">Select Target Actor</label>
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-dark border-secondary text-muted">
                            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
                        </span>
                        <input type="text"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Filter actors by name, kanji, kana..."
                               value="@searchQuery"
                               @oninput="OnSearchInput"
                               disabled="@isMerging" />
                    </div>

                    <div class="candidate-list">
                        @if (isSearching)
                        {
                            <div class="p-3 text-center"><LoadingIndicator /></div>
                        }
                        else if (candidates.Count == 0)
                        {
                            <div class="p-3 text-center text-muted">No candidate actors found.</div>
                        }
                        else
                        {
                            @foreach (var candidate in candidates)
                            {
                                var isSelected = selectedTarget?.Id == candidate.Id;
                                <div class="candidate-item @(isSelected ? "selected" : "")"
                                     @onclick="() => SelectTarget(candidate)">
                                    @if (candidate.HasImage)
                                    {
                                        <div class="candidate-avatar candidate-avatar-photo">
                                            <img src="@($"/actor-image/{candidate.Id}/thumb")" alt="@candidate.DisplayName" loading="lazy" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="candidate-avatar">@ActorMatching.Initials(candidate.DisplayName)</div>
                                    }
                                    <div class="candidate-info">
                                        <div class="candidate-name">
                                            @candidate.DisplayName
                                            @if (candidate.IsSuggested)
                                            {
                                                <span class="badge bg-primary ms-2">Suggested</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(candidate.JapaneseNameKanji) || !string.IsNullOrWhiteSpace(candidate.JapaneseNameKana))
                                        {
                                            <div class="candidate-japanese">
                                                @candidate.JapaneseNameKanji @candidate.JapaneseNameKana
                                            </div>
                                        }
                                    </div>
                                    <div class="candidate-meta text-muted small">
                                        @candidate.MovieCount movie@(candidate.MovieCount == 1 ? "" : "s")
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                @if (selectedTarget is not null)
                {
                    <div class="merge-preview-summary mt-3">
                        <h6 class="fw-semibold text-light mb-2">Merge Summary</h6>
                        <ul class="list-unstyled mb-0 small text-muted">
                            <li><span class="text-success me-1">✓</span> <strong>@SourceActor.DisplayName</strong> will be registered as an alias on <strong>@selectedTarget.DisplayName</strong>.</li>
                            <li><span class="text-success me-1">✓</span> Associated movies from @SourceActor.DisplayName will be transferred to @selectedTarget.DisplayName.</li>
                            <li><span class="text-success me-1">✓</span> Missing Japanese names, external IDs, and photos will be merged.</li>
                            <li><span class="text-danger me-1">✕</span> Duplicate actor record #@SourceActor.Id will be deleted.</li>
                        </ul>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="updateNfoCheckbox" @bind="updateNfoOnDisk" disabled="@isMerging" />
                            <label class="form-check-label text-light small" for="updateNfoCheckbox">Update actor name in linked movie .nfo files on disk</label>
                        </div>
                    </div>
                }
            </div>

            <div class="merge-modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseAsync" disabled="@isMerging">Cancel</button>
                <button type="button"
                        class="btn btn-danger"
                        @onclick="ConfirmMergeAsync"
                        disabled="@(selectedTarget is null || isMerging)">
                    @(isMerging ? "Merging…" : $"Merge into {selectedTarget?.DisplayName ?? "Target"}")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Show { get; set; }

    [Parameter]
    public Actor? SourceActor { get; set; }

    [Parameter]
    public bool? SourceHasImage { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Actor> OnMerged { get; set; }

    private string searchQuery = "";
    private IReadOnlyList<ActorMergeCandidate> candidates = [];
    private ActorMergeCandidate? selectedTarget;
    private bool isSearching;
    private bool isMerging;
    private string? errorMessage;
    private int? loadedForActorId;
    private bool sourceHasImage;
    private bool updateNfoOnDisk = true;

    protected override async Task OnParametersSetAsync()
    {
        if (Show && SourceActor is not null && loadedForActorId != SourceActor.Id)
        {
            loadedForActorId = SourceActor.Id;
            searchQuery = "";
            selectedTarget = null;
            errorMessage = null;
            updateNfoOnDisk = true;

            if (SourceHasImage is true)
            {
                sourceHasImage = true;
            }
            else
            {
                sourceHasImage = await ActorService.HasImageAsync(SourceActor.Id);
            }

            await LoadCandidatesAsync();
        }
        else if (Show && SourceActor is not null && SourceHasImage.HasValue && sourceHasImage != SourceHasImage.Value)
        {
            sourceHasImage = SourceHasImage.Value;
        }
        else if (!Show)
        {
            loadedForActorId = null;
        }
    }

    private async Task LoadCandidatesAsync()
    {
        if (SourceActor is null) return;
        isSearching = true;
        candidates = await ActorService.GetMergeCandidatesAsync(SourceActor.Id, searchQuery);
        if (selectedTarget is null && candidates.Count > 0 && candidates[0].IsSuggested)
        {
            selectedTarget = candidates[0];
        }
        isSearching = false;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        await LoadCandidatesAsync();
    }

    private void SelectTarget(ActorMergeCandidate candidate)
    {
        if (isMerging) return;
        selectedTarget = candidate;
    }

    private async Task ConfirmMergeAsync()
    {
        if (SourceActor is null || selectedTarget is null || isMerging) return;

        isMerging = true;
        errorMessage = null;

        var result = await ActorService.MergeAsync(SourceActor.Id, selectedTarget.Id, updateNfoOnDisk);
        isMerging = false;

        if (!result.Success || result.Actor is null)
        {
            errorMessage = result.ErrorMessage ?? "Failed to merge actor.";
            return;
        }

        await OnMerged.InvokeAsync(result.Actor);
    }

    private async Task CloseAsync()
    {
        if (isMerging) return;
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }
}
