<RangeFilterRows Rows="Rows" Selection="Selection" SelectionChanged="SelectionChanged" />

@code {
    /// <summary>The Movies filter's release year / runtime / bitrate / file size range sliders, each its own top-level
    /// entry of the Filter menu and shown only when the movies span a range, or with <see cref="Cast"/> just
    /// the cast size one (it sits under "Actor"). Like <see cref="MovieCountFilters"/>: Selection is the applied one, and
    /// edits are raised as a modified copy through SelectionChanged.</summary>
    [Parameter, EditorRequired] public MovieRangeOptions Options { get; set; } = MovieRangeOptions.None;
    [Parameter, EditorRequired] public MovieRangeSelection Selection { get; set; } = MovieRangeSelection.Empty;
    [Parameter] public EventCallback<MovieRangeSelection> SelectionChanged { get; set; }
    [Parameter] public bool Cast { get; set; }

    private IEnumerable<RangeRow<MovieRangeSelection>> Rows => Cast
        ? [new("Cast size", "", Options.CastSize, Selection.CastSize, (s, r) => s with { CastSize = r })]
        :
        [
            new("Release year", "", Options.ReleaseYear, Selection.ReleaseYear, (s, r) => s with { ReleaseYear = r }),
            new("Runtime", "min", Options.RuntimeMinutes, Selection.RuntimeMinutes, (s, r) => s with { RuntimeMinutes = r }),
            new("Bitrate", "Mbps", Options.BitrateMbps, Selection.BitrateMbps, (s, r) => s with { BitrateMbps = r }),
            new("File size", "GB", Options.FileSizeGb, Selection.FileSizeGb, (s, r) => s with { FileSizeGb = r }),
        ];
}
