@* One section of Movie Detail's (always dark) body: a bold heading over a rule, an optional small
   action button beside it, then the section's content. Cast, Genres, Images and Scenes use it. *@
<div class="detail-section @Class" @ref="Element">
    <div class="detail-section-header">
        <h2>@Title</h2>
        @if (ActionText is not null)
        {
            <button type="button" class="detail-section-btn @ActionClass" @onclick="OnAction" title="@ActionTitle">@ActionText</button>
        }
    </div>
    @ChildContent
</div>

@code {
    /// <summary>The root element, for a host that hands it to JS.</summary>
    public ElementReference Element { get; private set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Label of the button beside the heading; no button when null.</summary>
    [Parameter] public string? ActionText { get; set; }

    [Parameter] public string? ActionTitle { get; set; }

    [Parameter] public EventCallback OnAction { get; set; }

    /// <summary>Extra class on the action button, for the host's tests to select.</summary>
    [Parameter] public string? ActionClass { get; set; }

    /// <summary>Extra class on the section's root element.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
