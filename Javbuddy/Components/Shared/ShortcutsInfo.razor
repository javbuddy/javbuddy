@* An info icon that lists keyboard shortcuts while hovered or focused. Pure CSS: the
   popover shows on :hover / :focus-within, and the button does nothing when clicked. Dark by
   default (the players), restyled per host via --shortcuts-info-* custom properties. *@
<span class="shortcuts-info @(Above ? "shortcuts-info-above" : null) @(AlignStart ? "shortcuts-info-start" : null)">
    <button type="button" class="shortcuts-info-btn" aria-label="Keyboard shortcuts" aria-describedby="@popoverId">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
        </svg>
    </button>
    <div class="shortcuts-info-popover" id="@popoverId" role="tooltip">
        <div class="shortcuts-info-heading">Keyboard shortcuts</div>
        <dl class="shortcuts-info-list">
            @foreach (var shortcut in Shortcuts)
            {
                <dt class="shortcuts-info-keys">
                    @for (var i = 0; i < shortcut.Keys.Count; i++)
                    {
                        @if (i > 0)
                        {
                            <span class="shortcuts-info-or">/</span>
                        }
                        <kbd>@shortcut.Keys[i]</kbd>
                    }
                </dt>
                <dd class="shortcuts-info-action">@shortcut.Action</dd>
            }
        </dl>
    </div>
</span>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<KeyboardShortcut> Shortcuts { get; set; } = [];

    /// <summary>Opens the popover above the icon instead of below it.</summary>
    [Parameter] public bool Above { get; set; }

    /// <summary>Lines the popover up with the icon's left edge instead of its right edge.</summary>
    [Parameter] public bool AlignStart { get; set; }

    private readonly string popoverId = "shortcuts-info-" + Guid.NewGuid().ToString("N");
}
