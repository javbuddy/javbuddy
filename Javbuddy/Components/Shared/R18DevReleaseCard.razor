@using Javbuddy.Services.R18Dev

<div class="missing-poster-card">
    <PosterCard Href="@Release.LinkUrl"
                StatusCssClass="@($"status-{Release.StatusClass}")"
                ImageUrl="@Release.Movie.PosterUrl"
                Loading="PosterImageLoading.NativeLazy"
                AltText="@Release.Movie.DisplayTitle"
                PlaceholderText="@Release.Movie.DvdId"
                TitleText="@Release.Movie.DvdId"
                TitleTooltip="@Release.Movie.DisplayTitle"
                MetaLine="@Release.StatusLabel" />
    @if (!Release.InLibrary)
    {
        @if (OnAdd.HasDelegate)
        {
            <button class="missing-poster-action missing-poster-add" type="button" title="Add to library" aria-label="Add @Release.Movie.DvdId to library" disabled="@AddInProgress" @onclick="() => OnAdd.InvokeAsync(Release.Movie.DvdId)">
                <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><line x1="8" y1="2.5" x2="8" y2="13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><line x1="2.5" y1="8" x2="13.5" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            </button>
        }
        <button class="missing-poster-action missing-poster-search" type="button" title="Search Prowlarr" aria-label="Search Prowlarr for @Release.Movie.DvdId" @onclick="() => OnSearch.InvokeAsync(Release.Movie.DvdId)">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="6.5" cy="6.5" r="5" fill="none" stroke="currentColor" stroke-width="1.3" /><line x1="10.3" y1="10.3" x2="14.5" y2="14.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
        </button>
    }
</div>

@code {
    /// <summary>The release to show. Its status decides the poster color and whether the quick
    /// actions (Prowlarr search, add) appear — only releases not yet in the library get them.</summary>
    [Parameter, EditorRequired] public R18DevReleaseRow Release { get; set; } = null!;

    /// <summary>Raised with the release's code when the Prowlarr-search button is clicked.</summary>
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    /// <summary>Raised with the release's code when the add button is clicked. The button is only
    /// rendered when a handler is supplied.</summary>
    [Parameter] public EventCallback<string> OnAdd { get; set; }

    /// <summary>Disables the add button while the parent's add call for this card is running.</summary>
    [Parameter] public bool AddInProgress { get; set; }
}
