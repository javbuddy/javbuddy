@using Javbuddy.Services.Trickplay
@inject IJSRuntime JS
@implements IAsyncDisposable

@* The clip player's own controls, in place of the browser's, which always show the
   whole file: the track and the time readout run from the clip's start (0:00) to its end. At the end
   the clip closes (OnEnded), or with Loop on, restarts. In a playlist it also offers
   Previous and Next (P / N). Playback, seeking, the readout, volume, fullscreen and those buttons run
   in ClipControls.razor.js; only Loop lives here, remembered by the module in this browser's
   localStorage. A scene's highlights are drawn above the track, cut to the clip. *@
<div class="clip-controls" @ref="root">
    @if (Playlist)
    {
        <button type="button" class="clip-controls-btn clip-controls-prev" aria-label="Previous clip" title="Previous clip (P); restarts this one when you're more than 3 s in">
            <PlayerIcon Name="PlayerIconName.Previous" />
        </button>
    }
    <button type="button" class="clip-controls-btn clip-controls-play" aria-label="Play or pause" title="Play/pause (space)">
        <PlayerIcon Name="PlayerIconName.Play" Class="clip-controls-icon-play" />
        <PlayerIcon Name="PlayerIconName.Pause" Class="clip-controls-icon-pause" />
    </button>
    @if (Playlist)
    {
        <button type="button" class="clip-controls-btn clip-controls-next" aria-label="Next clip" title="Next clip (N)">
            <PlayerIcon Name="PlayerIconName.Next" />
        </button>
    }
    <div class="clip-controls-track-wrap" aria-hidden="true" title="Click to jump to that point">
        <div class="clip-controls-preview">
            <div class="clip-controls-thumb"></div>
            @if (Generating is not null)
            {
                <TrickplayGeneratingPreview Generating="Generating" />
            }
            <span class="clip-controls-preview-time"></span>
        </div>
        <ApexMarkers Apexes="clipApexes" DurationSeconds="HighlightsLengthSeconds" />
        <HighlightSegments Highlights="clipHighlights" DurationSeconds="HighlightsLengthSeconds" />
        <div class="clip-controls-track">
            <div class="clip-controls-progress"></div>
        </div>
    </div>
    <span class="clip-controls-time"></span>
    @ExtraControls
    <div class="clip-controls-volume-group">
        <button type="button" class="clip-controls-btn clip-controls-mute" aria-label="Mute or unmute" title="Mute/unmute">
            <PlayerIcon Name="PlayerIconName.Sound" Class="clip-controls-icon-sound" />
            <PlayerIcon Name="PlayerIconName.Muted" Class="clip-controls-icon-muted" />
        </button>
        <div class="clip-controls-volume-popup">
            <input type="range" class="clip-controls-volume" min="0" max="1" step="0.05" value="1" aria-label="Volume" title="Volume" />
        </div>
    </div>
    <button type="button"
            class="clip-controls-btn clip-controls-loop @(loop ? "clip-controls-loop-on" : null)"
            aria-pressed="@(loop ? "true" : "false")"
            aria-label="Loop"
            title="Loop: restart the clip at its end instead of closing the player"
            @onclick="ToggleLoopAsync">
        <PlayerIcon Name="PlayerIconName.Loop" />
    </button>
    <button type="button" class="clip-controls-btn clip-controls-fullscreen" aria-label="Toggle fullscreen" title="Toggle fullscreen (f, double-click video)">
        <PlayerIcon Name="PlayerIconName.FullscreenEnter" Class="clip-controls-fs-icon-enter" />
        <PlayerIcon Name="PlayerIconName.FullscreenExit" Class="clip-controls-fs-icon-exit" />
    </button>
</div>

@code {
    /// <summary>CSS selector of the clip player's <c>&lt;video&gt;</c>.</summary>
    [Parameter, EditorRequired] public string VideoSelector { get; set; } = default!;

    /// <summary>Where the clip starts in the video: 0:00 on the track.</summary>
    [Parameter] public double StartSeconds { get; set; }

    /// <summary>Where the clip ends; the end of the video when null.</summary>
    [Parameter] public double? EndSeconds { get; set; }

    /// <summary>The movie's highlights, in start order; those the clip overlaps are
    /// drawn above the track, and clicking one jumps to its start.</summary>
    [Parameter] public IReadOnlyList<Javbuddy.Services.Scenes.HighlightItem>? Highlights { get; set; }

    /// <summary>The movie's apexes; those inside the clip are marked above the track.</summary>
    [Parameter] public IReadOnlyList<Javbuddy.Services.Scenes.ApexItem>? Apexes { get; set; }

    /// <summary>The movie's length: where a clip without EndSeconds ends, for placing highlights.</summary>
    [Parameter] public double? MovieDurationSeconds { get; set; }

    /// <summary>Thumbnails for the track's hover preview; none until (or unless) it loads.</summary>
    [Parameter] public TrickplayLayout? Trickplay { get; set; }

    /// <summary>Set while the trickplay the preview would use is being generated; the
    /// preview shows that instead, so Trickplay should be null meanwhile.</summary>
    [Parameter] public TrickplayGenerating? Generating { get; set; }

    /// <summary>The clip played to its end with Loop off.</summary>
    [Parameter] public EventCallback OnEnded { get; set; }

    /// <summary>Set in a playlist: offers Next and Previous, and the N / P keys.</summary>
    [Parameter] public EventCallback OnNext { get; set; }

    [Parameter] public EventCallback OnPrevious { get; set; }

    /// <summary>Identifies the clip: another clip re-inits the controls even when its range and
    /// place match the previous one's (two single-scene movies in a row both run 0 → end).</summary>
    [Parameter] public string? ClipKey { get; set; }

    /// <summary>False while the player still shows the previous clip's video (another movie's stream
    /// is loading): another clip's range is only applied once its video is there.</summary>
    [Parameter] public bool StreamReady { get; set; } = true;

    /// <summary>Whether Previous can go back a clip; otherwise it restarts this one.</summary>
    [Parameter] public bool HasPrevious { get; set; }

    /// <summary>Extra controls the player column hands down (its CC button), shown just before the mute button like the
    /// scrub bar's.</summary>
    [CascadingParameter(Name = "PlayerExtraControls")] public RenderFragment? ExtraControls { get; set; }

    /// <summary>What the module needs to run the controls, serialized camelCase.</summary>
    public sealed record ClipRange(string VideoSelector, double StartSeconds, double? EndSeconds, TrickplayLayout? Trickplay, bool Playlist, bool HasPrevious);

    private bool Playlist => OnNext.HasDelegate;

    private ElementReference root;
    private IJSObjectReference? jsModule;
    private DotNetObjectReference<ClipControls>? selfRef;
    private TrickplayLayout? sentTrickplay;
    private ClipRange? sentRange;
    private string? sentKey;
    private bool loop;
    private IReadOnlyList<Javbuddy.Services.Scenes.HighlightItem>? clipHighlights;
    private IReadOnlyList<Javbuddy.Services.Scenes.ApexItem>? clipApexes;

    private double? HighlightsLengthSeconds => (EndSeconds ?? MovieDurationSeconds) - StartSeconds;

    private ClipRange Range => new(VideoSelector, StartSeconds, EndSeconds, Trickplay, Playlist, HasPrevious);

    protected override void OnParametersSet()
    {
        clipHighlights = Highlights is { Count: > 0 } && HighlightsLengthSeconds is > 0
            ? Javbuddy.Services.Scenes.HighlightRanges.WithinClip(Highlights, StartSeconds, StartSeconds + HighlightsLengthSeconds.Value)
            : null;
        clipApexes = Apexes is { Count: > 0 } && HighlightsLengthSeconds is > 0
            ? Javbuddy.Services.Scenes.ApexRanges.WithinClip(Apexes, StartSeconds, StartSeconds + HighlightsLengthSeconds.Value)
            : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ClipControls.razor.js");
                selfRef = DotNetObjectReference.Create(this);
                await InitAsync();
                StateHasChanged();
            }
            else if (jsModule is not null && StreamReady && (ClipKey != sentKey || Range with { Trickplay = sentTrickplay } != sentRange))
            {
                // Another clip in the same player (a playlist's next one): start over on its range.
                await InitAsync();
            }
            else if (jsModule is not null && Trickplay != sentTrickplay)
            {
                sentTrickplay = Trickplay;
                await jsModule.InvokeVoidAsync("setTrickplay", root, Trickplay);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task InitAsync()
    {
        sentTrickplay = Trickplay;
        sentRange = Range;
        sentKey = ClipKey;
        try
        {
            loop = await jsModule!.InvokeAsync<bool>("init", root, selfRef, sentRange);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ToggleLoopAsync()
    {
        loop = !loop;
        if (jsModule is null) return;

        try
        {
            await jsModule.InvokeVoidAsync("setLoop", root, loop);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public Task ClipEndedAsync() => OnEnded.InvokeAsync();

    [JSInvokable]
    public Task NextAsync() => OnNext.InvokeAsync();

    [JSInvokable]
    public Task PreviousAsync() => OnPrevious.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (jsModule is not null)
        {
            try
            {
                await jsModule.InvokeVoidAsync("dispose", root);
                await jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        selfRef?.Dispose();
    }
}
