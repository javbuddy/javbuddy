@* Modal delete confirmation (a ModalShell), shared by the scene editor, the highlight editor and the pages' deletes.
   Render it only while a delete is pending. Esc and backdrop clicks cancel and stop here, so they don't also
   close a player modal around it; Cancel is focused on open so Esc works without a click first. The Review
   shortcut and seek-key guards look for .delete-confirm-backdrop. *@
<ModalShell Title="@(Title ?? $"Delete \"{ItemName}\"?")" MaxWidth="26rem" Busy="Busy" OnClose="OnCancel" Themed="Themed" ZIndex="1060" StopPropagation="true" BackdropClass="delete-confirm-backdrop">
    <ChildContent>
        @if (Message is not null)
        {
            <p class="delete-confirm-message">@Message</p>
        }
        @ChildContent
    </ChildContent>
    <FooterContent>
        <button type="button" class="delete-confirm-btn delete-confirm-cancel-btn" @ref="cancelButton" @onclick="CancelAsync" disabled="@Busy">Cancel</button>
        <button type="button" class="delete-confirm-btn delete-confirm-confirm-btn" @onclick="OnConfirm" disabled="@Busy">@ConfirmText</button>
    </FooterContent>
</ModalShell>

@code {
    /// <summary>What's being deleted, shown as <c>Delete "ItemName"?</c></summary>
    [Parameter] public string? ItemName { get; set; }

    /// <summary>The whole title, in place of <c>Delete "ItemName"?</c>.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Follow the light/dark theme (white panel in the light theme) instead of always dark; the buttons and message
    /// then take their colours from the --scene-editor-* custom properties a host wrapper sets (Actor Detail).</summary>
    [Parameter] public bool Themed { get; set; }

    /// <summary>The confirm button's label.</summary>
    [Parameter] public string ConfirmText { get; set; } = "Delete";

    /// <summary>Optional line under the title, e.g. what else gets deleted.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Optional extra content between the message and the buttons, e.g. Movie Detail's
    /// "Delete files from disk" toggle and file list.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Disables both buttons (and cancelling) while the delete runs.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private ElementReference cancelButton;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await cancelButton.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task CancelAsync() => Busy ? Task.CompletedTask : OnCancel.InvokeAsync();
}
