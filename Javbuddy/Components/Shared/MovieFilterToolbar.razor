@using Javbuddy.Components.Pages.MoviesSections
@using Javbuddy.Models
@implements IDisposable
@inject TimeProvider TimeProvider

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    @if (!ReleasesBrowseMode && ShowStatusFilter)
    {
        <StatusFilterButtonGroup Options="@StatusFilterOptions" />
    }

    <input type="search"
           class="form-control form-control-sm w-auto"
           style="min-width: 220px;"
           placeholder="@SearchPlaceholder"
           value="@localTextFilter"
           @oninput="HandleTextInput" />

    @* One backdrop for both menus, before their wrappers (see the dropdown convention in docs/ui-guidelines.md). *@
    @if (showFilterDropdown || showSortDropdown)
    {
        <div class="dropdown-backdrop" @onclick="CloseDropdowns"></div>
    }
    <div class="sort-dropdown-wrapper">
        <DropdownMenuButton Label="@($"Filter{(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : "")}")"
                            Active="ActiveFilterCount > 0"
                            ShowClear="HasActiveFilters"
                            OnClear="HandleResetFilters"
                            ClearTitle="Reset all filters"
                            ClearAriaLabel="Reset all filters"
                            ShowMenu="showFilterDropdown"
                            OnToggle="ToggleFilterDropdown"
                            OnClose="CloseDropdowns">
            @if (!ReleasesBrowseMode)
            {
                @if (Choices.LibraryNames.Count > 0)
                {
                    <MultiSelectFilterGroup GroupLabel="Library" Options="@LibraryFilterOptions" />
                }
                <MultiSelectFilterGroup GroupLabel="Resolution" Options="@ResolutionFilterOptions" />
                <MultiSelectFilterGroup GroupLabel="Scan Type" Options="@ScanTypeFilterOptions" />
                <MultiSelectFilterGroup GroupLabel="Content Type" Options="@ContentTypeFilterOptions" Excludable="@(Excludable && ExcludableContentTypes)" />
                @if (Choices.Codecs.Count > 0)
                {
                    <MultiSelectFilterGroup GroupLabel="Codec" Options="@CodecFilterOptions" />
                }
            }
            @if (ReleasesBrowseMode)
            {
                <DropdownToggleItem Label="Hide previously deleted" Active="@(HidePreviouslyDeleted)" Pressed="@(HidePreviouslyDeleted)" OnClick="OnToggleHidePreviouslyDeleted" />
            }
            @if (Choices.Studios.Count > 0)
            {
                <MultiSelectFilterGroup GroupLabel="Studio" Options="@StudioFilterOptions" Searchable="true"
                                         Excludable="@(Excludable && !ReleasesBrowseMode)"
                                         OnSelectAll="SelectAllStudios"
                                         OnSelectNone="SelectNoStudios" />
            }
            @if (ReleasesBrowseMode)
            {
                @ReleasesFilterContent
            }
            else
            {
                @if (Choices.Genres.Count > 0)
                {
                    <MultiSelectFilterGroup GroupLabel="Genre" Options="@GenreFilterOptions" Searchable="true"
                                             Excludable="Excludable"
                                             OnSelectAll="SelectAllGenres"
                                             OnSelectNone="SelectNoGenres"
                                             MatchAll="State.MatchAllGenres" OnMatchAllChanged="MatchAllGenresChanged" />
                }
                <FilterSection Label="Features" ActiveCount="@(State.Features.Count + State.NfoDriftKinds.Count)">
                    <MultiSelectFilterGroup GroupLabel="Features" Options="@FeatureFilterOptions" AlwaysExpanded="true" />
                    <MultiSelectFilterGroup GroupLabel="NFO drift" Options="@NfoDriftFilterOptions" />
                </FilterSection>
                @if (Choices.Counts.HasAny)
                {
                    <FilterSection Label="Clips" ActiveCount="@State.Counts.Count">
                        <MovieCountFilters Options="Choices.Counts" Selection="State.Counts" SelectionChanged="OnCountsChanged" />
                    </FilterSection>
                }
                <MovieRangeFilters Options="Choices.Ranges" Selection="State.Ranges" SelectionChanged="OnRangesChanged" />
                @if (Choices.Actors.Count > 0 || Choices.ActorTags.Count > 0 || (ShowActorAttributes && Choices.ActorAttributes.HasAny) || Choices.Ranges.CastSize is not null)
                {
                    <FilterSection Label="Actor" ActiveCount="@(State.ActorIds.Count + State.ExcludedActorIds.Count + State.ActorTagIds.Count + State.ExcludedActorTagIds.Count + (ShowActorAttributes ? State.ActorAttributes.Count : 0) + (State.Ranges.CastSize.IsSet ? 1 : 0))">
                        @if (Choices.Actors.Count > 0)
                        {
                            <MultiSelectFilterGroup GroupLabel="Name" Options="@ActorFilterOptions" Searchable="true"
                                                     Excludable="Excludable"
                                                     OnSelectAll="SelectAllActors"
                                                     OnSelectNone="SelectNoActors" />
                        }
                        @if (Choices.ActorTags.Count > 0)
                        {
                            @* With Name selected, it is those actors who must have the tag. *@
                            <MultiSelectFilterGroup GroupLabel="Actor tag" Options="@ActorTagFilterOptions" Searchable="true"
                                                     Excludable="Excludable"
                                                     OnSelectAll="SelectAllActorTags"
                                                     OnSelectNone="SelectNoActorTags"
                                                     MatchAll="State.MatchAllActorTags" OnMatchAllChanged="MatchAllActorTagsChanged" />
                        }
                        @if (ShowActorAttributes && Choices.ActorAttributes.HasAny)
                        {
                            <ActorAttributeFilters Options="Choices.ActorAttributes" Selection="State.ActorAttributes" SelectionChanged="OnActorAttributesChanged" />
                        }
                        <MovieRangeFilters Options="Choices.Ranges" Selection="State.Ranges" SelectionChanged="OnRangesChanged" Cast="true" />
                    </FilterSection>
                }
            }
        </DropdownMenuButton>
    </div>

    @if (!ReleasesBrowseMode)
    {
        <div class="sort-dropdown-wrapper">
            <DropdownMenuButton Label="@($"Sort: {MovieFilterOptions.SortFieldLabel(State.SortField)}")"
                                Arrow="@(State.SortField == "random" ? "" : (State.SortDescending ? "▼" : "▲"))"
                                ShowMenu="showSortDropdown"
                                OnToggle="ToggleSortDropdown"
                                OnClose="CloseDropdowns">
                @foreach (var field in MovieFilterOptions.SortFields)
                {
                    <button type="button" class="sort-dropdown-item @(State.SortField == field ? "active" : "")" @onclick="() => SelectSort(field)">
                        @MovieFilterOptions.SortFieldLabel(field)
                        @if (State.SortField == field && field != "random")
                        {
                            <span class="sort-dropdown-arrow">@(State.SortDescending ? "▼" : "▲")</span>
                        }
                    </button>
                }
            </DropdownMenuButton>
        </div>
    }

    @ChildContent
</div>

@code {

    /// <summary>The selected filters and sort order. The toolbar edits it in place, then raises <see cref="OnChanged"/>
    /// so the host can reload, mark its view stale or save it; the host never mirrors a click into it by hand.</summary>
    [Parameter, EditorRequired] public MovieGridFilterState State { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>What there is to pick from; a group with nothing offered is hidden.</summary>
    [Parameter] public MovieFilterChoices Choices { get; set; } = MovieFilterChoices.None;

    /// <summary>How many movies are in each status under the other active filters, for the All / Missing / Got buttons.</summary>
    [Parameter] public MovieStatusCounts StatusCounts { get; set; } = new(0, 0, 0);
    /// <summary>Off hides the All/Missing/Got buttons, for a host that only ever lists one status
    /// (the DeoVR group editor lists Got movies only).</summary>
    [Parameter] public bool ShowStatusFilter { get; set; } = true;

    [Parameter] public string SearchPlaceholder { get; set; } = "Filter by code or title…";

    /// <summary>Turns the Studio, Genre, actor Name and Actor tag groups (and Content Type, unless
    /// <see cref="ExcludableContentTypes"/> is off) into include/exclude ones: a click steps a value through neither,
    /// included, excluded (SetExtensions.CycleInclusion), and the state's Excluded* sets are what it excludes. Not for
    /// Studio while <see cref="ReleasesBrowseMode"/> is on, which the r18.dev catalog can't exclude by.</summary>
    [Parameter] public bool Excludable { get; set; }
    /// <summary>False keeps Content Type include-only even when <see cref="Excludable"/> is on (a DeoVR group's filter has
    /// no excluded content types).</summary>
    [Parameter] public bool ExcludableContentTypes { get; set; } = true;

    /// <summary>Shows the "Match all" checkbox of the Genre and Actor tag groups (the state's MatchAll* flags), which a
    /// host that can't match all values leaves off.</summary>
    [Parameter] public bool ShowMatchAll { get; set; }

    /// <summary>The Actress Attributes filters (cup size, height, measurements, age) of the linked cast. Opt-in: Actor
    /// Detail embeds this toolbar too, where an actor's own attributes never vary.</summary>
    [Parameter] public bool ShowActorAttributes { get; set; }

    /// <summary>The host's Filter button reset: clears the state and whatever else the host keeps beside it. The toolbar
    /// cancels its pending search text first and closes the menu.</summary>
    [Parameter] public EventCallback OnResetFilters { get; set; }

    /// <summary>True while the Movies page is browsing r18.dev releases instead of the local
    /// library: hides the controls that only filter/sort local movies (status, library,
    /// resolution, scan type, codec, genre, features, sort) so nothing on screen silently does
    /// nothing. The search box and Studio filter stay — they define what's being browsed — joined by
    /// <see cref="ReleasesFilterContent"/>.</summary>
    [Parameter] public bool ReleasesBrowseMode { get; set; }

    /// <summary>The r18.dev catalog's own filters, shown under Studio in the Filter menu
    /// while <see cref="ReleasesBrowseMode"/> is on; <see cref="ReleasesActiveFilterCount"/> is how many of
    /// them are set.</summary>
    [Parameter] public RenderFragment? ReleasesFilterContent { get; set; }
    [Parameter] public int ReleasesActiveFilterCount { get; set; }

    /// <summary>The releases browse's "Hide previously deleted" filter, shown only in
    /// <see cref="ReleasesBrowseMode"/>. On by default, so it counts as an active filter like
    /// the actor Missing page's default-on filters.</summary>
    [Parameter] public bool HidePreviouslyDeleted { get; set; }
    [Parameter] public EventCallback OnToggleHidePreviouslyDeleted { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool showFilterDropdown;
    private bool showSortDropdown;
    private string localTextFilter = "";
    private Debouncer? textFilterDebouncer;

    private string? lastSyncedTextFilter;

    protected override void OnParametersSet()
    {
        if (State.Text != lastSyncedTextFilter)
        {
            textFilterDebouncer?.Cancel();
            localTextFilter = State.Text;
            lastSyncedTextFilter = State.Text;
        }
    }

    private int ActiveFilterCount => ReleasesBrowseMode
        ? State.Studios.Count + (HidePreviouslyDeleted ? 1 : 0) + ReleasesActiveFilterCount
        : (string.IsNullOrEmpty(State.Library) ? 0 : 1)
            + State.Resolutions.Count
            + State.ScanTypes.Count
            + State.ContentTypes.Count
            + State.ExcludedContentTypes.Count
            + State.NfoDriftKinds.Count
            + State.Codecs.Count
            + State.Studios.Count
            + State.ExcludedStudios.Count
            + State.Genres.Count
            + State.ExcludedGenres.Count
            + State.Features.Count
            + State.Counts.Count
            + State.Ranges.Count
            + State.ActorIds.Count
            + State.ExcludedActorIds.Count
            + State.ActorTagIds.Count
            + State.ExcludedActorTagIds.Count
            + (ShowActorAttributes ? State.ActorAttributes.Count : 0);

    // The catalog's own filters count too while browsing it (its default-on "Hide previously deleted" doesn't).
    private bool HasActiveFilters => State.HasActiveFilters || (ReleasesBrowseMode && ReleasesActiveFilterCount > 0);

    // Applies an edit to the state, then tells the host. A lone selection can't be "match all", so that is dropped here.
    private Task ChangeAsync(Action change)
    {
        change();
        State.DropLoneMatchAll();
        return OnChanged.InvokeAsync();
    }

    // Steps a value through neither, included, excluded when the group is excludable; a plain toggle otherwise.
    private Task FlipAsync<T>(HashSet<T> included, HashSet<T> excluded, T value, bool excludable) =>
        ChangeAsync(() =>
        {
            if (excludable) included.CycleInclusion(excluded, value);
            else included.Toggle(value);
        });

    private IReadOnlyList<FilterButtonOption> StatusFilterOptions =>
    [
        new($"All ({StatusCounts.TotalCount})", State.Status is null, EventCallback.Factory.Create(this, () => ChangeAsync(() => State.Status = null))),
        new($"Missing ({StatusCounts.MissingCount})", State.Status == MovieStatus.Missing, EventCallback.Factory.Create(this, () => ChangeAsync(() => State.Status = MovieStatus.Missing))),
        new($"Got ({StatusCounts.GotCount})", State.Status == MovieStatus.Got, EventCallback.Factory.Create(this, () => ChangeAsync(() => State.Status = MovieStatus.Got))),
    ];

    private async Task HandleTextInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        localTextFilter = val;

        textFilterDebouncer ??= new Debouncer(TimeProvider);
        await textFilterDebouncer.RunAsync(_ =>
        {
            lastSyncedTextFilter = val;
            return ChangeAsync(() =>
            {
                State.Text = val;
                // A prefix badge is a one-shot navigation aid. Once the user edits the search box, return
                // to its advertised code-or-title search behavior instead of retaining the hidden
                // code-only predicate from that navigation.
                State.CodePrefix = null;
            });
        });
    }

    private void ToggleFilterDropdown()
    {
        showFilterDropdown = !showFilterDropdown;
        showSortDropdown = false;
    }

    private void CloseDropdowns()
    {
        showFilterDropdown = false;
        showSortDropdown = false;
    }

    private void ToggleSortDropdown()
    {
        showSortDropdown = !showSortDropdown;
        showFilterDropdown = false;
    }

    private Task SelectSort(string field)
    {
        showSortDropdown = false;
        return ChangeAsync(() =>
        {
            if (field == "random")
            {
                // A fresh seed on every pick: the order stays fixed only until Random is chosen again.
                State.SortField = field;
                State.RandomSortSeed = Random.Shared.Next(1, int.MaxValue);
            }
            else if (State.SortField == field)
            {
                State.SortDescending = !State.SortDescending;
            }
            else
            {
                State.SortField = field;
                State.SortDescending = MovieFilterOptions.DefaultSortDescending(field);
            }
        });
    }

    private async Task HandleResetFilters()
    {
        textFilterDebouncer?.Cancel();
        showFilterDropdown = false;
        await OnResetFilters.InvokeAsync();
    }

    // The library filter holds one library, so picking another replaces it and re-picking the active one clears it.
    private IReadOnlyList<MultiSelectOption> LibraryFilterOptions => Choices.LibraryNames
        .Select(name => new MultiSelectOption(
            Javbuddy.Services.LocalLibrary.LocalLibraryNames.Label(name, Choices.LibraryNames),
            State.Library == name,
            EventCallback.Factory.Create(this, () => ChangeAsync(() => State.Library = State.Library == name ? null : name))))
        .ToList();

    private IReadOnlyList<MultiSelectOption> ResolutionFilterOptions => MovieFilterOptions.Resolutions
        .Select(bucket => new MultiSelectOption(
            MovieFilterOptions.ResolutionLabel(bucket),
            State.Resolutions.Contains(bucket),
            EventCallback.Factory.Create(this, () => ChangeAsync(() => State.Resolutions.Toggle(bucket)))))
        .ToList();

    private IReadOnlyList<MultiSelectOption> ScanTypeFilterOptions => MovieFilterOptions.ScanTypes
        .Select(scanType => new MultiSelectOption(
            scanType.ToString(),
            State.ScanTypes.Contains(scanType),
            EventCallback.Factory.Create(this, () => ChangeAsync(() => State.ScanTypes.Toggle(scanType)))))
        .ToList();

    private IReadOnlyList<MultiSelectOption> ContentTypeFilterOptions => MovieFilterOptions.ContentTypes
        .Select(type => new MultiSelectOption(
            MovieFilterOptions.ContentTypeLabel(type),
            State.ContentTypes.Contains(type),
            EventCallback.Factory.Create(this, () => FlipAsync(State.ContentTypes, State.ExcludedContentTypes, type, Excludable && ExcludableContentTypes)),
            IsExcluded: State.ExcludedContentTypes.Contains(type)))
        .ToList();

    private IReadOnlyList<MultiSelectOption> NfoDriftFilterOptions => MovieFilterOptions.NfoDriftKinds
        .Select(kind => new MultiSelectOption(
            MovieFilterOptions.NfoDriftLabel(kind),
            State.NfoDriftKinds.Contains(kind),
            EventCallback.Factory.Create(this, () => ChangeAsync(() => State.NfoDriftKinds.Toggle(kind)))))
        .ToList();

    private IReadOnlyList<MultiSelectOption> CodecFilterOptions => Choices.Codecs
        .Select(codec => new MultiSelectOption(
            codec,
            State.Codecs.Contains(codec),
            EventCallback.Factory.Create(this, () => ChangeAsync(() => State.Codecs.Toggle(codec)))))
        .ToList();

    // The r18.dev catalog can't exclude a studio, so there a click only includes or clears it — and
    // clears an exclusion it hides, so a studio is never both included and excluded back in the library.
    private IReadOnlyList<MultiSelectOption> StudioFilterOptions => Choices.Studios
        .Select(studio => new MultiSelectOption(
            studio,
            State.Studios.Contains(studio),
            EventCallback.Factory.Create(this, () => ToggleStudioAsync(studio)),
            IsExcluded: !ReleasesBrowseMode && State.ExcludedStudios.Contains(studio)))
        .ToList();

    private Task ToggleStudioAsync(string studio) =>
        ReleasesBrowseMode
            ? ChangeAsync(() =>
            {
                State.ExcludedStudios.Remove(studio);
                State.Studios.Toggle(studio);
            })
            : FlipAsync(State.Studios, State.ExcludedStudios, studio, Excludable);

    private IReadOnlyList<MultiSelectOption> GenreFilterOptions => Choices.Genres
        .Select(genre => new MultiSelectOption(
            genre.Contains(Tag.HierarchyDelimiter) ? genre.Replace(Tag.HierarchyDelimiter, MultiSelectOption.Separator) : genre,
            State.Genres.Contains(genre),
            EventCallback.Factory.Create(this, () => FlipAsync(State.Genres, State.ExcludedGenres, genre, Excludable)),
            genre.Contains(Tag.HierarchyDelimiter),
            State.ExcludedGenres.Contains(genre)))
        .ToList();

    private IReadOnlyList<MultiSelectOption> ActorFilterOptions => Choices.Actors
        .Select(actor => new MultiSelectOption(
            actor.Name,
            State.ActorIds.Contains(actor.Id),
            EventCallback.Factory.Create(this, () => FlipAsync(State.ActorIds, State.ExcludedActorIds, actor.Id, Excludable)),
            IsExcluded: State.ExcludedActorIds.Contains(actor.Id)))
        .ToList();

    private IReadOnlyList<MultiSelectOption> ActorTagFilterOptions => Choices.ActorTags
        .Select(tag => new MultiSelectOption(
            tag.Name,
            State.ActorTagIds.Contains(tag.Id),
            EventCallback.Factory.Create(this, () => FlipAsync(State.ActorTagIds, State.ExcludedActorTagIds, tag.Id, Excludable)),
            tag.Name.Contains(MultiSelectOption.Separator),
            State.ExcludedActorTagIds.Contains(tag.Id)))
        .ToList();

    private IReadOnlyList<MultiSelectOption> FeatureFilterOptions => MovieFilterOptions.Features
        .Select(feature => new MultiSelectOption(
            MovieFilterOptions.FeatureLabel(feature),
            State.Features.Contains(feature),
            EventCallback.Factory.Create(this, () => ChangeAsync(() => State.Features.Toggle(feature)))))
        .ToList();

    // Select All hands back the visible options' labels; names aren't unique, so every actor or tag with one counts.
    private Task SelectAllActors(IReadOnlyList<string> labels)
    {
        var names = labels.ToHashSet(StringComparer.Ordinal);
        return ChangeAsync(() => MovieGridFilterState.SelectAll(State.ActorIds, State.ExcludedActorIds, Choices.Actors.Where(a => names.Contains(a.Name)).Select(a => a.Id)));
    }

    private Task SelectAllActorTags(IReadOnlyList<string> labels)
    {
        var names = labels.ToHashSet(StringComparer.Ordinal);
        return ChangeAsync(() => MovieGridFilterState.SelectAll(State.ActorTagIds, State.ExcludedActorTagIds, Choices.ActorTags.Where(t => names.Contains(t.Name)).Select(t => t.Id)));
    }

    private Task SelectAllStudios(IReadOnlyList<string> studios) => ChangeAsync(() => MovieGridFilterState.SelectAll(State.Studios, State.ExcludedStudios, studios));
    private Task SelectNoStudios() => ChangeAsync(() => MovieGridFilterState.SelectNone(State.Studios, State.ExcludedStudios));
    private Task SelectAllGenres(IReadOnlyList<string> genres) => ChangeAsync(() => MovieGridFilterState.SelectAll(State.Genres, State.ExcludedGenres, genres));
    private Task SelectNoGenres() => ChangeAsync(() => MovieGridFilterState.SelectNone(State.Genres, State.ExcludedGenres));
    private Task SelectNoActors() => ChangeAsync(() => MovieGridFilterState.SelectNone(State.ActorIds, State.ExcludedActorIds));
    private Task SelectNoActorTags() => ChangeAsync(() => MovieGridFilterState.SelectNone(State.ActorTagIds, State.ExcludedActorTagIds));

    // The "Match all" checkbox shows only while a callback is bound.
    private EventCallback<bool> MatchAllGenresChanged => ShowMatchAll
        ? EventCallback.Factory.Create<bool>(this, matchAll => ChangeAsync(() => State.MatchAllGenres = matchAll))
        : default;

    private EventCallback<bool> MatchAllActorTagsChanged => ShowMatchAll
        ? EventCallback.Factory.Create<bool>(this, matchAll => ChangeAsync(() => State.MatchAllActorTags = matchAll))
        : default;

    // The sliders raise an edited copy of what they were given; merging it keeps a range whose options shrank sane.
    private Task OnCountsChanged(MovieCountSelection edited) =>
        ChangeAsync(() => State.Counts = MovieFilterOptions.MergeCounts(State.Counts, edited, Choices.Counts));

    private Task OnRangesChanged(MovieRangeSelection edited) =>
        ChangeAsync(() => State.Ranges = MovieFilterOptions.MergeRanges(State.Ranges, edited, Choices.Ranges));

    private Task OnActorAttributesChanged(ActorAttributeSelection edited) =>
        ChangeAsync(() => State.ActorAttributes = MovieFilterOptions.MergeActorAttributes(State.ActorAttributes, edited, Choices.ActorAttributes));

    public void Dispose()
    {
        textFilterDebouncer?.Dispose();
    }
}
