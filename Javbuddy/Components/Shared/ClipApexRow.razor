
@* An apex's row in ClipEditor's tree: its time, its own actors
   or the ones it inherits (grayed, with where from), and its tags. Pure display; ClipEditor acts on the
   callbacks. *@
<button type="button" class="apex-editor-row" @onclick="OnSeek" title="@SeekTitle">
    <span class="apex-editor-pos">@Apex.Position</span>
    <span class="apex-editor-time">@SceneTimeFormat.Format(Apex.Seconds)</span>
    <ClipActorNames Class="apex-editor-actors" Actors="Apex.Actors" Tags="ActorTags" Library="ActorTagLibrary" />
    <ImplicitChips Items="@ImplicitChip.ForActors(Node.Actors)" ActorTags="ActorTags" Library="ActorTagLibrary" />
    @if (Apex.Tags.Count > 0)
    {
        <span class="apex-editor-tags">
            @foreach (var tag in Apex.Tags)
            {
                <span class="apex-editor-tag">@ImplicitChip.TagLabel(tag)</span>
            }
        </span>
    }
</button>
<ClipRowActions ClassPrefix="apex-editor" Label="@($"apex at {SceneTimeFormat.Format(Apex.Seconds)}")" FavoriteNoun="apexes" IsFavorite="Apex.IsFavorite" Busy="Busy"
                OnToggleFavorite="OnToggleFavorite" OnEdit="OnEdit" OnDelete="OnDelete" />

@code {
    [Parameter, EditorRequired] public ApexNode Node { get; set; } = null!;

    [Parameter] public bool Busy { get; set; }

    /// <summary>The apex's actor tags (ClipActorTags), shown in each actor's hover popover.</summary>
    [Parameter] public IReadOnlyList<EffectiveActorTag> ActorTags { get; set; } = [];

    [Parameter] public IReadOnlyList<ActorTagListItem> ActorTagLibrary { get; set; } = [];

    [Parameter] public EventCallback OnSeek { get; set; }

    // The seek lands at the apex's effective lead-in (its own, else the configured default), not a fixed 5 s.
    private string SeekTitle => Node.Apex.Window.LeadInSeconds > 0
        ? $"Jump to {ApexWindowText.Format(Node.Apex.Window.LeadInSeconds)} s before this apex"
        : "Jump to this apex";

    [Parameter] public EventCallback OnToggleFavorite { get; set; }

    [Parameter] public EventCallback OnEdit { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    private ApexItem Apex => Node.Apex;
}
