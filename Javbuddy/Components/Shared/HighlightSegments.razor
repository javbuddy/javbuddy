@using Javbuddy.Services

@* Highlight track drawn above a timeline's scene bar: a span per highlight, with
   overlapping highlights stacked in lanes (HighlightItem.Lane). With OnHighlightClick set each span
   is a button; otherwise they're plain spans whose data-* attributes ScrubBar.razor.js reads for its
   hover preview and click-to-seek. *@
@if (DurationSeconds is > 0 && Highlights is { Count: > 0 })
{
    <div class="highlight-segments" style="@FormattableString.Invariant($"height:{(Highlights.Max(h => h.Lane) + 1) * LanePx - 1}px")">
        @foreach (var highlight in Highlights)
        {
            var left = Percent(highlight.StartSeconds);
            var width = Math.Max(Percent(highlight.EndSeconds) - left, 0);
            var label = $"{highlight.DisplayTitle} ({SceneTimeFormat.Format(highlight.StartSeconds)}–{SceneTimeFormat.Format(highlight.EndSeconds)})";
            var style = FormattableString.Invariant($"left:{left:0.###}%;width:{width:0.###}%;top:{highlight.Lane * LanePx}px");
            var dataStart = highlight.StartSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture);
            @if (OnHighlightClick.HasDelegate)
            {
                <button type="button" class="highlight-segment" style="@style" data-start="@dataStart" data-highlight-name="@highlight.DisplayTitle" title="@label" aria-label="Jump to @label" @onclick="() => OnHighlightClick.InvokeAsync(highlight)"></button>
            }
            else
            {
                <span class="highlight-segment" style="@style" data-start="@dataStart" data-highlight-name="@highlight.DisplayTitle" title="@label"></span>
            }
        }
    </div>
}

@code {
    /// <summary>Height of one lane including the 1px gap below it.</summary>
    private const int LanePx = 6;

    [Parameter] public IReadOnlyList<HighlightItem>? Highlights { get; set; }

    /// <summary>The timeline's full length; nothing renders while it's unknown.</summary>
    [Parameter] public double? DurationSeconds { get; set; }

    [Parameter] public EventCallback<HighlightItem> OnHighlightClick { get; set; }

    private double Percent(double seconds) => Math.Clamp(seconds / DurationSeconds!.Value * 100, 0, 100);
}
