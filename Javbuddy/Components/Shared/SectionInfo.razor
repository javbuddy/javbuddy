@* An info icon beside an editor section's heading explaining what that section is:
   Scenes, Highlights and Apexes each get one. Pure CSS like ShortcutsInfo: the popover shows on
   :hover / :focus-within and the button does nothing when clicked. Colors follow the host's
   --scene-editor-* properties, and the popover spans its nearest positioned ancestor (the
   section's header), so it fits the player's narrow side panel. *@
<span class="section-info">
    <button type="button" class="section-info-btn" aria-label="@Label" aria-describedby="@popoverId">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
        </svg>
    </button>
    <div class="section-info-popover" id="@popoverId" role="tooltip">
        @ChildContent
    </div>
</span>

@code {
    /// <summary>The button's accessible name, e.g. "What are highlights?".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    private readonly string popoverId = "section-info-" + Guid.NewGuid().ToString("N");
}
